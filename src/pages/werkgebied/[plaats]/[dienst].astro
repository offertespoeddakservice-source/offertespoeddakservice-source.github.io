---
import Base from "../../../layouts/Base.astro";
import { SITE, telHref, waHref } from "../../../site.config.ts";
import { MATRIX } from "../../../data/matrix.ts";
import { getPlaats } from "../../../data/plaatsen.ts";
import { getDienst } from "../../../data/diensten.ts";
import { PRIJZEN } from "../../../data/prijzen.ts";
import EchteFotos from "../../../components/EchteFotos.astro";

export function getStaticPaths() {
  return MATRIX.map((c) => {
    const p = getPlaats(c.plaats);
    const d = getDienst(c.dienst);
    return { params: { plaats: c.plaats, dienst: c.dienst }, props: { p, d, hook: c.hook, faqExtra: c.faq ?? [] } };
  }).filter((x) => x.props.p && x.props.d && !x.props.d.verborgen); // diensten die Rens niet doet: geen plaatspagina's
}

const { p, d, hook, faqExtra } = Astro.props;
const path = `/werkgebied/${p.slug}/${d.slug}`;
const titel = `${d.titel} in ${p.naam}`;
// Kop zoals mensen zoeken ('dakgoot schoonmaken oss'): bij goten reinigen dezelfde woorden als in de titel.
const kop = d.slug === "goten-reinigen" ? `Dakgoot schoonmaken in ${p.naam}` : titel;
// Titel en omschrijving per dienst waar de standaardzin niet goed loopt; de andere diensten houden de standaard.
const gotenPrijs = PRIJZEN.find((r) => r.sleutel === "goot_reinigen")?.prijs ?? "";
const metaTitelPerDienst: Record<string, string> = {
  "goten-reinigen": `Dakgoot schoonmaken in ${p.naam}`,
};
const omschrijvingPerDienst: Record<string, string> = {
  "goten-reinigen": `Dakgoot schoonmaken in ${p.naam}: ${gotenPrijs} incl. btw voor één goot, uitloop naar de regenpijp vrij en eerlijk advies over je dak. Stuur een foto of app Rens.`,
  stormschade: `Stormschade aan je dak in ${p.naam}? Weggewaaide pannen of een losse nok: ik dek het eerst af en herstel het daarna netjes. Bel of WhatsApp Rens.`,
  "dak-reinigen": `Dakreiniging in ${p.naam}: mos en groene aanslag van je pannen, de goten meteen leeg en een eerlijke blik op je dak. Vaste prijs vooraf. Bel of app Rens.`,
};
// Daklekkage per plaats: titel en omschrijving met het zoekwoord vooraan. Niet voor de lekkagepagina's die na 20-10 zijn gemaakt, die meten we eerst.
const nieuweLekPaginas = ["tilburg", "veghel", "eindhoven", "waalwijk", "breda"];
if (d.slug === "daklekkage" && !nieuweLekPaginas.includes(p.slug)) {
  metaTitelPerDienst.daklekkage = `Daklekkage ${p.naam}: lek opsporen en repareren`;
  omschrijvingPerDienst.daklekkage = `Daklekkage in ${p.naam}? Ik zoek waar het water echt binnenkomt en repareer het zonder onnodig sloopwerk. Vaste prijs vooraf. Bel of app Rens.`;
}
// Dakgoot repareren in Den Bosch: titel en omschrijving zoals mensen zoeken ('dakgoot reparatie den bosch'). Gemaakt op 22-10, dus vanaf 05-11 mag de titel. De andere gootpagina's meten we eerst.
if (d.slug === "dakgoot-vervangen" && p.slug === "den-bosch") {
  metaTitelPerDienst["dakgoot-vervangen"] = "Dakgoot repareren of vervangen in Den Bosch";
  omschrijvingPerDienst["dakgoot-vervangen"] = "Dakgoot lekt in Den Bosch? Ik repareer een lekkende naad, hoek of uitloop, of vervang de goot als hij op is. Zink of kunststof. Stuur een foto voor de prijs.";
}
// Dakgoot repareren in Vught: gemaakt op 23-10, dus vanaf 06-11 mag de titel ('dakgoot reparatie vught' plek 18,5). De andere gootpagina's meten we eerst.
if (d.slug === "dakgoot-vervangen" && p.slug === "vught") {
  metaTitelPerDienst["dakgoot-vervangen"] = "Dakgoot repareren of vervangen in Vught";
  omschrijvingPerDienst["dakgoot-vervangen"] = "Lekt je dakgoot in Vught of Helvoirt? Ik repareer een lekkende naad, hoek of uitloop, of vervang de goot als hij op is. Stuur een foto voor de prijs.";
}
// Stormschade per plaats: titel met 'stormschade dak' vooraan, zoals mensen zoeken. Niet voor de stormpagina's die na 23-10 zijn gemaakt (Waalwijk 01-11, Veghel 03-11), die meten we eerst.
const nieuweStormPaginas = ["waalwijk", "veghel"];
if (d.slug === "stormschade" && !nieuweStormPaginas.includes(p.slug)) {
  metaTitelPerDienst.stormschade = `Stormschade dak ${p.naam}: afdekken en herstellen`;
}
const metaTitel =metaTitelPerDienst[d.slug] ?? titel;
// Eén zin bovenaan die Google en AI kunnen overnemen: wie, wat en waar (net als op de plaatspagina's).
const WAT_PER_DIENST: Record<string, string> = { daklekkage: "daklekkage opsporen en repareren", dakreparatie: "dakreparaties, zoals losse dakpannen en nokvorsten", stormschade: "stormschade aan je dak", "dakgoot-vervangen": "het repareren en vervangen van dakgoten", "goten-reinigen": "het schoonmaken van dakgoten", dakrenovatie: "dakrenovatie" };
const watZin = WAT_PER_DIENST[d.slug] ?? d.titel.toLowerCase();
const KLUS_NAAM: Record<string, string> = { daklekkage: "Daklekkage", "dakgoot-vervangen": "Dakgoot repareren of vervangen", "goten-reinigen": "Dakgoot schoonmaken", stormschade: "Stormschade", dakreparatie: "Dakreparatie", dakrenovatie: "Dakrenovatie" };
const waarZin = p.slug === "den-bosch" ? "in de hele stad en de dorpen eromheen" : `in ${p.naam} en omgeving`;

// Verder lezen bij lekkage en storm: gewone zinnen met links naar de spoedpagina en de kennisbank.
const verderLezen: Record<string, string> = {
  daklekkage: 'Lekt het nu? Op de <a href="/spoed/">spoedpagina</a> lees je wat je meteen zelf kunt doen. Hoe ik een lek vind zonder onnodig sloopwerk, staat in <a href="/kennisbank/daklekkage-opsporen/">daklekkage opsporen</a>. Druppelt het bij de schoorsteen, lees dan <a href="/kennisbank/lekkage-bij-schoorsteen/">lekkage bij de schoorsteen</a>. Komt het water binnen in je aanbouw, vlak langs de muur van het huis, lees dan <a href="/kennisbank/lekkage-bij-aanbouw/">lekkage bij de aanbouw</a>. Druppelt het onder een dakraam of een lichtkoepel, kijk dan bij <a href="/kennisbank/dakraam-lekt/">dakraam lekt</a> of <a href="/kennisbank/lichtkoepel-lekt/">lichtkoepel lekt</a>. Twijfel je of het wel een lek is, kijk dan eerst bij <a href="/kennisbank/condens-of-lekkage-op-zolder/">condens of lekkage op zolder</a>. Meld je de schade bij je verzekering? Ik maak foto\'s van wat ik aantref en van de reparatie, met een korte omschrijving erbij. Die kun je meesturen. Of de verzekering iets vergoedt, hangt af van je polis: lees <a href="/kennisbank/daklekkage-verzekering/">daklekkage en je verzekering</a>.',
  stormschade: 'Ligt je dak open na de storm? Op de <a href="/spoed/">spoedpagina</a> lees je wat je meteen zelf kunt doen. Wat je beter laat en hoe het zit met je verzekering, staat in <a href="/kennisbank/stormschade-eerste-hulp/">stormschade: eerste hulp</a>. Ligt er specie in de goot of staat de nok scheef, lees dan <a href="/kennisbank/nokvorsten-los/">losse nokvorsten</a>. Zie je vanaf de straat een pan die scheef ligt of mist, kijk dan bij <a href="/kennisbank/dakpan-kapot-of-verschoven/">dakpan kapot of verschoven</a>. Is er een tak op je dak gevallen, lees dan <a href="/kennisbank/tak-of-boom-op-dak/">tak of boom op je dak</a>.',
  "dakgoot-vervangen": 'Druppelt je goot op één plek? In <a href="/kennisbank/dakgoot-lekt/">dakgoot lekt</a> lees je hoe je ziet of hij vol zit of echt lek is. Loopt het water over de rand of langs de gevel, kijk dan eerst bij <a href="/kennisbank/verstopte-regenpijp-lekkende-dakgoot/">verstopte regenpijp of lekkende dakgoot</a>. Zit de goot alleen vol, dan is <a href="/diensten/goten-reinigen/">goten reinigen</a> genoeg.',
  "goten-reinigen": 'Wat het kost en wat erbij zit, lees je in <a href="/kennisbank/wat-kost-dakgoot-schoonmaken/">wat kost dakgoot schoonmaken</a>. Hoe vaak je goot leeg moet, hangt vooral af van de bomen om je huis: zie <a href="/kennisbank/hoe-vaak-dakgoot-reinigen/">hoe vaak dakgoot reinigen</a>. Druppelt je goot op één vaste plek, ook als hij leeg is, lees dan <a href="/kennisbank/dakgoot-lekt/">dakgoot lekt</a>.',
  dakreparatie: 'Ligt er na een storm een pan scheef of een stuk pan in de goot? In <a href="/kennisbank/dakpan-kapot-of-verschoven/">dakpan kapot of verschoven</a> lees je hoe je dat vanaf de straat ziet. Waait er bij harde wind steeds iets los bij de nok, kijk dan bij <a href="/kennisbank/nokvorsten-los/">losse nokvorsten</a>. Wat een reparatie kost en waar de prijs van afhangt, staat in <a href="/kennisbank/wat-kost-een-dakdekker/">wat kost een dakreparatie</a>. Lekt het nu? Op de <a href="/spoed/">spoedpagina</a> lees je wat je meteen zelf kunt doen.',
  "schoorsteen-vegen": 'Hoe vaak je je schoorsteen laat vegen, hangt af van hoeveel je stookt en wat je stookt: zie <a href="/kennisbank/schoorsteen-vegen-hoe-vaak/">hoe vaak schoorsteen vegen</a>. Komt er bij regen water in je kachel of open haard, lees dan <a href="/kennisbank/schoorsteen-lekt-open-haard/">water in je open haard</a>. Is het nat naast de schoorsteen, op zolder of op het plafond, kijk dan bij <a href="/kennisbank/lekkage-bij-schoorsteen/">lekkage bij de schoorsteen</a> en <a href="/kennisbank/lood-op-dak/">lood op je dak</a>.',
  dakrenovatie: 'Twijfel je of je dak echt aan renovatie toe is? In <a href="/kennisbank/dakinspectie/">dakinspectie</a> lees je wat ik nakijk en wanneer dat zinvol is. Ligt er specie in de goot of staat de nok scheef, kijk dan bij <a href="/kennisbank/nokvorsten-los/">losse nokvorsten</a>. Zitten er na een vorstperiode schilfers van je pannen in de goot, lees dan <a href="/kennisbank/vorstschade-dakpannen/">vorstschade aan dakpannen</a>. Hoe je ziet dat het lood rond de schoorsteen op is, staat in <a href="/kennisbank/lood-op-dak/">lood op je dak</a>, en of je goot nog mee kan, lees je in <a href="/kennisbank/hoe-lang-gaat-een-dakgoot-mee/">hoe lang gaat een dakgoot mee</a>.',
  "dak-reinigen": 'Waarom mos kwaad kan en hoe je het het beste weghaalt, lees je in <a href="/kennisbank/mos-op-dak-verwijderen/">mos op je dak</a>. Zitten er na een vorstperiode schilfers van je pannen in de goot, kijk dan bij <a href="/kennisbank/vorstschade-dakpannen/">vorstschade aan dakpannen</a>. Wat je per seizoen aan je dak nakijkt, staat in <a href="/kennisbank/dakonderhoud-per-seizoen/">dakonderhoud per seizoen</a>.',
};
const verder = verderLezen[d.slug];
// Interne links: de andere klussen in deze plaats, en dezelfde klus in de andere plaatsen.
const zelfdePlaats = MATRIX.filter((c) => c.plaats === p.slug && c.dienst !== d.slug)
  .map((c) => getDienst(c.dienst))
  .filter((x) => x && !x.verborgen); // geen knoppen naar diensten die verborgen zijn (die pagina's bestaan niet)
const zelfdeDienst = MATRIX.filter((c) => c.dienst === d.slug && c.plaats !== p.slug)
  .map((c) => getPlaats(c.plaats))
  .filter((x) => x);

// FAQ: combineer plaats-specifiek + dienst-specifiek → uniek én rijk per pagina.
const faq = [
  {
    v: `Kun je snel langskomen voor ${d.titel.toLowerCase()} in ${p.naam}?`,
    a: p.slug === "den-bosch"
      ? `Ja, Den Bosch is mijn thuisbasis, dus ik ben er zo. Bij spoed kom ik regelmatig nog dezelfde dag.`
      : p.reistijd?.startsWith("±")
        ? `${p.naam} ligt aan de rand van mijn werkgebied (${p.reistijd}). Ook hier kom ik voor lekkage en ander dakwerk. Stuur eerst een foto via WhatsApp of bel even, dan hoor je eerlijk wanneer ik kan komen.`
        : `Ja, ${p.naam} ligt in mijn vaste werkgebied rond Den Bosch${p.reistijd ? ` (${p.reistijd})` : ""}, dus vaak ben ik al in de buurt. Bij spoed kom ik regelmatig nog dezelfde dag.`,
  },
  ...d.faq.slice(0, 2),
  ...faqExtra,
  {
    v: `Werk je in heel ${p.naam}?`,
    a: `Ja, door heel ${p.naam}${p.wijken.length ? `, onder andere ${p.wijken.slice(0, 3).join(", ")}` : ""} en de directe omgeving.`,
  },
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: `${d.titel} ${p.naam}`,
    serviceType: d.titel,
    description: `${d.titel} in ${p.naam}: ${d.kort}`,
    provider: { "@type": "RoofingContractor", "@id": `${SITE.url}/#bedrijf`, name: SITE.bedrijfsnaam, telephone: `+${SITE.telefoonE164}` },
    areaServed: { "@type": "City", name: p.naam },
    url: `${SITE.url}${path}/`,
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faq.map((f) => ({ "@type": "Question", name: f.v, acceptedAnswer: { "@type": "Answer", text: f.a } })),
  },
];
---

<Base
  title={`${metaTitel} | ${SITE.bedrijfsnaam}`.length <= 60 ? `${metaTitel} | ${SITE.bedrijfsnaam}` : metaTitel}
  description={omschrijvingPerDienst[d.slug] ?? `${d.titel} in ${p.naam} nodig? ${d.kort} Eerlijke, vaste prijs vooraf.`}
  path={path}
  schema={schema}
>
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow" style="color:#ffb486;">{p.naam} · {p.reistijd ?? SITE.regioOmschrijving}</p>
      <h1>{kop}</h1>
      <p class="lead" style="margin-bottom:12px;">Spoed Dak Service is een dakdekker uit 's-Hertogenbosch voor {watZin} {waarZin}.</p>
      <p class="lead">{hook}</p>
      <div class="btn-row" style="margin-top:22px;">
        <a class="btn btn--primary" href={telHref}>Bel {SITE.telefoonWeergave}</a>
        <a class="btn btn--wa" href={waHref(`Hallo, ik zoek ${d.titel.toLowerCase()} in ${p.naam}.`)}>WhatsApp Rens</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap prose">
      <h2>{kop}</h2>
      <p>{d.intro}</p>
      {(d.slug === "daklekkage" || d.slug === "stormschade") && (
        <p><strong>Komt er nu water binnen?</strong> Zet een emmer onder de druppel, haal spullen weg en ga niet zelf het dak op. Maak een foto van de natte plek en, als het lukt, van je dak vanaf de straat, en stuur die via <a href={waHref(`Hallo, ik heb een lek of schade aan mijn dak in ${p.naam}. Ik stuur je een foto.`)}>WhatsApp</a>. Dan zeg ik wat je nu zelf kunt doen en wanneer ik kan komen.</p>
      )}
      <p>{p.lokaal}</p>
      <ul>
        {d.punten.map((punt) => <li>{punt}</li>)}
      </ul>
      {d.slug === "dakgoot-vervangen" && (
        <p><strong>Druppelt of lekt je goot?</strong> Maak tijdens of vlak na een bui vanaf de straat een foto van de plek waar het druppelt of overloopt, en stuur die via <a href={waHref(`Hallo, mijn dakgoot lekt in ${p.naam}. Ik stuur je een foto.`)}>WhatsApp</a>. Dan zeg ik wat ik zie, en je hoort vooraf wat het kost.</p>
      )}
      {verder && (
        <>
          <h3>Handig om te weten</h3>
          <p set:html={verder} />
        </>
      )}
      {d.slug === "daklekkage" && (
        <>
          <h3>Foto's uit mijn werk</h3>
          <p>Bij een lek kijk ik eerst naar de plekken waar het water vaak binnenkomt, zoals het lood rond de schoorsteen en de aansluiting rond een pijp door het dak.</p>
          <EchteFotos soort="schoorsteen" max={3} inline />
        </>
      )}
    </div>
  </section>

  <EchteFotos dienst={d.slug} />

  <section class="section section--soft">
    <div class="wrap">
      <h2>Veelgestelde vragen: {d.titel.toLowerCase()} in {p.naam}</h2>
      <div class="faq" style="margin-top:16px; max-width:760px;">
        {faq.map((f) => (
          <details>
            <summary>{f.v}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
      <p style="margin-top:18px; max-width:760px;">Staat je vraag er niet bij? Stuur me een appje met een foto via <a href={waHref(`Hallo, ik heb een vraag over ${d.titel.toLowerCase()} in ${p.naam}.`)}>WhatsApp</a> of bel <a href={telHref}>{SITE.telefoonWeergave}</a>, dan kijk ik met je mee.</p>
    </div>
  </section>

  <section class="section section--white">
    <div class="wrap">
      <h2>Meer in {p.naam} en omgeving</h2>
      <div class="chips">
        <a class="chip" href={`/werkgebied/${p.slug}/`}>Dakdekker in {p.naam} →</a>
        <a class="chip" href={`/diensten/${d.slug}/`}>Over {d.titel.toLowerCase()} →</a>
        <a class="chip" href="/werkgebied/">Heel mijn werkgebied →</a>
      </div>
      {zelfdePlaats.length > 0 && (
        <>
          <h3 style="margin-top:22px;">Ook in {p.naam}</h3>
          <div class="chips">
            {zelfdePlaats.map((x) => <a class="chip" href={`/werkgebied/${p.slug}/${x.slug}/`}>{KLUS_NAAM[x.slug] ?? x.titel}</a>)}
          </div>
        </>
      )}
      {zelfdeDienst.length > 0 && (
        <>
          <h3 style="margin-top:22px;">{KLUS_NAAM[d.slug] ?? d.titel} in de buurt</h3>
          <div class="chips">
            {zelfdeDienst.map((x) => <a class="chip" href={`/werkgebied/${x.slug}/${d.slug}/`}>{x.naam}</a>)}
          </div>
        </>
      )}
    </div>
  </section>
</Base>
