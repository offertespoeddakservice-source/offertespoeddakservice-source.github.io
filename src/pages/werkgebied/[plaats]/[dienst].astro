  bestaatArtikel("dakpan-zelf-terugleggen") ? 'Twijfel je of je een verschoven pan zelf kunt terugleggen, lees dan eerst <a href="/kennisbank/dakpan-zelf-terugleggen/">zelf een dakpan terugleggen of vervangen</a>.' : "",
  bestaatArtikel("welk-soort-dak-heb-ik") ? 'Weet je niet hoe jouw soort dak heet, kijk dan bij <a href="/kennisbank/welk-soort-dak-heb-ik/">welk soort dak heb ik</a>.' : "",
].filter(Boolean).join(" ");
const GOTEN_SCHOON_EXTRA_2 = [
  bestaatArtikel("dak-winterklaar-maken") ? 'Wil je weten waar je voor de winter verder op je dak naar kijkt, lees dan <a href="/kennisbank/dak-winterklaar-maken/">je dak winterklaar maken</a>.' : "",
].filter(Boolean).join(" ");
const verder = verderLezen[d.slug];
// Interne links: de andere klussen in deze plaats, en dezelfde klus in de andere plaatsen.
const zelfdePlaats = MATRIX.filter((c) => c.plaats === p.slug && c.dienst !== d.slug)
  .map((c) => getDienst(c.dienst))
  .filter((x) => x && !x.verborgen); // geen knoppen naar diensten die verborgen zijn (die pagina's bestaan niet)
const zelfdeDienst = MATRIX.filter((c) => c.dienst === d.slug && c.plaats !== p.slug)
  .map((c) => getPlaats(c.plaats))
  .filter((x) => x);

// FAQ: combineer plaats-specifiek + dienst-specifiek → uniek én rijk per pagina.
const faq = [
  {
    v: `Kun je snel langskomen voor ${(KLUS_NAAM[d.slug] ?? d.titel).toLowerCase()} in ${p.naam}?`,
    a: p.slug === "den-bosch"
      ? `Ja, Den Bosch is mijn thuisbasis, dus ik ben er zo. Bij spoed kom ik regelmatig nog dezelfde dag.`
      : p.reistijd?.startsWith("±")
        ? `${p.naam} ligt aan de rand van mijn werkgebied (${p.reistijd}). Ook hier kom ik voor lekkage en ander dakwerk. Stuur eerst een foto via WhatsApp of bel even, dan hoor je eerlijk wanneer ik kan komen.`
        : `Ja, ${p.naam} ligt in mijn vaste werkgebied rond Den Bosch${p.reistijd ? ` (${p.reistijd})` : ""}, dus vaak ben ik al in de buurt. Bij spoed kom ik regelmatig nog dezelfde dag.`,
  },
  ...d.faq.slice(0, 2),
  ...faqExtra,
  {
    v: `Werk je in heel ${p.naam}?`,
    a: `Ja, door heel ${p.naam}${p.wijken.length ? `, onder andere ${p.wijken.slice(0, 3).join(", ")}` : ""} en de directe omgeving.`,
  },
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: `${KLUS_NAAM[d.slug] ?? d.titel} in ${p.naam}`,
    serviceType: KLUS_NAAM[d.slug] ?? d.titel,
    description: `Spoed Dak Service is een dakdekker uit 's-Hertogenbosch voor ${watZin} ${waarZin}.`,
    provider: { "@type": "RoofingContractor", "@id": `${SITE.url}/#bedrijf`, name: SITE.bedrijfsnaam, telephone: `+${SITE.telefoonE164}` },
    areaServed: { "@type": "City", name: p.slug === "den-bosch" ? "'s-Hertogenbosch" : p.naam, ...(p.slug === "den-bosch" ? { alternateName: "Den Bosch" } : {}), containedInPlace: gemeente ? { "@type": "AdministrativeArea", name: `gemeente ${gemeente}`, containedInPlace: { "@type": "State", name: provincie } } : { "@type": "State", name: provincie } },
    url: `${SITE.url}${path}/`,
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faq.map((f) => ({ "@type": "Question", name: f.v, acceptedAnswer: { "@type": "Answer", text: f.a } })),
  },
];
// 19-11-2026 ronde 5: spoedklussen per plaats ook in de gegevens dag en nacht bereikbaar, net als op /spoed/ en de dienstpagina's. In de tekst staat het al bij 'In het kort'.
if (["daklekkage", "stormschade", "dakreparatie"].includes(d.slug)) (schema[0] as Record<string, unknown>).hoursAvailable = { "@type": "OpeningHoursSpecification", dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"], opens: "00:00", closes: "23:59" };
---

<Base
  title={`${metaTitel} | ${SITE.bedrijfsnaam}`.length <= 60 ? `${metaTitel} | ${SITE.bedrijfsnaam}` : metaTitel}
  description={omschrijvingPerDienst[d.slug] ?? `${d.titel} in ${p.naam} nodig? ${d.kort} Eerlijke, vaste prijs vooraf.`}
  path={path}
  schema={schema}
>
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow" style="color:#ffb486;">{p.naam} · {p.reistijd ?? SITE.regioOmschrijving}</p>
      <h1>{h1}</h1>
      <p class="lead" style="margin-bottom:12px;">Spoed Dak Service is een dakdekker uit 's-Hertogenbosch voor {watZin} {waarZin}.</p>
      <p class="lead">{hook}</p>
      <div class="btn-row" style="margin-top:22px;">
        <a class="btn btn--primary" href={telHref}>Bel {SITE.telefoonWeergave}</a>
        <a class="btn btn--wa" href={waHref(`Hallo, ik zoek ${d.titel.toLowerCase()} in ${p.naam}.`)}>WhatsApp Rens</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap prose">
      <h2>{kop}</h2>
      <p>{d.intro}</p>
      {(d.slug === "daklekkage" || d.slug === "stormschade") && (
        <p><strong>Komt er nu water binnen?</strong> Zet een emmer onder de druppel, haal spullen weg en ga niet zelf het dak op. Maak een foto van de natte plek en, als het lukt, van je dak vanaf de straat, en stuur die via <a href={waHref(`Hallo, ik heb een lek of schade aan mijn dak in ${p.naam}. Ik stuur je een foto.`)}>WhatsApp</a>. Dan zeg ik wat je nu zelf kunt doen en wanneer ik kan komen.</p>
      )}
      {d.slug === "stormschade" && (
        <p><strong>Na de storm: waar kijk je naar?</strong> Ga aan de overkant van de straat staan en zoom met je telefoon in op vijf plekken. De pannen langs de zijkant van je dak, die bij een storm het eerst gaan schuiven: zie <a href="/kennisbank/gevelpannen-los/">gevelpannen los</a>. De nok bovenop, en of er specie in de goot ligt: zie <a href="/kennisbank/nokvorsten-los/">losse nokvorsten</a>. De kap en het lood van de schoorsteen: zie <a href="/kennisbank/schoorsteen-na-storm/">schoorsteen na een storm</a>. De plank langs de schuine rand van je dak: zie <a href="/kennisbank/windveer-los-of-rot/">windveer los of rot</a>. En de goot, of die nog recht en vast hangt: zie <a href="/kennisbank/dakgoot-losgeraakt/">dakgoot losgeraakt</a>. Zie je iets, stuur dan een foto via <a href={waHref(`Hallo, ik zie na de storm iets aan mijn dak in ${p.naam}. Ik stuur je een foto.`)}>WhatsApp</a>.</p>
      )}
      <p>{p.lokaal}</p>
      <ul>
        {d.punten.map((punt) => <li>{punt}</li>)}
      </ul>
      {d.slug === "dakgoot-vervangen" && (
        <p><strong>Druppelt of lekt je goot?</strong> Maak tijdens of vlak na een bui vanaf de straat een foto van de plek waar het druppelt of overloopt, en stuur die via <a href={waHref(`Hallo, mijn dakgoot lekt in ${p.naam}. Ik stuur je een foto.`)}>WhatsApp</a>. Dan zeg ik wat ik zie, en je hoort vooraf wat het kost.</p>
      )}
      {d.slug === "dakreparatie" && (
        <p><strong>Ligt er een pan scheef of los?</strong> Maak vanaf de overkant van de straat een foto van je dak, het liefst met de zoom van je telefoon, en stuur die via <a href={waHref(`Hallo, er ligt een pan of nokvorst los op mijn dak in ${p.naam}. Ik stuur je een foto.`)}>WhatsApp</a>. Dan zeg ik wat ik zie, en je hoort vooraf wat het kost. Ga zelf niet het dak op.</p>
      )}
      {d.slug === "dakrenovatie" && (
        <p><strong>Twijfel je of je dak op is?</strong> Stuur een paar foto's van je dak vanaf de straat en vanuit de tuin via <a href={waHref(`Hallo, ik twijfel of mijn dak in ${p.naam} aan vernieuwing toe is. Ik stuur je foto's.`)}>WhatsApp</a>. Dan zeg ik eerlijk of repareren nog kan of dat vernieuwen slimmer is, en je hoort vooraf wat het kost.</p>
      )}
      {d.slug === "goten-reinigen" && (
        <p><strong>Zit je goot vol?</strong> Maak vanaf de straat een foto van je goot, het liefst tijdens of vlak na een bui, en stuur die via <a href={waHref(`Hallo, ik wil mijn dakgoot laten schoonmaken in ${p.naam}. Ik stuur je een foto.`)}>WhatsApp</a>. Dan zeg ik eerlijk of leegmaken genoeg is, en je hoort vooraf wat het kost.</p>
      )}
      {verder && (
        <>
          <h3>Handig om te weten</h3>
          <p set:html={verder} />
          {d.slug === "dakgoot-vervangen" && GOOT_EXTRA && <p set:html={GOOT_EXTRA} />}
          {d.slug === "daklekkage" && LEK_EXTRA && <p set:html={LEK_EXTRA} />}
          {d.slug === "dakreparatie" && REPARATIE_EXTRA && <p set:html={REPARATIE_EXTRA} />}
          {d.slug === "stormschade" && STORM_EXTRA && <p set:html={STORM_EXTRA} />}
          {d.slug === "goten-reinigen" && GOTEN_SCHOON_EXTRA && <p set:html={GOTEN_SCHOON_EXTRA} />}
          {d.slug === "daklekkage" && LEK_EXTRA_2 && <p set:html={LEK_EXTRA_2} />}
          {d.slug === "dakgoot-vervangen" && GOOT_EXTRA_2 && <p set:html={GOOT_EXTRA_2} />}
          {d.slug === "dakreparatie" && REPARATIE_EXTRA_2 && <p set:html={REPARATIE_EXTRA_2} />}
          {d.slug === "goten-reinigen" && GOTEN_SCHOON_EXTRA_2 && <p set:html={GOTEN_SCHOON_EXTRA_2} />}
        </>
      )}
      <h3>In het kort</h3>
      <ul>
        <li><strong>Wie:</strong> Spoed Dak Service, het bedrijf van {SITE.eigenaar}, dakdekker uit 's-Hertogenbosch.</li>
        <li><strong>Klus:</strong> {KLUS_NAAM[d.slug] ?? d.titel} in {p.naam}{gemeente && gemeente !== p.naam ? ` (gemeente ${gemeente})` : ""}.</li>
        <li><strong>Afstand:</strong> {p.reistijd ?? SITE.regioOmschrijving}.</li>
        <li><strong>Contact:</strong> bellen of WhatsApp op <a href={telHref}>{SITE.telefoonWeergave}</a>, dag en nacht bereikbaar.</li>
        {(d.slug === "daklekkage" || d.slug === "stormschade") && (<li><strong>Spoed:</strong> {p.reistijd?.startsWith("±") ? `${p.naam} ligt verder weg, dus een klus hier plan ik meestal vooraf met je in. Stuur eerst een foto, dan hoor je eerlijk wanneer ik kan komen.` : "druppelt het binnen of ligt er een open plek in je dak, bel of app dan meteen. Bij spoed kan ik vaak nog dezelfde dag komen."}</li>)}
        <li><strong>Prijs:</strong> je hoort de vaste prijs voordat ik begin.</li>
        <li><strong>Verzekerd:</strong> bedrijfsaansprakelijk verzekerd.</li>
        <li><strong>Reviews:</strong> <a href={SITE.werkspotUrl} target="_blank" rel="noopener">{SITE.reviews.score.toString().replace(".", ",")} op Werkspot</a>{SITE.reviews.werkspotAantal > 0 ? ` (${SITE.reviews.werkspotAantal} reviews)` : ""}.</li>
      </ul>
      {d.slug === "daklekkage" && (
        <>
          <h3>Foto's uit mijn werk</h3>
          <p>Bij een lek kijk ik eerst naar de plekken waar het water vaak binnenkomt, zoals het lood rond de schoorsteen en de aansluiting rond een pijp door het dak.</p>
          <EchteFotos soort="schoorsteen" max={3} inline />
        </>
      )}
    </div>
  </section>

  <EchteFotos dienst={d.slug} />

  <section class="section section--soft">
    <div class="wrap">
      <h2>Veelgestelde vragen: {(KLUS_NAAM[d.slug] ?? d.titel).toLowerCase()} in {p.naam}</h2>
      <div class="faq" style="margin-top:16px; max-width:760px;">
        {faq.map((f) => (
          <details>
            <summary>{f.v}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
      <p style="margin-top:18px; max-width:760px;">Staat je vraag er niet bij? Stuur me een appje met een foto via <a href={waHref(`Hallo, ik heb een vraag over ${d.titel.toLowerCase()} in ${p.naam}.`)}>WhatsApp</a> of bel <a href={telHref}>{SITE.telefoonWeergave}</a>, dan kijk ik met je mee.</p>
    </div>
  </section>

  <section class="section section--white">
    <div class="wrap">
      <h2>Meer in {p.naam} en omgeving</h2>
      <div class="chips">
        <a class="chip" href={`/werkgebied/${p.slug}/`}>Dakdekker in {p.naam} →</a>
        <a class="chip" href={`/diensten/${d.slug}/`}>Over {d.titel.toLowerCase()} →</a>
        <a class="chip" href="/werkgebied/">Heel mijn werkgebied →</a>
      </div>
      {zelfdePlaats.length > 0 && (
        <>
          <h3 style="margin-top:22px;">Ook in {p.naam}</h3>
          <div class="chips">
            {zelfdePlaats.map((x) => <a class="chip" href={`/werkgebied/${p.slug}/${x.slug}/`}>{KLUS_NAAM[x.slug] ?? x.titel}</a>)}
          </div>
        </>
      )}
      {zelfdeDienst.length > 0 && (
        <>
          <h3 style="margin-top:22px;">{KLUS_NAAM[d.slug] ?? d.titel} in de buurt</h3>
          <div class="chips">
            {zelfdeDienst.map((x) => <a class="chip" href={`/werkgebied/${x.slug}/${d.slug}/`}>{x.naam}</a>)}
          </div>
        </>
      )}
    </div>
  </section>
</Base>
