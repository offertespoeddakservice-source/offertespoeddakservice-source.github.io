---
import Base from "../../../layouts/Base.astro";
import { SITE, telHref, waHref } from "../../../site.config.ts";
import { MATRIX } from "../../../data/matrix.ts";
import { getPlaats } from "../../../data/plaatsen.ts";
import { getDienst } from "../../../data/diensten.ts";
import { PRIJZEN } from "../../../data/prijzen.ts";
import EchteFotos from "../../../components/EchteFotos.astro";
import { ARTIKELEN } from "../../../data/artikelen.ts";

export function getStaticPaths() {
  return MATRIX.map((c) => {
    const p = getPlaats(c.plaats);
    const d = getDienst(c.dienst);
    return { params: { plaats: c.plaats, dienst: c.dienst }, props: { p, d, hook: c.hook, faqExtra: c.faq ?? [] } };
  }).filter((x) => x.props.p && x.props.d && !x.props.d.verborgen); // diensten die Rens niet doet: geen plaatspagina's
}

const { p, d, hook, faqExtra } = Astro.props;
const path = `/werkgebied/${p.slug}/${d.slug}`;
const titel = `${d.titel} in ${p.naam}`;
// Kop zoals mensen zoeken ('dakgoot schoonmaken oss'): bij goten reinigen dezelfde woorden als in de titel.
const kop = d.slug === "goten-reinigen" ? `Dakgoot schoonmaken in ${p.naam}` : titel;
// Kop (h1) van de lekkagepagina's per plaats in de woorden waarop mensen zoeken ('daklekkage vught'), gelijk aan de titel. Alleen pagina's die ouder zijn dan 14 dagen. De h2 eronder blijft zoals hij was. Sinds 12-11-2026 ook Den Bosch, Uden, Veghel, Eindhoven, Waalwijk en Tilburg, sinds 13-11-2026 ook Helmond en Breda. Sinds 16-11-2026 ook Wijchen (gemaakt 01-11).
const LEK_H1_PLAATSEN = ["oss", "rosmalen", "vught", "berlicum", "vlijmen", "drunen", "boxtel", "schijndel", "heusden", "sint-michielsgestel", "oisterwijk", "den-bosch", "uden", "veghel", "eindhoven", "waalwijk", "tilburg", "helmond", "breda", "wijchen"];
// Kop (h1) van de gootpagina's per plaats zoals mensen zoeken ('dakgoot reparatie den bosch'), gelijk aan de titel. Alleen pagina's die ouder zijn dan 14 dagen en waarvan de kop nooit is aangepast (12-11-2026). Sinds 14-11-2026 ook Waalwijk en Uden (gemaakt 31-10). Sinds 17-11-2026 ook Rosmalen (kop nooit aangepast).
const GOOT_H1_PLAATSEN = ["den-bosch", "vught", "veghel", "oisterwijk", "boxtel", "sint-michielsgestel", "oss", "waalwijk", "uden", "rosmalen"];
const h1 = d.slug === "daklekkage" && LEK_H1_PLAATSEN.includes(p.slug)
  ? `Daklekkage in ${p.naam}: lek opsporen en repareren`
  : d.slug === "dakgoot-vervangen" && GOOT_H1_PLAATSEN.includes(p.slug)
    ? `Dakgoot repareren of vervangen in ${p.naam}`
    : kop;
// Titel en omschrijving per dienst waar de standaardzin niet goed loopt; de andere diensten houden de standaard.
const gotenPrijs = PRIJZEN.find((r) => r.sleutel === "goot_reinigen")?.prijs ?? "";
const metaTitelPerDienst: Record<string, string> = {
  // 17-11-2026: bij dakgoot schoonmaken per plaats de vanaf-prijs uit prijzen.ts in de titel, net als op de dienstpagina. Er wordt vooral op prijs gezocht, en de 14 pagina's hadden samen honderden vertoningen en 0 kliks.
  "goten-reinigen": `Dakgoot schoonmaken in ${p.naam}: ${gotenPrijs}`,
};
const omschrijvingPerDienst: Record<string, string> = {
  "goten-reinigen": `Dakgoot schoonmaken in ${p.naam}: ${gotenPrijs} incl. btw voor één goot, uitloop naar de regenpijp vrij en eerlijk advies over je dak. Stuur een foto of app Rens.`,
  stormschade: `Stormschade aan je dak in ${p.naam}? Weggewaaide pannen of een losse nok: ik dek het eerst af en herstel het daarna netjes. Bel of WhatsApp Rens.`,
  "dak-reinigen": `Dakreiniging in ${p.naam}: mos en groene aanslag van je pannen, de goten meteen leeg en een eerlijke blik op je dak. Vaste prijs vooraf. Bel of app Rens.`,
};
// Daklekkage per plaats: titel en omschrijving met het zoekwoord vooraan. Niet voor de lekkagepagina's die na 20-10 zijn gemaakt, die meten we eerst.
const nieuweLekPaginas = ["tilburg", "veghel", "eindhoven", "waalwijk", "breda"];
if (d.slug === "daklekkage" && !nieuweLekPaginas.includes(p.slug)) {
  metaTitelPerDienst.daklekkage = `Daklekkage ${p.naam}: lek opsporen en repareren`;
  omschrijvingPerDienst.daklekkage = `Daklekkage in ${p.naam}? Ik zoek waar het water echt binnenkomt en repareer het zonder onnodig sloopwerk. Vaste prijs vooraf. Bel of app Rens.`;
}
// Dakgoot repareren in Den Bosch: titel en omschrijving zoals mensen zoeken ('dakgoot reparatie den bosch'). Gemaakt op 22-10, dus vanaf 05-11 mag de titel. De andere gootpagina's meten we eerst.
if (d.slug === "dakgoot-vervangen" && p.slug === "den-bosch") {
  metaTitelPerDienst["dakgoot-vervangen"] = "Dakgoot repareren of vervangen in Den Bosch";
  omschrijvingPerDienst["dakgoot-vervangen"] = "Dakgoot lekt in Den Bosch? Ik repareer een lekkende naad, hoek of uitloop, of vervang de goot als hij op is. Zink of kunststof. Stuur een foto voor de prijs.";
}
// Dakgoot repareren in Vught: gemaakt op 23-10, dus vanaf 06-11 mag de titel ('dakgoot reparatie vught' plek 18,5). De andere gootpagina's meten we eerst.
if (d.slug === "dakgoot-vervangen" && p.slug === "vught") {
  metaTitelPerDienst["dakgoot-vervangen"] = "Dakgoot repareren of vervangen in Vught";
  omschrijvingPerDienst["dakgoot-vervangen"] = "Lekt je dakgoot in Vught of Helvoirt? Ik repareer een lekkende naad, hoek of uitloop, of vervang de goot als hij op is. Stuur een foto voor de prijs.";
}
// Dakgoot repareren in Veghel: gemaakt op 26-10, dus vanaf 09-11 mag de titel ('dakgoot reparatie veghel' plek 12,6, 'dakgoot lekkage veghel' plek 13,7).
if (d.slug === "dakgoot-vervangen" && p.slug === "veghel") {
  metaTitelPerDienst["dakgoot-vervangen"] = "Dakgoot repareren of vervangen in Veghel";
  omschrijvingPerDienst["dakgoot-vervangen"] = "Lekt je dakgoot in Veghel of een van de kerkdorpen? Ik repareer een lekkende naad, hoek of uitloop, of vervang de goot als hij op is. Stuur een foto voor de prijs.";
}
// Dakgoot repareren in Oisterwijk, Boxtel en Sint-Michielsgestel: gemaakt op 29-10, dus vanaf 12-11 mag de titel. Oss: vanaf 13-11 ('dakgoot reparatie oss' plek 55,6). Elk een eigen omschrijving, zonder 'vaste prijs vooraf'. Waalwijk en Uden sinds 14-11-2026. Rosmalen sinds 17-11-2026 (158 vertoningen op plek 41, 0 kliks).
const GOOT_OMSCHRIJVING_NIEUW: Record<string, string> = {
  oisterwijk: "Lekt je dakgoot in Oisterwijk of Moergestel, of zit hij vol naalden en blad? Ik soldeer een lekke naad, zet een losse hoek vast of vervang de goot. Stuur een foto.",
  boxtel: "Druppelt je dakgoot in Boxtel of Liempde bij een hoek of de regenpijp? Ik repareer de naad of uitloop, of vervang de goot als hij op is. App een foto voor de prijs.",
  "sint-michielsgestel": "Lekkende dakgoot in Sint-Michielsgestel, Gemonde of Den Dungen? Ik zoek waar hij lekt en repareer de naad of het hoekstuk, of vervang de goot. Stuur een foto voor de prijs.",
  oss: "Lekt je dakgoot in Oss of Berghem, of hangt hij door? Een zinken naad soldeer ik, kunststof zet ik weer vast, en een goot die op is vervang ik. App een foto.",
  waalwijk: "Loopt je dakgoot over of lekt hij in Waalwijk, Sprang-Capelle of Waspik? Ik kijk of het een naad, de uitloop of de regenpijp is. Stuur een foto.",
  uden: "Lekt je kunststof dakgoot in Uden bij een naad of hoek, zoals in Bitswijk of Hoenderbos? Vaak is één stuk vervangen genoeg. Stuur een foto.",
  rosmalen: "Lekt je dakgoot in Rosmalen, of zakt hij bij een rotte houten gootklos? Ik herstel de naad, hang de goot weer op afschot of vervang hem. Stuur een foto.",
};
if (d.slug === "dakgoot-vervangen" && GOOT_OMSCHRIJVING_NIEUW[p.slug]) {
  metaTitelPerDienst["dakgoot-vervangen"] = `Dakgoot repareren of vervangen in ${p.naam}`;
  omschrijvingPerDienst["dakgoot-vervangen"] = GOOT_OMSCHRIJVING_NIEUW[p.slug];
}
// Dakgoot schoonmaken in Oisterwijk, Vught, Oss en Den Bosch: een eigen omschrijving in plaats van dezelfde zin met alleen een andere plaatsnaam (13-11-2026). De titel blijft gelijk, de andere gootpagina's houden de standaard. Sinds 14-11-2026 (ronde 4) ook Veghel, Boxtel, Sint-Michielsgestel, Waalwijk, Rosmalen en Drunen.
const GOOT_SCHOON_OMSCHRIJVING: Record<string, string> = {
  oisterwijk: `Dakgoot schoonmaken in Oisterwijk, Moergestel of Haaren? Blad, naalden en mos eruit en de uitloop vrij. Eén goot: ${gotenPrijs} incl. btw. Stuur een foto.`,
  vught: `Dakgoot schoonmaken in Vught of Helvoirt? Ik haal blad en dennennaalden uit de goot en maak de uitloop vrij. Eén goot: ${gotenPrijs} incl. btw.`,
  oss: `Dakgoot schoonmaken in Oss of Berghem? Ook de goot aan de achterkant, als ik er veilig bij kan, met de uitloop vrij. Eén goot: ${gotenPrijs} incl. btw.`,
  "den-bosch": `Dakgoot schoonmaken in Den Bosch? Ook een goot achter de gevel of tussen twee panden in de binnenstad, met de uitloop vrij. Eén goot: ${gotenPrijs} incl. btw.`,
  veghel: `Dakgoot schoonmaken in Veghel of Mariaheide? Ook onder een rooster of borstel, en de lage goot van je garage. Eén goot: ${gotenPrijs} incl. btw.`,
  boxtel: `Dakgoot schoonmaken in Boxtel? Ook blad en nestmateriaal van duiven onder zonnepanelen, met de uitloop vrij. Eén goot: ${gotenPrijs} incl. btw.`,
  "sint-michielsgestel": `Dakgoot schoonmaken in Sint-Michielsgestel of Den Dungen? Goot leeg, uitloop vrij en de bladvanger in je regenpijp schoon. Eén goot: ${gotenPrijs} incl. btw.`,
  waalwijk: `Dakgoot schoonmaken in Waalwijk? Ook de afvoer van een plat dak met grind achter je huis, met de uitloop vrij. Eén goot: ${gotenPrijs} incl. btw.`,
  rosmalen: `Dakgoot schoonmaken in Rosmalen? Blad en brokjes specie van de nok eruit, en de afvoer van een plat dak in De Groote Wielen. Eén goot: ${gotenPrijs} incl. btw.`,
  drunen: `Dakgoot schoonmaken in Drunen? Dennennaalden, zand en mos eruit, ook onder een rooster, en de uitloop vrij. Eén goot: ${gotenPrijs} incl. btw.`,
};
if (d.slug === "goten-reinigen" && GOOT_SCHOON_OMSCHRIJVING[p.slug]) {
  omschrijvingPerDienst["goten-reinigen"] = GOOT_SCHOON_OMSCHRIJVING[p.slug];
}
// Daklekkage in Veghel: gemaakt op 24-10, dus vanaf 07-11 mag de titel ('daklekkage veghel' plek 23, pagina plek 25 met 116 vertoningen en 0 kliks). Eigen omschrijving zonder 'vaste prijs vooraf'.
if (d.slug === "daklekkage" && p.slug === "veghel") {
  metaTitelPerDienst.daklekkage = "Daklekkage Veghel: lek opsporen en repareren";
  omschrijvingPerDienst.daklekkage = "Daklekkage in Veghel? Ik zoek waar het water binnenkomt, bijvoorbeeld onder een dakraam of bij de schoorsteen, en repareer alleen wat nodig is. Bel of app Rens.";
}
// Daklekkage in Tilburg (gemaakt 24-10), Eindhoven en Waalwijk (gemaakt 25-10): de 14 dagen zijn om, dus ook hier het zoekwoord vooraan. Eigen omschrijving zonder 'vaste prijs vooraf'. Breda (gemaakt 27-10) sinds 10-11 ook. Sinds 12-11-2026 ook Vught, Oisterwijk, Boxtel, Vlijmen en Schijndel (plek 6 tot 17, nog 0 kliks): eigen omschrijving, titel ongewijzigd. Sinds 13-11-2026 ook Helmond (eigen omschrijving). Sinds 14-11-2026 ook Rosmalen, Uden, Drunen, Heusden, Berlicum en Sint-Michielsgestel (eigen omschrijving, titel ongewijzigd). Sinds 20-11-2026 ook Den Bosch, Oss en Wijchen (hadden nog de standaardzin).
const LEK_OMSCHRIJVING_NIEUW: Record<string, string> = {
  "den-bosch": "Daklekkage in Den Bosch, Empel of Engelen? In de binnenstad, de Kruiskamp of Maaspoort zoek ik waar het water binnenkomt en maak ik het dicht. App Rens.",
  oss: "Daklekkage in Oss, Berghem of Ussen? Bij het lood rond de schoorsteen, onder een dakraam of bij een regenpijp in de muur zoek ik waar het binnenkomt.",
  wijchen: "Daklekkage in Wijchen, Alverna of Batenburg? Onder een dakraam, bij het platte dak van de aanbouw of de schoorsteen zoek ik waar het binnenkomt. App Rens.",
  tilburg: "Daklekkage in Tilburg? Ik zoek waar het water binnenkomt, bijvoorbeeld bij een dak uit de jaren '80 of '90 in de Reeshof, en repareer alleen wat nodig is. Bel of app Rens.",
  eindhoven: "Daklekkage in Eindhoven? Ik zoek waar het water binnenkomt, bijvoorbeeld bij de zonnepanelen of onder de dakrand, en repareer alleen wat nodig is. Stuur een foto of app Rens.",
  waalwijk: "Daklekkage in Waalwijk, Sprang-Capelle of Waspik? Ik zoek waar het water binnenkomt, bijvoorbeeld bij een oude schoorsteen of een schuur met golfplaten, en repareer alleen wat nodig is. Bel of app Rens.",
  breda: "Daklekkage in Breda of Prinsenbeek? Ik zoek waar het water binnenkomt, bijvoorbeeld bij een oude pan in Ginneken, en repareer wat nodig is. Stuur een foto.",
  vught: "Daklekkage in Vught, Helvoirt of Cromvoirt? Ik zoek waar het water binnenkomt, bijvoorbeeld bij oud lood of een kilgoot, en repareer wat nodig is. App Rens.",
  oisterwijk: "Daklekkage in Oisterwijk of Moergestel? Ik zoek waar het water binnenkomt, bijvoorbeeld bij de schoorsteen of onder mos, en repareer wat nodig is. App Rens.",
  boxtel: "Daklekkage in Boxtel, Liempde of Esch? Ik zoek waar het water binnenkomt, bijvoorbeeld bij de schoorsteen of een erker, en repareer wat nodig is. App Rens.",
  vlijmen: "Lekkage in Vlijmen, Nieuwkuijk of Haarsteeg? Ik zoek waar het water binnenkomt, bijvoorbeeld bij een lichtkoepel of het platte dak van de berging. App Rens.",
  schijndel: "Daklekkage in Schijndel of Wijbosch? Ik zoek waar het water binnenkomt, bijvoorbeeld bij oude pannen of een schuur, en repareer wat nodig is. App Rens.",
  helmond: "Daklekkage in Helmond, Stiphout of Brandevoort? Ik zoek waar het water binnenkomt, bijvoorbeeld bij het lood rond de schoorsteen of in een kilgoot vol blad. Stuur een foto.",
  rosmalen: "Daklekkage in Rosmalen, Hintham of De Groote Wielen? Bij de nok, een dakdoorvoer of het platte dak van de aanbouw zoek ik waar het binnenkomt. App Rens.",
  uden: "Daklekkage in Uden, Volkel of Odiliapeel? Ik zoek waar het water binnenkomt, bijvoorbeeld rond een dakraam of de schoorsteen, en repareer wat nodig is. App Rens.",
  drunen: "Daklekkage in Drunen of Elshout? Bij oud lood rond de schoorsteen of een goot vol zand en blad zoek ik waar het water binnenkomt. Stuur een foto.",
  heusden: "Daklekkage in Heusden, Oudheusden of Herpt? Ik zoek waar het water binnenkomt, ook bij oude pannen en lood in de vesting, en repareer wat nodig is. App Rens.",
  berlicum: "Daklekkage in Berlicum of Middelrode? Bij het lood rond de schoorsteen of een pan die is gaan schuiven zoek ik waar het binnenkomt. Stuur een foto via WhatsApp.",
  "sint-michielsgestel": "Daklekkage in Sint-Michielsgestel, Den Dungen of Gemonde? Ik zoek waar het binnenkomt, bij het lood, de nok of een goot vol blad, en repareer wat nodig is.",
};
if (d.slug === "daklekkage" && LEK_OMSCHRIJVING_NIEUW[p.slug]) {
  metaTitelPerDienst.daklekkage = `Daklekkage ${p.naam}: lek opsporen en repareren`;
  omschrijvingPerDienst.daklekkage = LEK_OMSCHRIJVING_NIEUW[p.slug];
}
// 17-11-2026 ronde 5: daklekkage Vught (186 vertoningen op plek 10,5) en Oisterwijk (84 op plek 9,7), allebei 0 kliks. Titel ongewijzigd sinds eind oktober. Zoekwoord vooraan, daarna wat mensen willen weten. Kop (h1) en omschrijving blijven zoals ze zijn.
// 18-11-2026 ronde 5: ook Boxtel ('daklekkage boxtel' 91 vertoningen op plek 15), Schijndel (46 op plek 12,7) en Vlijmen ('lekkage vlijmen' 43 op plek 6,6), alle drie 0 kliks en de titel sinds oktober ongewijzigd. Kop (h1) en omschrijving blijven zoals ze zijn.
// 20-11-2026 ronde 1: ook Oss (daklekkage oss 111 vertoningen op plek 20,9, 0 kliks, titel sinds oktober ongewijzigd).
const LEK_TITEL_NIEUW: Record<string, string> = {
  oss: "Daklekkage Oss? Vaak dezelfde dag langs",
  vught: "Daklekkage Vught? Vaak dezelfde dag langs",
  oisterwijk: "Daklekkage Oisterwijk? Vaak dezelfde dag langs",
  boxtel: "Daklekkage Boxtel? Vaak dezelfde dag langs",
  schijndel: "Daklekkage Schijndel? Vaak dezelfde dag langs",
  vlijmen: "Daklekkage Vlijmen? Vaak dezelfde dag langs",
};
if (d.slug === "daklekkage" && LEK_TITEL_NIEUW[p.slug]) {
  metaTitelPerDienst.daklekkage = LEK_TITEL_NIEUW[p.slug];
}
// Stormschade per plaats: titel met 'stormschade dak' vooraan, zoals mensen zoeken. Niet voor de stormpagina's die na 23-10 zijn gemaakt (Waalwijk 01-11, Veghel 03-11), die meten we eerst. 17-11-2026: de 14 dagen voor Waalwijk (01-11) en Veghel (03-11) zijn om, dus nu alle stormpagina's.
const nieuweStormPaginas: string[] = [];
if (d.slug === "stormschade" && !nieuweStormPaginas.includes(p.slug)) {
  metaTitelPerDienst.stormschade = `Stormschade dak ${p.naam}: afdekken en herstellen`;
}
// 20-11-2026 ronde 1: elke stormpagina een eigen omschrijving in plaats van dezelfde zin met alleen een andere plaatsnaam. Titel en kop blijven zoals ze zijn.
const STORM_OMSCHRIJVING: Record<string, string> = {
  oss: "Stormschade in Oss of Berghem? Een losgewaaide loodslab, een scheve kap op de schoorsteen of losse pannen: eerst afdekken, daarna netjes herstellen.",
  "den-bosch": "Stormschade in Den Bosch? Losse pannen langs de topgevel in de binnenstad of een verschoven nokvorst in Maaspoort: ik dek eerst af en herstel het daarna.",
  rosmalen: "Stormschade in Rosmalen? Losse pannen langs de rand bij de Maliskamp of een gebroken pan onder de zonnepanelen: eerst dicht, dan netjes herstellen.",
