---
import Base from "../../layouts/Base.astro";
import { SITE, telHref } from "../../site.config.ts";
import { PLAATSEN, getPlaats } from "../../data/plaatsen.ts";
import { MATRIX } from "../../data/matrix.ts";
import { getDienst } from "../../data/diensten.ts";
import type { Dienst } from "../../data/diensten.ts";
import type { Plaats } from "../../data/plaatsen.ts";
// Per klus de plaatsen die een eigen pagina hebben (uit MATRIX), zodat die pagina's vanaf het overzicht te vinden zijn.
const perDienst = [...new Set(MATRIX.map((c) => c.dienst))]
  .map((slug) => ({ d: getDienst(slug), plaatsen: MATRIX.filter((c) => c.dienst === slug).map((c) => getPlaats(c.plaats)).filter((p): p is Plaats => !!p) }))
  .filter((x): x is { d: Dienst; plaatsen: Plaats[] } => !!x.d && !x.d.verborgen && x.plaatsen.length > 0);
// Namen voor de klussen zoals mensen zoeken, gelijk aan de chips op de plaatspagina's.
const KLUS_NAAM: Record<string, string> = { daklekkage: "Daklekkage", "dakgoot-vervangen": "Dakgoot repareren of vervangen", "goten-reinigen": "Dakgoot schoonmaken", stormschade: "Stormschade", dakreparatie: "Dakreparatie", dakrenovatie: "Dakrenovatie" };
// Vragen over het werkgebied, ook als FAQPage-schema.
const faq = [
  { v: "Hoe ver reis je vanuit Den Bosch?", a: "Ik werk vanuit Den Bosch, vooral in Brabant en in de steden eromheen, zoals Tilburg, Breda, Eindhoven, Helmond en Nijmegen. Rosmalen, Vught, Vlijmen en Berlicum liggen op een kwartier of minder. Breda, Eindhoven en Helmond zijn zo'n 40 minuten rijden. Woon je verder weg, bel of app dan met een foto van je dak. Dan zeg ik eerlijk of ik kan komen, en een klus verder weg plan ik vooraf met je in." },
  { v: "Kom je bij lekkage ook buiten Den Bosch?", a: "Ja, in mijn hele werkgebied. In de plaatsen dicht bij Den Bosch lukt het bij lekkage vaak nog dezelfde dag. Bel of app me met een foto van de natte plek, dan hoor je meteen wanneer ik kan." },
  { v: "Mijn plaats staat er niet bij. Kom je toch?", a: "Dat hangt af van waar je woont en wat er aan de hand is. Stuur een appje of bel even, dan zeg ik eerlijk of ik kan komen." },
  { v: "Kom je ook over de Waal, in Tiel of Culemborg?", a: "Ja. Tiel en Culemborg liggen aan de overkant van de Waal, in de Betuwe. Vanuit Den Bosch is dat ruim een half uur rijden. Een klus daar, zoals goten schoonmaken, een losse pan of lood bij de schoorsteen, plan ik vooraf met je in. Lekt het, stuur dan eerst een foto van de natte plek en van je dak vanaf de straat via WhatsApp. Dan hoor je eerlijk wanneer ik kan komen." },
  { v: "Kom je ook in Nijmegen?", a: "Ja. Nijmegen ligt aan de Waal, voorbij Wijchen. In Nijmegen-Oost en de wijken rond het centrum staan veel oude herenhuizen en rijtjes van rond 1900, vaak met een steil pannendak, een schoorsteen en zinken goten. Bij zulke huizen zit een lek meestal in het lood rond de schoorsteen of in een naad van de goot. Dukenburg en Lindenholt zijn grotendeels in de jaren '70 en '80 gebouwd, met veel rijtjes waar de nokvorsten nog in specie kunnen liggen. In Lent en Oosterhout, aan de noordkant van de Waal, staan vooral nieuwere huizen. Nijmegen is voor mij een flink stuk rijden vanaf Den Bosch, dus een klus daar plan ik vooraf met je in. Lekt het, stuur dan eerst een foto van de natte plek en van je dak vanaf de straat via WhatsApp. Dan hoor je eerlijk wanneer ik kan komen." },
  { v: "Kom je ook in Geldermalsen en de rest van West Betuwe?", a: "Ja. Geldermalsen ligt aan de Linge, net over de Waal, en hoort sinds 2019 bij de gemeente West Betuwe, samen met onder meer Beesd, Waardenburg en Haaften. Waardenburg ligt vlak over de brug bij Zaltbommel. Ik kom er voor een lekkend dak, een goot die overloopt of lekt, en losse pannen of lood. Omdat het voor mij een stuk rijden is, spreken we zo'n klus vooraf af. Maak een foto van je dak vanaf de straat, of van de natte plek als het binnen lekt, en app die naar me. Dan laat ik weten wat ik zie en welke dag ik kan." },
  { v: "Kom je ook in Gorinchem?", a: "Ja. Gorinchem ligt aan de Merwede, tegenover Woudrichem, op de plek waar de Linge in de rivier uitkomt. De oude binnenstad ligt binnen de vestingwallen, met smalle panden en oude daken met pannen, lood en zinken goten. Daaromheen liggen wijken van na de oorlog en nieuwere wijken zoals Hoog Dalem. Bij de oude panden in de vesting kijk ik bij een lek eerst naar het lood en de goten tussen de panden, bij de nieuwere huizen eerder naar de pannen, de nok en de aansluiting op een plat dak. Vanuit Den Bosch is het een flink stuk rijden, dus een klus in Gorinchem spreken we vooraf af. App me een foto van je dak vanaf de straat, of van de natte plek als het binnen lekt, dan laat ik weten wat ik zie en wanneer ik kan." },
  { v: "Kom je ook in Arnhem en Oosterbeek?", a: "Ja, voor een klus die we vooraf inplannen. Arnhem ligt aan de Rijn, voorbij Nijmegen. In de Burgemeesterswijk en rond park Sonsbeek staan veel huizen en villa's van rond 1900 tot de jaren '30, vaak met een steil pannendak, lood rond de schoorsteen en zinken goten. In Arnhem-Zuid, zoals Elderveld en De Laar, staan vooral rijtjes uit de jaren '70 en '80. Oosterbeek, in de gemeente Renkum, ligt tussen de bossen, en daar lopen goten en kilgoten sneller vol met blad en naalden. Op Werkspot staat ook een review van een klant uit Oosterbeek. Omdat het voor mij een flink stuk rijden is, spreken we zo'n klus vooraf af. Stuur me een foto van je dak vanaf de straat, of van de natte plek als het binnen lekt, via WhatsApp. Dan zeg ik eerlijk wat ik zie en wanneer ik kan komen." },
  { v: "Kom je ook in de Kempen, zoals Bladel en Eersel?", a: "Ja, voor een klus die we vooraf inplannen. De Kempen is het gebied ten westen en zuidwesten van Eindhoven, met onder meer de gemeenten Bladel, Eersel, Bergeijk en Reusel-De Mierden. Daar staan nog veel oude langgevelboerderijen met een lang, laag pannendak en een lange goot, en dorpen met vrijstaande huizen tussen de bossen en de heide. Bij zulke daken gaat het vaak om een goot die vol blad en naalden zit, een losse nokvorst of het lood rond de schoorsteen. Vanuit Den Bosch is het een flink stuk rijden, dus ik wil vooraf graag zien wat er speelt. Stuur een foto van je dak vanaf de straat, of van de natte plek als het binnen lekt, via WhatsApp. Dan zeg ik eerlijk wat ik zie en wanneer ik kan komen." },
  { v: "Kom je ook in Budel, Maarheeze en Weert?", a: "Ja, voor een klus die we vooraf afspreken. Budel en Maarheeze horen bij de gemeente Cranendonck, in het zuiden van Brabant, tegen de grens met Limburg en België. Weert ligt net over die grens, in Limburg, en is een eigen gemeente. Vanuit Den Bosch ben ik er ongeveer een uur onderweg, dus ik wil vooraf graag weten wat er speelt. Ik kom er voor een lekkend dak, een goot die lekt of overloopt, en losse pannen, nokvorsten of lood. Stuur een foto van je dak vanaf de straat, of van de natte plek als het binnen lekt, via WhatsApp. Dan zeg ik eerlijk wat ik zie en wanneer ik kan komen." },
  { v: "Kom je ook in Utrecht, Nieuwegein en Houten?", a: "Ja, op afspraak. Utrecht ligt een flink stuk boven Den Bosch, dus zo'n klus plan ik vooraf met je in. In de binnenstad van Utrecht staan veel oude panden en monumenten, in wijken als Lombok en Oog in Al veel huizen van rond 1900 tot de jaren '30, en in Overvecht en Kanaleneiland naoorlogse flats en rijtjes. Nieuwegein en Houten zijn grotendeels vanaf de jaren '70 gebouwd, met veel rijtjeshuizen en twee-onder-een-kappers met een pannendak, en Leidsche Rijn is vanaf eind jaren '90 gebouwd. Ik kom er voor een lek, een lekkende of volle dakgoot, losse pannen of nokvorsten en lood dat los zit. Lekt het, stuur dan eerst een foto van de natte plek en van je dak vanaf de straat via WhatsApp. Dan hoor je eerlijk wanneer ik kan komen." },
  { v: "Kom je ook in Dordrecht, Papendrecht en Sliedrecht?", a: "Ja, op afspraak. Dordrecht ligt op een eiland tussen de rivieren. In de binnenstad rond de oude havens staan veel monumenten en oude panden dicht op elkaar, vaak met een steil dak, lood en zinken goten. Wijken als Sterrenburg en Stadspolders zijn grotendeels in de jaren '70 en '80 gebouwd, met veel rijtjeshuizen met een pannendak. Papendrecht en Sliedrecht liggen aan de overkant van de Merwede. Vanuit Den Bosch is het ongeveer een uur rijden, dus een klus daar plan ik vooraf met je in. Ik kom er voor een lek, een goot die lekt of overloopt, en pannen of lood die los zitten. Stuur eerst een foto van je dak vanaf de straat, of van de natte plek als het binnen lekt, via WhatsApp. Dan hoor je eerlijk wat ik zie en wanneer ik kan komen." },
  { v: "Mijn dorp heeft geen eigen pagina. Kom je daar ook?", a: "Meestal wel. Veel dorpen hebben geen eigen pagina, maar staan op de pagina van de plaats ernaast. Nuland, Vinkel, Engelen en Bokhoven vind je bij Den Bosch, Helvoirt en Cromvoirt bij Vught, Nieuwkuijk en Haarsteeg bij Vlijmen, Middelrode en Heeswijk-Dinther bij Berlicum, Den Dungen en Gemonde bij Sint-Michielsgestel, Liempde en Esch bij Boxtel, Moergestel en Haaren bij Oisterwijk, Berghem, Geffen en Lith bij Oss, Erp en Mariaheide bij Veghel, Volkel en Odiliapeel bij Uden, en Udenhout en Berkel-Enschot bij Tilburg. Staat jouw dorp er niet bij, stuur dan een foto van je dak via WhatsApp en zeg waar je woont. Dan hoor je eerlijk wanneer ik kan komen." },
  { v: "Kom je ook in het Land van Altena, zoals Almkerk, Andel en Woudrichem?", a: "Ja. Almkerk, Andel, Giessen, Sleeuwijk, Werkendam en Woudrichem horen bij de gemeente Altena, die in 2019 is ontstaan uit de gemeenten Aalburg, Werkendam en Woudrichem. Het Land van Altena ligt tussen de Bergsche Maas en de Merwede, ten noordwesten van Heusden. Woudrichem is een oud vestingstadje aan het water, tegenover Slot Loevestein. Andel ligt aan de Afgedamde Maas, en Werkendam aan de rand van de Biesbosch. Daartussen ligt open polderland met boerderijen en dijkhuizen, en op zo'n breed pannendak heeft de wind veel grip op de nok en de pannen langs de zijkant. Wijk en Aalburg, Genderen en Eethen staan bij de pagina over Heusden. Vanuit Den Bosch ben ik er in zo'n drie kwartier, dus werk dat kan wachten zetten we samen op een vaste dag. Lekt het binnen, stuur me dan via WhatsApp een foto van de natte plek en van je dak vanaf de straat." },
  { v: "Kom je ook in Venlo en Venray, in Noord-Limburg?", a: "Ja, voor een klus die we vooraf afspreken. Venlo ligt aan de Maas, vlak bij de grens met Duitsland, met Blerick aan de overkant van de rivier. Ook Tegelen, Belfeld, Arcen en Velden horen bij de gemeente Venlo. In Tegelen werden vroeger veel dakpannen gebakken, en op oudere huizen in de streek kunnen nog pannen liggen die niet meer gemaakt worden. Is er zo'n pan kapot, dan zoek ik er een die in vorm en kleur aansluit. Venray ligt ten noorden van Venlo en is een eigen gemeente, met kerkdorpen als Oostrum en Ysselsteyn. Vanuit Den Bosch ben ik ongeveer een uur onderweg. Lekt het, zet dan een emmer onder de druppel en stuur me via WhatsApp een foto van de natte plek en van je dak vanaf de straat. Dan zeg ik eerlijk wat ik zie en welke dag ik kan." },
  // 22-11-2026 ronde 4: de Bommelerwaard, die nu alleen op de plaatspagina's van Den Bosch en Heusden staat.
  { v: "Kom je ook in de Bommelerwaard, zoals Hedel, Kerkdriel en Zaltbommel?", a: "Ja. De Bommelerwaard ligt tussen de Maas en de Waal, aan de noordkant van Den Bosch. Hedel ligt net aan de overkant van de Maas. Ammerzoden, Kerkdriel, Velddriel en Rossum liggen iets verder, en ze horen allemaal bij de gemeente Maasdriel. Zaltbommel ligt aan de Waal en is een eigen gemeente, met dorpen als Brakel, Gameren en Kerkwijk. Ik kom er voor een lekkend dak, een goot die lekt of overloopt, en losse pannen of lood. Meer over deze dorpen lees je op de pagina over Den Bosch. Stuur een foto van je dak vanaf de straat, of van de natte plek als het binnen lekt, via WhatsApp. Dan hoor je wat ik zie en wanneer ik kan komen." },
  // 23-11-2026 ronde 1: gootreparatie in de rest van Brabant ('dakgoot reparatie noord brabant' 38 vertoningen op plek 42).
  { v: "Repareer je ook dakgoten in de rest van Noord-Brabant?", a: "Ja. Vanuit Den Bosch repareer ik dakgoten in een groot deel van Brabant: een naad of hoek die lekt, een uitloop naar de regenpijp die los zit, een goot die doorhangt of een goot die op is en vervangen moet worden. Voor tien plaatsen staat er een eigen pagina over dakgoot repareren of vervangen: Den Bosch, Rosmalen, Vught, Oss, Veghel, Uden, Boxtel, Sint-Michielsgestel, Oisterwijk en Waalwijk. Woon je verder weg, zoals rond Tilburg, Breda, Eindhoven of Helmond, dan plan ik zo'n klus vooraf met je in. Een lekkende goot is zelden spoed zolang het water buiten valt. Komt het water binnen, bovenin de muur of langs een kozijn, zeg dat er dan bij. Stuur een foto van de goot vanaf de straat via WhatsApp, het liefst tijdens of vlak na een bui. Je hoort vooraf wat het kost." },
];
const faqSchema = { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: faq.map((f) => ({ "@type": "Question", name: f.v, acceptedAnswer: { "@type": "Answer", text: f.a } })) };
// Gestructureerde gegevens: het werkgebied als verzameling, met alle plaatspagina's (zoals bij /kennisbank/ en /diensten/).
const lijstSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Werkgebied van Spoed Dak Service",
  url: `${SITE.url}/werkgebied/`,
  inLanguage: "nl-NL",
  publisher: { "@id": `${SITE.url}/#bedrijf` },
  mainEntity: {
    "@type": "ItemList",
    itemListElement: PLAATSEN.map((p, i) => ({ "@type": "ListItem", position: i + 1, url: `${SITE.url}/werkgebied/${p.slug}/`, name: `Dakdekker in ${p.naam}` })),
  },
};
---

<Base
  title={`Werkgebied: dakdekker regio Den Bosch | ${SITE.bedrijfsnaam}`}
  description="Dakdekker uit Den Bosch voor lekkage, pannen en goten: van Rosmalen, Vught en Oss tot Tilburg, Eindhoven, Breda en Nijmegen. Ook je dorp? App me gerust."
  path="/werkgebied"
  schema={[faqSchema, lijstSchema]}
>
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow" style="color:#ffb486;">Werkgebied</p>
      <h1>Dakdekker in de regio Den Bosch, Brabant en de steden eromheen</h1>
      <p class="lead" style="margin-bottom:12px;">Spoed Dak Service is een dakdekker uit 's-Hertogenbosch voor daklekkage, dakreparatie en dakgoten. Ik werk vooral in Brabant en in de steden eromheen.</p>
      <p class="lead">Kies hieronder je plaats. Woon je verder weg, of staat je plaats er niet bij? Bel of app gerust met een foto van je dak, dan zeg ik eerlijk of ik kan komen.</p>
    </div>
  </section>
  <section class="section">
    <div class="wrap">
      <h2 class="sr-only">Plaatsen in mijn werkgebied</h2>
      <div class="grid grid-3">
        {PLAATSEN.map((p) => (
          <a class="card" href={`/werkgebied/${p.slug}/`}>
            <h3>{p.naam}</h3>
            <p>{p.reistijd ?? "In mijn werkgebied"}{p.wijken.length > 0 && <><br />{p.wijken.slice(0, 3).join(", ")}</>}</p>
          </a>
        ))}
      </div>
      <h2 style="margin-top:36px;">Per klus en plaats</h2>
      <p>Voor de klussen waar het meest naar gevraagd wordt, heb ik per plaats een eigen pagina. Daar lees je hoe ik die klus aanpak en waar je bij de huizen in die plaats op let.</p>
      {perDienst.map((x) => (
        <p><strong>{KLUS_NAAM[x.d.slug] ?? x.d.titel}:</strong> {x.plaatsen.map((p, i) => (<>{i > 0 && ", "}<a href={`/werkgebied/${p.slug}/${x.d.slug}/`}>{p.naam}</a></>))}</p>
      ))}
      <p style="margin-top:24px;">
        Staat je plaats er niet tussen? <a href={telHref}>Bel {SITE.telefoonWeergave}</a>, dan kijk ik graag of ik kan komen.
      </p>
    </div>
  </section>
  <section class="section section--soft">
    <div class="wrap">
      <h2>Vragen over mijn werkgebied</h2>
      <div class="faq" style="margin-top:16px; max-width:760px;">
        {faq.map((f) => (
          <details>
            <summary>{f.v}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
  <section class="section">
    <div class="wrap prose">
      <h2>In het kort</h2>
      <ul>
        <li><strong>Wie:</strong> Spoed Dak Service, het bedrijf van {SITE.eigenaar}, dakdekker uit 's-Hertogenbosch. Je hebt één vaste man aan de lijn, geen callcenter.</li>
        <li><strong>Waar:</strong> vanuit 's-Hertogenbosch in Brabant en de steden eromheen. Rosmalen, Vught, Vlijmen en Berlicum liggen op een kwartier of minder, Breda, Eindhoven en Helmond op zo'n 40 minuten rijden.</li>
        <li><strong>Klussen:</strong> daklekkage, losse dakpannen en nokvorsten, lood, dakgoten repareren en schoonmaken, platte daken en stormschade.</li>
        <li><strong>Spoed:</strong> bij lekkage in de plaatsen dicht bij Den Bosch vaak nog dezelfde dag. Klussen verder weg plan ik vooraf met je in.</li>
        <li><strong>Contact:</strong> bellen of WhatsApp op <a href={telHref}>{SITE.telefoonWeergave}</a>, dag en nacht bereikbaar.</li>
        <li><strong>Prijs:</strong> je hoort de vaste prijs voordat ik begin.</li>
        {/* 23-11-2026 ronde 5: regel Betalen, gelijk aan de plaatspagina's. */}
        <li><strong>Betalen:</strong> een kleine klus, zoals een paar losse pannen of een goot leegmaken, betaal je als hij klaar is, via iDEAL. Bij groter werk spreken we vooraf af hoe en wanneer je betaalt.</li>
        <li><strong>Verzekerd:</strong> bedrijfsaansprakelijk verzekerd.</li>
      </ul>
    </div>
  </section>
</Base>
