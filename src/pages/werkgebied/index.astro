---
import Base from "../../layouts/Base.astro";
import { SITE, telHref } from "../../site.config.ts";
import { PLAATSEN, getPlaats } from "../../data/plaatsen.ts";
import { MATRIX } from "../../data/matrix.ts";
import { getDienst } from "../../data/diensten.ts";
import type { Dienst } from "../../data/diensten.ts";
import type { Plaats } from "../../data/plaatsen.ts";
// Per klus de plaatsen die een eigen pagina hebben (uit MATRIX), zodat die pagina's vanaf het overzicht te vinden zijn.
const perDienst = [...new Set(MATRIX.map((c) => c.dienst))]
  .map((slug) => ({ d: getDienst(slug), plaatsen: MATRIX.filter((c) => c.dienst === slug).map((c) => getPlaats(c.plaats)).filter((p): p is Plaats => !!p) }))
  .filter((x): x is { d: Dienst; plaatsen: Plaats[] } => !!x.d && !x.d.verborgen && x.plaatsen.length > 0);
// Vragen over het werkgebied, ook als FAQPage-schema.
const faq = [
  { v: "Hoe ver reis je vanuit Den Bosch?", a: "Ik werk vanuit Den Bosch in een straal van ongeveer 45 minuten rijden. Rosmalen, Vught, Vlijmen en Berlicum liggen op een kwartier of minder. Breda, Eindhoven en Helmond liggen aan de rand, zo'n 40 minuten rijden. Stuur daar bij een lek eerst een foto via WhatsApp, dan hoor je eerlijk wanneer ik kan komen." },
  { v: "Kom je bij lekkage ook buiten Den Bosch?", a: "Ja, in mijn hele werkgebied. In de plaatsen dicht bij Den Bosch lukt het bij lekkage vaak nog dezelfde dag. Bel of app me met een foto van de natte plek, dan hoor je meteen wanneer ik kan." },
  { v: "Mijn plaats staat er niet bij. Kom je toch?", a: "Dat hangt af van waar je woont en wat er aan de hand is. Stuur een appje of bel even, dan zeg ik eerlijk of ik kan komen." },
];
const faqSchema = { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: faq.map((f) => ({ "@type": "Question", name: f.v, acceptedAnswer: { "@type": "Answer", text: f.a } })) };
---

<Base
  title={`Werkgebied: dakdekker regio Den Bosch | ${SITE.bedrijfsnaam}`}
  description="Waar ik als dakdekker kom: Den Bosch, Rosmalen, Vught, Oss, Veghel, Waalwijk, Boxtel en meer. Staat je plaats er niet bij? App me, dan zeg ik eerlijk of ik kan komen."
  path="/werkgebied"
  schema={faqSchema}
>
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow" style="color:#ffb486;">Werkgebied</p>
      <h1>Dakdekker in {SITE.regioOmschrijving}</h1>
      <p class="lead">Ik werk vanuit {SITE.basisplaats} in een straal van ongeveer 45 minuten. Kies hieronder je plaats. Staat je plaats er niet bij? Bel of app gerust, dan zeg ik eerlijk of ik er kan komen.</p>
    </div>
  </section>
  <section class="section">
    <div class="wrap">
      <h2 class="sr-only">Plaatsen in mijn werkgebied</h2>
      <div class="grid grid-3">
        {PLAATSEN.map((p) => (
          <a class="card" href={`/werkgebied/${p.slug}/`}>
            <h3>{p.naam}</h3>
            <p>{p.reistijd ?? "In mijn werkgebied"}</p>
          </a>
        ))}
      </div>
      <h2 style="margin-top:36px;">Per klus en plaats</h2>
      <p>Voor de klussen waar het meest naar gevraagd wordt, heb ik per plaats een eigen pagina. Daar lees je wat ik in die plaats vaak tegenkom.</p>
      {perDienst.map((x) => (
        <p><strong>{x.d.titel}:</strong> {x.plaatsen.map((p, i) => (<>{i > 0 && ", "}<a href={`/werkgebied/${p.slug}/${x.d.slug}/`}>{p.naam}</a></>))}</p>
      ))}
      <p style="margin-top:24px;">
        Staat je plaats er niet tussen? <a href={telHref}>Bel {SITE.telefoonWeergave}</a>, dan kijk ik graag of ik kan komen.
      </p>
    </div>
  </section>
  <section class="section section--soft">
    <div class="wrap">
      <h2>Vragen over mijn werkgebied</h2>
      <div class="faq" style="margin-top:16px; max-width:760px;">
        {faq.map((f) => (
          <details>
            <summary>{f.v}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</Base>
