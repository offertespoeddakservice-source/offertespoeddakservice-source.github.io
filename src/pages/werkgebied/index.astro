---
import Base from "../../layouts/Base.astro";
import { SITE, telHref } from "../../site.config.ts";
import { PLAATSEN, getPlaats } from "../../data/plaatsen.ts";
import { MATRIX } from "../../data/matrix.ts";
import { getDienst } from "../../data/diensten.ts";
import type { Dienst } from "../../data/diensten.ts";
import type { Plaats } from "../../data/plaatsen.ts";
// Per klus de plaatsen die een eigen pagina hebben (uit MATRIX), zodat die pagina's vanaf het overzicht te vinden zijn.
const perDienst = [...new Set(MATRIX.map((c) => c.dienst))]
  .map((slug) => ({ d: getDienst(slug), plaatsen: MATRIX.filter((c) => c.dienst === slug).map((c) => getPlaats(c.plaats)).filter((p): p is Plaats => !!p) }))
  .filter((x): x is { d: Dienst; plaatsen: Plaats[] } => !!x.d && !x.d.verborgen && x.plaatsen.length > 0);
// Namen voor de klussen zoals mensen zoeken, gelijk aan de chips op de plaatspagina's.
const KLUS_NAAM: Record<string, string> = { daklekkage: "Daklekkage", "dakgoot-vervangen": "Dakgoot repareren of vervangen", "goten-reinigen": "Dakgoot schoonmaken", stormschade: "Stormschade", dakreparatie: "Dakreparatie", dakrenovatie: "Dakrenovatie" };
// Vragen over het werkgebied, ook als FAQPage-schema.
const faq = [
  { v: "Hoe ver reis je vanuit Den Bosch?", a: "Ik werk vanuit Den Bosch, vooral in Brabant en in de steden eromheen, zoals Tilburg, Breda, Eindhoven, Helmond en Nijmegen. Rosmalen, Vught, Vlijmen en Berlicum liggen op een kwartier of minder. Breda, Eindhoven en Helmond zijn zo'n 40 minuten rijden. Woon je verder weg, bel of app dan met een foto van je dak. Dan zeg ik eerlijk of ik kan komen, en een klus verder weg plan ik vooraf met je in." },
  { v: "Kom je bij lekkage ook buiten Den Bosch?", a: "Ja, in mijn hele werkgebied. In de plaatsen dicht bij Den Bosch lukt het bij lekkage vaak nog dezelfde dag. Bel of app me met een foto van de natte plek, dan hoor je meteen wanneer ik kan." },
  { v: "Mijn plaats staat er niet bij. Kom je toch?", a: "Dat hangt af van waar je woont en wat er aan de hand is. Stuur een appje of bel even, dan zeg ik eerlijk of ik kan komen." },
];
const faqSchema = { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: faq.map((f) => ({ "@type": "Question", name: f.v, acceptedAnswer: { "@type": "Answer", text: f.a } })) };
---

<Base
  title={`Werkgebied: dakdekker regio Den Bosch | ${SITE.bedrijfsnaam}`}
  description="Waar ik als dakdekker kom: Den Bosch, Rosmalen, Vught, Oss, Veghel, Waalwijk, Boxtel en meer. Staat je plaats er niet bij? App me, dan zeg ik eerlijk of ik kan komen."
  path="/werkgebied"
  schema={faqSchema}
>
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow" style="color:#ffb486;">Werkgebied</p>
      <h1>Dakdekker in de regio Den Bosch, Brabant en de steden eromheen</h1>
      <p class="lead" style="margin-bottom:12px;">Spoed Dak Service is een dakdekker uit 's-Hertogenbosch voor daklekkage, dakreparatie en dakgoten. Ik werk vooral in Brabant en in de steden eromheen.</p>
      <p class="lead">Kies hieronder je plaats. Woon je verder weg, of staat je plaats er niet bij? Bel of app gerust met een foto van je dak, dan zeg ik eerlijk of ik kan komen.</p>
    </div>
  </section>
  <section class="section">
    <div class="wrap">
      <h2 class="sr-only">Plaatsen in mijn werkgebied</h2>
      <div class="grid grid-3">
        {PLAATSEN.map((p) => (
          <a class="card" href={`/werkgebied/${p.slug}/`}>
            <h3>{p.naam}</h3>
            <p>{p.reistijd ?? "In mijn werkgebied"}{p.wijken.length > 0 && <><br />{p.wijken.slice(0, 3).join(", ")}</>}</p>
          </a>
        ))}
      </div>
      <h2 style="margin-top:36px;">Per klus en plaats</h2>
      <p>Voor de klussen waar het meest naar gevraagd wordt, heb ik per plaats een eigen pagina. Daar lees je wat ik in die plaats vaak tegenkom.</p>
      {perDienst.map((x) => (
        <p><strong>{KLUS_NAAM[x.d.slug] ?? x.d.titel}:</strong> {x.plaatsen.map((p, i) => (<>{i > 0 && ", "}<a href={`/werkgebied/${p.slug}/${x.d.slug}/`}>{p.naam}</a></>))}</p>
      ))}
      <p style="margin-top:24px;">
        Staat je plaats er niet tussen? <a href={telHref}>Bel {SITE.telefoonWeergave}</a>, dan kijk ik graag of ik kan komen.
      </p>
    </div>
  </section>
  <section class="section section--soft">
    <div class="wrap">
      <h2>Vragen over mijn werkgebied</h2>
      <div class="faq" style="margin-top:16px; max-width:760px;">
        {faq.map((f) => (
          <details>
            <summary>{f.v}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
  <section class="section">
    <div class="wrap prose">
      <h2>In het kort</h2>
      <ul>
        <li><strong>Wie:</strong> Spoed Dak Service, het bedrijf van {SITE.eigenaar}, dakdekker uit 's-Hertogenbosch. Je hebt één vaste man aan de lijn, geen callcenter.</li>
        <li><strong>Waar:</strong> vanuit 's-Hertogenbosch in Brabant en de steden eromheen. Rosmalen, Vught, Vlijmen en Berlicum liggen op een kwartier of minder, Breda, Eindhoven en Helmond op zo'n 40 minuten rijden.</li>
        <li><strong>Klussen:</strong> daklekkage, losse dakpannen en nokvorsten, lood, dakgoten repareren en schoonmaken, platte daken en stormschade.</li>
        <li><strong>Spoed:</strong> bij lekkage in de plaatsen dicht bij Den Bosch vaak nog dezelfde dag. Klussen verder weg plan ik vooraf met je in.</li>
        <li><strong>Contact:</strong> bellen of WhatsApp op <a href={telHref}>{SITE.telefoonWeergave}</a>, dag en nacht bereikbaar.</li>
        <li><strong>Prijs:</strong> je hoort de vaste prijs voordat ik begin.</li>
        <li><strong>Verzekerd:</strong> bedrijfsaansprakelijk verzekerd.</li>
      </ul>
    </div>
  </section>
</Base>
