---
import Base from "../../layouts/Base.astro";
import { SITE, telHref } from "../../site.config.ts";
import { PLAATSEN } from "../../data/plaatsen.ts";
---

<Base
  title={`Werkgebied: dakdekker regio Den Bosch | ${SITE.bedrijfsnaam}`}
  description="Waar ik als dakdekker kom: Den Bosch, Rosmalen, Vught, Oss, Veghel, Waalwijk, Boxtel en meer. Staat je plaats er niet bij? App me, dan zeg ik eerlijk of ik kan komen."
  path="/werkgebied"
>
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow" style="color:#ffb486;">Werkgebied</p>
      <h1>Dakdekker in {SITE.regioOmschrijving}</h1>
      <p class="lead">Ik werk vanuit {SITE.basisplaats} in een straal van ongeveer 45 minuten. Kies hieronder je plaats. Staat je plaats er niet bij? Bel of app gerust, dan zeg ik eerlijk of ik er kan komen.</p>
    </div>
  </section>
  <section class="section">
    <div class="wrap">
      <h2 class="sr-only">Plaatsen in mijn werkgebied</h2>
      <div class="grid grid-3">
        {PLAATSEN.map((p) => (
          <a class="card" href={`/werkgebied/${p.slug}/`}>
            <h3>{p.naam}</h3>
            <p>{p.reistijd ?? "In mijn werkgebied"}</p>
          </a>
        ))}
      </div>
      <p style="margin-top:24px;">
        Staat je plaats er niet tussen? <a href={telHref}>Bel {SITE.telefoonWeergave}</a>, dan kijk ik graag of ik kan komen.
      </p>
    </div>
  </section>
</Base>
