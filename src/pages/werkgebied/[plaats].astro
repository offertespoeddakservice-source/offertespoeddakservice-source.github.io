---
import Base from "../../layouts/Base.astro";
import { SITE, telHref, waHref } from "../../site.config.ts";
import { PLAATSEN } from "../../data/plaatsen.ts";
import { DIENSTEN, getDienst } from "../../data/diensten.ts";
import { MATRIX } from "../../data/matrix.ts";
import { PRIJZEN } from "../../data/prijzen.ts";
import DienstIcon from "../../components/DienstIcon.astro";

export function getStaticPaths() {
  return PLAATSEN.map((p) => ({ params: { plaats: p.slug }, props: { p } }));
}

const { p } = Astro.props;
const path = `/werkgebied/${p.slug}`;
const titel = `Dakdekker in ${p.naam}`;
const metaTitel = `Dakdekker ${p.naam}: lekkage en dakwerk | ${SITE.bedrijfsnaam}`;
const apkPrijs = PRIJZEN.find((r) => r.dienst.startsWith("Dak-APK"))?.prijs ?? "";
const gotenPrijs = PRIJZEN.find((r) => r.dienst === "Dakgoot reinigen")?.prijs ?? "";
const kleinPrijs = PRIJZEN.find((r) => r.dienst.startsWith("Kleine reparatie"))?.prijs ?? "";
const lekPrijs = PRIJZEN.find((r) => r.dienst.startsWith("Daklekkage"))?.prijs ?? "";
// Plaatsen aan de rand van het werkgebied (verweg) krijgen geen spoedbelofte in de omschrijving.
const omschrijving = p.omschrijving ?? (p.verweg
  ? `Dakdekker in ${p.naam} nodig? Dak-APK voor ${apkPrijs}, geplande klussen aan goten, pannen en lood, eerlijke prijs vooraf. Bel of WhatsApp Rens.`
  : `Dakdekker in ${p.naam} nodig? Dak-APK voor ${apkPrijs}, daklekkage vaak dezelfde dag verholpen, eerlijke prijs vooraf. Bel of WhatsApp Rens.`);
const matrixVoorPlaats = MATRIX.filter((c) => c.plaats === p.slug)
  .map((c) => getDienst(c.dienst))
  .filter((d) => d);
const heeftLekPagina = MATRIX.some((c) => c.plaats === p.slug && c.dienst === "daklekkage");

const faq = [
  { v: `Werk je in heel ${p.naam}?`, a: `Ja, ik werk in heel ${p.naam}${p.wijken.length ? `, onder andere ${p.wijken.slice(0, 3).join(", ")}` : ""} en de directe omgeving. ${p.reistijd ? `Het is maar ${p.reistijd}.` : ""}` },
  { v: `Kun je snel langskomen in ${p.naam}?`, a: p.verweg ? `${p.naam} ligt aan de rand van mijn werkgebied (${p.reistijd}). Geplande klussen doe ik hier graag. Bij spoed of lekkage kun je het beste even bellen of WhatsAppen, dan hoor je eerlijk of ik op tijd kan komen.` : p.slug === "den-bosch" ? `Bij spoed of lekkage vaak nog dezelfde dag. Den Bosch is mijn thuisbasis, dus ik ben er zo.` : `Bij spoed of lekkage vaak nog dezelfde dag, want ${p.naam} ligt in mijn vaste werkgebied rond Den Bosch.` },
  { v: `Wat kost een dakdekker in ${p.naam}?`, a: `Goten reinigen ${gotenPrijs} (rijtjeswoning), een kleine reparatie ${kleinPrijs}, een daklekkage meestal ${lekPrijs}. Offerte is altijd gratis en je hoort vooraf de vaste prijs.` },
  ...(p.faq ?? []),
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: `Dakdekker ${p.naam}`,
    description: `Dakdekker in ${p.naam}: goten reinigen, daklekkage, dakreparatie en stormschade.`,
    provider: { "@type": "RoofingContractor", "@id": `${SITE.url}/#bedrijf`, name: SITE.bedrijfsnaam, telephone: `+${SITE.telefoonE164}` },
    areaServed: { "@type": "City", name: p.naam },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faq.map((f) => ({ "@type": "Question", name: f.v, acceptedAnswer: { "@type": "Answer", text: f.a } })),
  },
];
---

<Base
  title={metaTitel.length <= 60 ? metaTitel : `Dakdekker ${p.naam} | ${SITE.bedrijfsnaam}`}
  description={omschrijving}
  path={path}
  schema={schema}
>
  <section class="hero">
    <div class="wrap">
      <div class="topline">
        <span class="eyebrow" style="color:#ffb486; margin:0;">Werkgebied · {p.reistijd ?? SITE.regioOmschrijving}</span>
        <span class="stars"><span class="ster">★★★★★</span> <b>{SITE.reviews.score.toString().replace(".", ",")}</b> <a class="bron" href={SITE.werkspotUrl} target="_blank" rel="noopener">op Werkspot</a></span>
      </div>
      <h1>{titel}: goten, lekkage &amp; reparatie</h1>
      <p class="lead">
        Zoek je een betrouwbare dakdekker in {p.naam}? Je krijgt mij, Rens, aan de lijn.
        Twijfel je over de staat van je dak? Vraag de <a href="/dak-apk/">Dak-APK</a> aan (voor {apkPrijs}) voor een compleet fotorapport.
        Weet je al wat er moet gebeuren? Dan hoor je gelijk een eerlijke, vaste prijs.
      </p>
      <div class="btn-row" style="margin-top:22px;">
        <a class="btn btn--primary" href={telHref}>Bel {SITE.telefoonWeergave}</a>
        <a class="btn btn--wa" href={waHref(`Hallo, ik zoek een dakdekker in ${p.naam}.`)}>WhatsApp Rens</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap prose">
      <h2>Dakdekker in {p.naam}</h2>
      <p>{p.lokaal}</p>
      {p.extra && <p>{p.extra}</p>}
      {p.verweg ? (
        <p>
          Volle goten, losse pannen of een dak dat aan onderhoud toe is: ik help je er netjes vanaf. {`${p.naam} is ${p.reistijd}, dus hier plan ik de klus vooraf met je in.`}
        </p>
      ) : (
      <p>
        Volle goten, een lek na de regen of losse pannen na een storm:
        ik help je er snel en netjes vanaf. {p.reistijd ? `${p.naam} is ${p.reistijd}, ` : ""}
        dus ik ben vaak snel ter plaatse.
      </p>
      )}
      {p.wijken.length > 0 && (
        <p>Ik kom door heel {p.naam}, waaronder {p.wijken.join(", ")}.</p>
      )}
      <h3>Lekt het nu?</h3>
      <p>
        Zet een emmer onder de druppel, maak een foto van de natte plek en ga niet zelf het dak op.
        Op de <a href="/spoed/">spoedpagina</a> staat wat je verder meteen kunt doen.
        {heeftLekPagina
          ? <>Hoe ik een lek in {p.naam} opspoor, lees je bij <a href={`/werkgebied/${p.slug}/daklekkage/`}>daklekkage in {p.naam}</a>.</>
          : <>Hoe ik een lek opspoor zonder onnodig sloopwerk, lees je bij <a href="/diensten/daklekkage/">daklekkage</a>.</>}
        Stuur me de foto via <a href={waHref(`Hallo, mijn dak lekt in ${p.naam}. Ik stuur je een foto.`)}>WhatsApp</a>, dan hoor je eerlijk wat ik zie en wat de beste volgende stap is.
      </p>
    </div>
  </section>

  <section class="section section--soft">
    <div class="wrap">
      <h2>Wat ik in {p.naam} doe</h2>
      <div class="grid grid-3" style="margin-top:18px;">
        {DIENSTEN.filter((d) => !d.verborgen).map((d) => (
          <a class="card" href={`/diensten/${d.slug}/`}>
            <DienstIcon slug={d.slug} />
            <h3>{d.titel}</h3>
            <p>{d.kort}</p>
            {d.vanafPrijs && <span class="price">{d.vanafPrijs}</span>}
          </a>
        ))}
      </div>
    </div>
  </section>

  {matrixVoorPlaats.length > 0 && (
    <section class="section">
      <div class="wrap">
        <h2>Veelgevraagd in {p.naam}</h2>
        <p class="lead">Direct naar de meestgevraagde klussen in {p.naam}:</p>
        <div class="chips">
          {matrixVoorPlaats.map((d) => <a class="chip" href={`/werkgebied/${p.slug}/${d.slug}/`}>{d.titel} in {p.naam}</a>)}
        </div>
      </div>
    </section>
  )}

  <section class="section">
    <div class="wrap">
      <h2>Veelgestelde vragen: {p.naam}</h2>
      <div class="faq" style="margin-top:16px; max-width:760px;">
        {faq.map((f) => (
          <details>
            <summary>{f.v}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--white">
    <div class="wrap">
      <h2>Ook dakdekker in de buurt</h2>
      <div class="chips">
        {PLAATSEN.filter((x) => x.slug !== p.slug).map((x) => <a class="chip" href={`/werkgebied/${x.slug}/`}>{x.naam}</a>)}
        <a class="chip" href="/diensten/">Alle diensten →</a>
      </div>
    </div>
  </section>
</Base>
