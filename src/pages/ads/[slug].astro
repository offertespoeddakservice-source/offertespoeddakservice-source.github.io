---
/**
 * Landingspagina's voor betaalde advertenties: /ads/daklekkage/, /ads/dakgoot/, /ads/dakpannen/, /ads/nokvorsten/,
 * /ads/schoorsteen/, /ads/dak-apk/. Teksten en volgorde staan in src/data/ads.ts (één klus per pagina).
 * Noindex, niet in de sitemap (astro.config.mjs), niet in het menu. Meting in src/layouts/Ads.astro.
 */
import Ads from "../../layouts/Ads.astro";
import AdsFormulier from "../../components/AdsFormulier.astro";
import EchteFotos from "../../components/EchteFotos.astro";
import { SITE, telHref, waHref } from "../../site.config.ts";
import { AD_PAGINAS, AD_REVIEWS } from "../../data/ads.ts";

export function getStaticPaths() {
  return AD_PAGINAS.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}

const { p } = Astro.props;
const score = String(SITE.reviews.score).replace(".", ",");
const stappen = [
  { n: "1", titel: "Vertel kort wat er is", tekst: "Vul het formulier in of stuur een foto via WhatsApp. Een foto vanaf de straat is genoeg." },
  { n: "2", titel: "Je hoort wat het kost", tekst: "Ik neem contact met je op. Binnen 24 uur heb je een vrijblijvende prijsindicatie, vaak dezelfde dag nog. Je zit nergens aan vast." },
  { n: "3", titel: "Ik kom het maken", tekst: "We spreken een dag af. Ik doe het werk zelf. Kleine klus? Dan betaal je als het klaar is, via iDEAL." },
];
---

<Ads
  title={`${p.titel} | ${SITE.bedrijfsnaam}`}
  description={p.sub}
  path={`/ads/${p.slug}`}
  waBericht={p.waBericht}
>
  <!-- KOP: herhaalt de advertentie, knoppen meteen in beeld -->
  <section class="ads-hero">
    <div class="wrap">
      <span class="kicker">{p.kicker}</span>
      <h1>{p.kop}</h1>
      <p class="lead">{p.sub}</p>
      <div class="ads-knoppen">
        <a class="btn btn--wa" href={waHref(p.waBericht)}>{p.waKnop}</a>
        <a class="btn btn--primary" href={telHref}>Bel {SITE.telefoonWeergave}</a>
      </div>
      <div class="hero-checks">
        {p.vinkjes.map((v) => <span><span class="v">✓</span> {v}</span>)}
      </div>
      <p style="margin:18px 0 0; color:#c2d2e3; font-size:.98rem;">Liever niet bellen? <a href="#aanvragen" style="color:#ffb486; font-weight:700;">Vul het korte formulier in</a>, dan neem ik contact met je op.</p>
    </div>
  </section>

  <!-- FORMULIER -->
  <section class="section section--white" style="padding-top:44px; padding-bottom:44px;">
    <div class="wrap split">
      <div>
        <AdsFormulier service={p.service} voorbeeld={p.voorbeeld} />
      </div>
      <aside>
        <div class="card">
          <h3>{p.doeKop}</h3>
          <ul class="checks" style="margin-top:10px; margin-bottom:0;">
            {p.doe.map((d) => <li>{d}</li>)}
          </ul>
          {p.nietDoe && <p style="margin-top:14px; font-size:.95rem;">{p.nietDoe}</p>}
        </div>
        <div class="ads-rens" style="margin-top:16px;">
          {SITE.overFoto ? <img src={SITE.overFoto} alt="Rens, de dakdekker die zelf komt" width="720" height="925" loading="lazy" /> : null}
          <div>
            <h2>Dit is Rens. Hij komt zelf.</h2>
            <p>Geen callcenter, geen doorverkopen. Ik kom kijken, doe het werk zelf en je hebt één aanspreekpunt. <a href={SITE.werkspotUrl} target="_blank" rel="noopener">{score} op Werkspot</a>.</p>
          </div>
        </div>
      </aside>
    </div>
  </section>

  <!-- ZO WERKT HET -->
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Zo werkt het</p>
      <h2>In 3 stappen geregeld</h2>
      <div class="stappen ads-stappen">
        {stappen.map((s) => (
          <div class="stap">
            <div class="n">{s.n}</div>
            <h3>{s.titel}</h3>
            <p>{s.tekst}</p>
          </div>
        ))}
      </div>
      <div class="ads-knoppen" style="margin-top:26px;">
        <a class="btn btn--wa" href={waHref(p.waBericht)}>{p.waKnop}</a>
        <a class="btn btn--primary" href={telHref}>Bel {SITE.telefoonWeergave}</a>
      </div>
    </div>
  </section>

  <!-- GARANTIE -->
  <section class="section section--white" style="padding-top:40px; padding-bottom:40px;">
    <div class="wrap">
      <div class="ads-garantie">
        <p class="eyebrow" style="margin-bottom:6px;">Garantie</p>
        <h2>1 jaar garantie op reparatie, 2 jaar op vervangen</h2>
        <p>Geen kleine lettertjes. Komt het probleem binnen die tijd terug, dan kom ik het kosteloos opnieuw maken. Verzekerd en ingeschreven bij de KvK ({SITE.kvk}).</p>
      </div>
    </div>
  </section>

  <!-- ECHTE FOTO'S (alleen foto's die Rens zelf goedkeurde; niets = blok verborgen) -->
  <EchteFotos soort={p.fotoSoort} titel={p.fotoTitel} max={3} />

  <!-- REVIEWS (letterlijk van de homepage) -->
  <section class="section section--navy" style="text-align:center;">
    <div class="wrap">
      <p class="eyebrow" style="color:#ffb486;">Wat klanten zeggen</p>
      <div class="stars" style="justify-content:center; margin-bottom:6px;">
        <span class="ster" style="font-size:1.4rem;">★★★★★</span> <b style="font-size:1.6rem;">{score}</b> <a class="bron" style="font-size:1rem;" href={SITE.werkspotUrl} target="_blank" rel="noopener">op Werkspot (13 reviews)</a>
      </div>
      <div class="reviewgrid">
        {AD_REVIEWS.map((r) => (
          <figure class="reviewkaart" style="margin:0;">
            <span class="rster" aria-label="5 van 5 sterren">★★★★★</span>
            <blockquote>„{r.tekst}"</blockquote>
            <figcaption>{r.wie}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- KORTE VRAGEN -->
  <section class="section">
    <div class="wrap" style="max-width:820px;">
      <h2>Veelgestelde vragen</h2>
      <div class="faq" style="margin-top:18px;">
        {p.vragen.map((f) => (
          <details>
            <summary>{f.v}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
      <div class="ads-knoppen" style="margin-top:26px;">
        <a class="btn btn--wa" href={waHref(p.waBericht)}>{p.waKnop}</a>
        <a class="btn btn--primary" href={telHref}>Bel {SITE.telefoonWeergave}</a>
      </div>
    </div>
  </section>
</Ads>
