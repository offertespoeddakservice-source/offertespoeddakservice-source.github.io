---
/**
 * Landingspagina's voor betaalde advertenties: /ads/daklekkage/, /ads/dakgoot/, /ads/dakpannen/, /ads/nokvorsten/,
 * /ads/goot-solderen/, /ads/schoorsteen/, /ads/dak-apk/. Teksten en volgorde staan in src/data/ads.ts (één klus per pagina).
 * 29-10-2026: bovenaan staat de quiz (src/components/Quiz.astro) met de klus al ingevuld, in plaats van het oude formulier.
 * Noindex, niet in de sitemap (astro.config.mjs), niet in het menu. Meting in src/layouts/Ads.astro.
 */
import Ads from "../../layouts/Ads.astro";
import Quiz from "../../components/Quiz.astro";
import { QUIZ_ZIN } from "../../data/quiz.ts";
import EchteFotos from "../../components/EchteFotos.astro";
import { SITE, telHref, waHref } from "../../site.config.ts";
import { AD_PAGINAS, AD_REVIEWS } from "../../data/ads.ts";

export function getStaticPaths() {
  return AD_PAGINAS.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}

const { p } = Astro.props;
const score = String(SITE.reviews.score).replace(".", ",");
const stappen = [
  { n: "1", titel: "Beantwoord 5 korte vragen", tekst: "Bovenaan deze pagina. Met een foto erbij, als je wilt. Een foto vanaf de straat is genoeg." },
  { n: "2", titel: "Je hoort wat het kost", tekst: "Meestal staat je prijsindicatie binnen 10 minuten op WhatsApp. Is het wat lastiger, dan kijken we er persoonlijk naar en hoor je binnen 24 uur van ons. Je zit nergens aan vast." },
  { n: "3", titel: "We komen het maken", tekst: "We spreken een dag af. Ik of een collega doet het werk, ik blijf je aanspreekpunt. Kleine klus? Dan betaal je als het klaar is, via iDEAL." },
];
---

<Ads
  title={`${p.titel} | ${SITE.bedrijfsnaam}`}
  description={p.sub}
  path={`/ads/${p.slug}`}
  waBericht={p.waBericht}
>
  <!-- KOP: herhaalt de advertentie, knoppen meteen in beeld -->
  <section class="ads-hero">
    <div class="wrap">
      <span class="kicker">{p.kicker}</span>
      <h1>{p.kop}</h1>
      <p class="lead">{QUIZ_ZIN}</p>
      <Quiz klus={p.quizKlus} />
      <p style="margin:16px 0 0; color:#c2d2e3; font-size:.98rem;">Liever zelf een foto sturen of bellen? <a href={waHref(p.waBericht)} style="color:#ffb486; font-weight:700;">{p.waKnop}</a> of bel <a href={telHref} style="color:#ffb486; font-weight:700;">{SITE.telefoonWeergave}</a>.</p>
      <div class="hero-checks">
        {p.vinkjes.map((v) => <span><span class="v">✓</span> {v}</span>)}
      </div>
    </div>
  </section>

  <!-- WAT IK DOE -->
  <section class="section section--white" style="padding-top:44px; padding-bottom:44px;">
    <div class="wrap">
      <p class="lead" style="max-width:760px;">{p.sub}</p>
      <div class="ads-doe">
        <div class="card">
          <h3>{p.doeKop}</h3>
          <ul class="checks" style="margin-top:10px; margin-bottom:0;">
            {p.doe.map((d) => <li>{d}</li>)}
          </ul>
          {p.nietDoe && <p style="margin-top:14px; font-size:.95rem;">{p.nietDoe}</p>}
        </div>
        <div class="ads-rens" style="margin-top:16px;">
          {SITE.overFoto ? <img src={SITE.overFoto} alt="Rens van Spoed Dak Service" width="720" height="925" loading="lazy" /> : null}
          <div>
            <h2>Dit is Rens. Eén aanspreekpunt.</h2>
            <p>Geen callcenter. Ik plan je klus, de prijs staat vooraf vast en je houdt één aanspreekpunt, ook als een collega het werk doet. <a href={SITE.werkspotUrl} target="_blank" rel="noopener">{score} op Werkspot</a>.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ZO WERKT HET -->
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Zo werkt het</p>
      <h2>In 3 stappen geregeld</h2>
      <div class="stappen ads-stappen">
        {stappen.map((s) => (
          <div class="stap">
            <div class="n">{s.n}</div>
            <h3>{s.titel}</h3>
            <p>{s.tekst}</p>
          </div>
        ))}
      </div>
      <div class="ads-knoppen" style="margin-top:26px;">
        <a class="btn btn--primary" href="#quiz">Naar de 5 vragen</a>
        <a class="btn btn--wa" href={waHref(p.waBericht)}>{p.waKnop}</a>
      </div>
    </div>
  </section>

  <!-- GARANTIE -->
  <section class="section section--white" style="padding-top:40px; padding-bottom:40px;">
    <div class="wrap">
      <div class="ads-garantie">
        <p class="eyebrow" style="margin-bottom:6px;">Garantie</p>
        <h2>1 jaar garantie op reparatie, 2 jaar op vervangen</h2>
        <p>Geen kleine lettertjes. Komt het probleem binnen die tijd terug, dan maken we het kosteloos opnieuw. Verzekerd en ingeschreven bij de KvK ({SITE.kvk}).</p>
        {p.garantieNoot && <p style="margin-top:8px;">{p.garantieNoot}</p>}
      </div>
    </div>
  </section>

  <!-- ECHTE FOTO'S (alleen foto's die Rens zelf goedkeurde; geen fotoSoort of geen passende foto = geen blok) -->
  {p.fotoSoort && <EchteFotos soort={p.fotoSoort} titel={p.fotoTitel} max={p.fotoMax ?? 3} />}

  <!-- REVIEWS (letterlijk van de homepage) -->
  <section class="section section--navy" style="text-align:center;">
    <div class="wrap">
      <p class="eyebrow" style="color:#ffb486;">Wat klanten zeggen</p>
      <div class="stars" style="justify-content:center; margin-bottom:6px;">
        <span class="ster" style="font-size:1.4rem;">★★★★★</span> <b style="font-size:1.6rem;">{score}</b> <a class="bron" style="font-size:1rem;" href={SITE.werkspotUrl} target="_blank" rel="noopener">op Werkspot ({SITE.reviews.werkspotAantal} reviews)</a>
      </div>
      <div class="reviewgrid">
        {AD_REVIEWS.map((r) => (
          <figure class="reviewkaart" style="margin:0;">
            <span class="rster" aria-label="5 van 5 sterren">★★★★★</span>
            <blockquote>„{r.tekst}"</blockquote>
            <figcaption>{r.wie}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- KORTE VRAGEN -->
  <section class="section">
    <div class="wrap" style="max-width:820px;">
      <h2>Veelgestelde vragen</h2>
      <div class="faq" style="margin-top:18px;">
        {p.vragen.map((f) => (
          <details>
            <summary>{f.v}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
      <div class="ads-knoppen" style="margin-top:26px;">
        <a class="btn btn--primary" href="#quiz">Naar de 5 vragen</a>
        <a class="btn btn--wa" href={waHref(p.waBericht)}>{p.waKnop}</a>
      </div>
    </div>
  </section>
</Ads>
