---
import Base from "../layouts/Base.astro";
import { SITE, telHref, waHref } from "../site.config.ts";
import { DIENSTEN } from "../data/diensten.ts";
import { PLAATSEN } from "../data/plaatsen.ts";
import DienstIcon from "../components/DienstIcon.astro";
import { ARTIKELEN } from "../data/artikelen.ts";

const score = SITE.reviews.score.toString().replace(".", ",");
const googleReviewLink = SITE.reviewLink && !SITE.reviewLink.includes("JOUW_PLACE_ID") ? SITE.reviewLink : null;

const faq = [
  { v: "Wat kost het om iemand te laten komen?", a: "Wil je weten hoe je dak ervoor staat? Dat doe ik via de Dak-APK: binnen een dagdeel een compleet keuringsrapport met foto's, voor €49. Weet je al wat er moet gebeuren — bijvoorbeeld goten reinigen? Dan hoor je gewoon de vaste prijs vooraf." },
  { v: "Hoe snel kun je komen?", a: "Bij spoed en lekkage vaak nog dezelfde dag in de regio Den Bosch. Bel of WhatsApp me, dan hoor je meteen wat kan." },
  { v: "Werk je ook bij mij in de buurt?", a: `Ik werk in ${SITE.regioOmschrijving}. Staat je plaats er niet bij? Bel gerust, vaak kan ik er toch bij.` },
  { v: "Krijg ik garantie?", a: "Ja, op het uitgevoerde werk krijg je garantie. Ik leg vooraf duidelijk uit wat ik doe en wat het kost." },
];
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((f) => ({ "@type": "Question", name: f.v, acceptedAnswer: { "@type": "Answer", text: f.a } })),
};
---

<Base
  title={`Dakdekker regio Den Bosch | ${SITE.bedrijfsnaam}`}
  description="Vakkundig dakwerk door één vaste man in de regio Den Bosch. Dak-APK voor €49, daklekkage vaak dezelfde dag, eerlijke prijs vooraf."
  path="/"
  schema={faqSchema}
>
  <!-- SPOEDBALK: acute lekkage direct naar bellen -->
  <div class="spoed-bar">
    <div class="wrap">
      <span>Lekkage of stormschade <strong>nú</strong>? Dag en nacht bereikbaar.</span>
      <a class="tel" href={waHref("Hoi Rens, ik heb NU een lekkage/schade aan mijn dak. Ik stuur zo een foto mee.")}>App direct een foto</a>
      <a class="meer" href={telHref}>of bel {SITE.telefoonWeergave}</a>
      <a class="meer" href="/spoed">Eerste hulp bij een lek →</a>
    </div>
  </div>

  <!-- HERO -->
  <section class="hero">
    <div class="wrap">
      <div class="topline">
        <span class="kicker">Dakdekker · {SITE.regioOmschrijving}</span>
        <span class="stars"><span class="ster">★★★★★</span> <b>{score}</b> <a class="bron" href={SITE.werkspotUrl} target="_blank" rel="noopener">op Werkspot</a></span>
      </div>
      <h1>Vakkundig dakwerk<br />door één vaste man</h1>
      <p class="lead">
        Geen callcenter, geen verrassingen achteraf. Je krijgt mij — Rens — aan de lijn,
        ik kom langs, en je hoort eerlijk wat er nodig is. Vaste prijs vooraf.
      </p>
      <div class="pricehook">
        <span class="van">Dak-APK<br />keuring</span>
        <span class="big">€49</span>
        <span class="per">compleet fotorapport<br />binnen een dagdeel</span>
      </div>
      <p style="margin:14px 0 0; color:#d3e0ec; font-size:1.02rem; max-width:660px;">
        <strong style="color:#fff;">Een offerte is altijd gratis.</strong> Weet je al wat er speelt? Bel of stuur een foto via WhatsApp, dan krijg je gewoon een prijs — géén €49.
        De <strong style="color:#fff;">Dak-APK (€49) is optioneel</strong>: een complete keuring mét fotorapport, handig als je wilt weten hoe je hele dak ervoor staat.
      </p>
      <div class="hero-checks">
        <span><span class="v">✓</span> Eerlijk advies, geen verkooppraatje</span>
        <span><span class="v">✓</span> Vaste prijs, geen verrassingen</span>
        <span><span class="v">✓</span> Garantie op het werk</span>
        <span><span class="v">✓</span> Vaak dezelfde dag bij spoed</span>
      </div>
      <div class="btn-row">
        <a class="btn btn--wa" href={waHref()}>WhatsApp Rens</a>
        <a class="btn btn--primary" href={telHref}>Bel {SITE.telefoonWeergave}</a>
        <a class="btn btn--ghost" href="/dak-apk">Bekijk de Dak-APK</a>
      </div>
    </div>
  </section>

  <!-- DIENSTEN -->
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Wat ik doe</p>
      <h2>Voor je hele dak één aanspreekpunt</h2>
      <p class="lead">Van een verstopte goot tot een lekkend dak — snel, netjes, en met een eerlijke prijs vooraf.</p>
      <div class="grid grid-3" style="margin-top:26px;">
        {DIENSTEN.map((d, i) => (
          <a class="card" href={`/diensten/${d.slug}`}>
            <DienstIcon slug={d.slug} />
            <h3 style="margin-top:6px;">{d.titel}</h3>
            <p>{d.kort}</p>
            {d.vanafPrijs && <span class="price">{d.vanafPrijs}</span>}
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- WAAROM RENS -->
  <section class="section section--white">
    <div class="wrap">
      <p class="eyebrow">Waarom mij</p>
      <h2>Een echte dakdekker, geen tussenpersoon</h2>
      <div class="grid grid-3" style="margin-top:22px;">
        <div class="card">
          <h3>Je krijgt mij</h3>
          <p>Eén vast gezicht van offerte tot oplevering. Korte lijnen — gewoon mijn nummer, geen callcenter.</p>
        </div>
        <div class="card">
          <h3>Eerlijke prijs vooraf</h3>
          <p>Vaste prijs voordat ik aan een klus begin, geen verrassingen achteraf. Wil je eerst weten hoe je dak ervoor staat? Dat kan via de Dak-APK, voor €49.</p>
        </div>
        <div class="card">
          <h3>Uit de regio</h3>
          <p>Ik werk in {SITE.regioOmschrijving} — vaak ben ik al bij jou in de buurt.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- RICHTPRIJZEN (adverteer de prijzen, laat mensen snel kiezen) -->
  <section class="section section--soft">
    <div class="wrap">
      <p class="eyebrow">Wat kost het?</p>
      <h2>Richtprijzen — je weet meteen waar je aan toe bent</h2>
      <p class="lead">Geen offerte-gedoe of verrassingen achteraf. Kies wat je nodig hebt; de vaste prijs hoor je vóór ik begin.</p>

      <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(240px,1fr)); gap:16px; margin-top:26px;">
        <a href="/dak-apk" style="text-decoration:none; background:var(--navy); border-radius:14px; padding:22px; display:block;">
          <span style="display:block; font-family:var(--font-display); font-weight:800; text-transform:uppercase; letter-spacing:.03em; color:#ffb486; font-size:.85rem;">Dak-APK keuring · optioneel</span>
          <strong style="display:block; font-family:var(--font-display); color:#fff; font-size:2.4rem; line-height:1; margin:8px 0;">€49</strong>
          <span style="display:block; color:#c2d2e3; font-size:.95rem;">Alleen als je een volledige keuring mét fotorapport wilt. Bekend probleem? Vraag gewoon een gratis offerte.</span>
        </a>

        <a href="/diensten/goten-reinigen" style="text-decoration:none; background:#fff; border:1px solid var(--line); border-radius:14px; padding:22px; display:block;">
          <span style="display:block; font-family:var(--font-display); font-weight:800; text-transform:uppercase; letter-spacing:.03em; color:var(--navy); font-size:.85rem;">Dakgoot reinigen</span>
          <strong style="display:block; font-family:var(--font-display); color:var(--orange); font-size:2.4rem; line-height:1; margin:8px 0;">€99 <span style="font-size:1rem;">all-in</span></strong>
          <span style="display:block; color:var(--muted); font-size:.95rem;">Beide goten leeg, afvoer doorgespoeld. Rijtjeswoning.</span>
        </a>

        <a href="/diensten/schoorsteen-vegen" style="text-decoration:none; background:#fff; border:1px solid var(--line); border-radius:14px; padding:22px; display:block;">
          <span style="display:block; font-family:var(--font-display); font-weight:800; text-transform:uppercase; letter-spacing:.03em; color:var(--navy); font-size:.85rem;">Schoorsteen vegen</span>
          <strong style="display:block; font-family:var(--font-display); color:var(--orange); font-size:2.4rem; line-height:1; margin:8px 0;">€70</strong>
          <span style="display:block; color:var(--muted); font-size:.95rem;">Hele schoorsteen, netjes, zonder roetzooi in huis.</span>
        </a>

        <a href="/diensten/dakreparatie" style="text-decoration:none; background:#fff; border:1px solid var(--line); border-radius:14px; padding:22px; display:block;">
          <span style="display:block; font-family:var(--font-display); font-weight:800; text-transform:uppercase; letter-spacing:.03em; color:var(--navy); font-size:.85rem;">Kleine reparatie</span>
          <strong style="display:block; font-family:var(--font-display); color:var(--orange); font-size:2.4rem; line-height:1; margin:8px 0;">€100<span style="font-size:1.3rem;">–€250</span></strong>
          <span style="display:block; color:var(--muted); font-size:.95rem;">Losse pan of nokvorst — kort klusje, vaste prijs vooraf.</span>
        </a>

        <a href="/diensten/daklekkage" style="text-decoration:none; background:#fff; border:1px solid var(--line); border-radius:14px; padding:22px; display:block;">
          <span style="display:block; font-family:var(--font-display); font-weight:800; text-transform:uppercase; letter-spacing:.03em; color:var(--navy); font-size:.85rem;">Daklekkage</span>
          <strong style="display:block; font-family:var(--font-display); color:var(--orange); font-size:2.4rem; line-height:1; margin:8px 0;">€200<span style="font-size:1.3rem;">–€500</span></strong>
          <span style="display:block; color:var(--muted); font-size:.95rem;">Eén lek opsporen en dichten, incl. materiaal. Ook bij spoed.</span>
        </a>

        <a href="/diensten/dak-reinigen" style="text-decoration:none; background:#fff; border:1px solid var(--line); border-radius:14px; padding:22px; display:block;">
          <span style="display:block; font-family:var(--font-display); font-weight:800; text-transform:uppercase; letter-spacing:.03em; color:var(--navy); font-size:.85rem;">Dak reinigen / ontmossen</span>
          <strong style="display:block; font-family:var(--font-display); color:var(--orange); font-size:2.4rem; line-height:1; margin:8px 0;">€8<span style="font-size:1.3rem;">–€15 p/m²</span></strong>
          <span style="display:block; color:var(--muted); font-size:.95rem;">Mos en aanslag eraf, zodat je dak weer ademt.</span>
        </a>
      </div>

      <div class="btn-row" style="margin-top:24px;">
        <a class="btn btn--wa" href={waHref("Hoi Rens, kun je me een prijsindicatie geven?")}>App voor jouw prijs</a>
        <a class="btn btn--primary" href={telHref}>Bel {SITE.telefoonWeergave}</a>
        <a class="btn btn--outline" href="/prijzen">Alle richtprijzen</a>
      </div>
    </div>
  </section>

  <!-- SOCIAL PROOF / REVIEWS -->
  <section class="section section--navy" style="text-align:center;">
    <div class="wrap">
      <p class="eyebrow" style="color:#ffb486;">Wat klanten zeggen</p>
      <div class="stars" style="justify-content:center; margin-bottom:6px;">
        <span class="ster" style="font-size:1.6rem;">★★★★★</span> <b style="font-size:1.9rem;">{score}</b> <a class="bron" style="font-size:1rem;" href={SITE.werkspotUrl} target="_blank" rel="noopener">op Werkspot (13 reviews)</a>
      </div>
      <h2>Mensen kiezen voor een échte vakman uit de buurt</h2>
      <p class="lead" style="margin:0 auto 8px; color:#c2d2e3;">
        Geen callcenter, wél iemand die terugbelt en eerlijk zegt wat nodig is. Dit schreven klanten op Werkspot:
      </p>
      <div class="reviewgrid">
        <figure class="reviewkaart" style="margin:0;">
          <span class="rster" aria-label="5 van 5 sterren">★★★★★</span>
          <blockquote>„Dakgoten keurig netjes schoongemaakt zonder de rommel uit de goten op het terras of in de tuin te morsen. Aanrader!"</blockquote>
          <figcaption>Ard-Jan, Tiel · goten reinigen</figcaption>
        </figure>
        <figure class="reviewkaart" style="margin:0;">
          <span class="rster" aria-label="5 van 5 sterren">★★★★★</span>
          <blockquote>„Snel en mooi dak geplaatst voor een hele nette prijs. Blij mee!"</blockquote>
          <figcaption>F. Spolders, Zoetermeer · dakreparatie</figcaption>
        </figure>
        <figure class="reviewkaart" style="margin:0;">
          <span class="rster" aria-label="5 van 5 sterren">★★★★★</span>
          <blockquote>„Prima werk geleverd. Was flexibel in het plannen, dacht mee en kwam met oplossingen."</blockquote>
          <figcaption>Roos, Oosterbeek · regenpijp vervangen</figcaption>
        </figure>
      </div>
      <div class="btn-row" style="justify-content:center;">
        <a class="btn btn--ghost" href={SITE.werkspotUrl} target="_blank" rel="noopener">Lees alle 13 reviews op Werkspot</a>
        {googleReviewLink && <a class="btn btn--primary" href={googleReviewLink}>Plaats een review op Google</a>}
      </div>
      <p style="margin:16px auto 0; color:#9fb4c9; font-size:.92rem; max-width:60ch;">
        Ben je na de klus tevreden? Een korte review op Google helpt mij enorm — én helpt je buren een betrouwbare dakdekker te vinden.
      </p>
    </div>
  </section>

  <!-- ZO WERKT HET -->
  <section class="section section--white">
    <div class="wrap">
      <p class="eyebrow">Zo werkt het</p>
      <h2>Van belletje tot klaar dak — in 4 stappen</h2>
      <div class="stappen">
        <div class="stap"><div class="n">1</div><h3>Bel of app</h3><p>Je krijgt mij direct aan de lijn. Vertel kort wat er speelt.</p></div>
        <div class="stap"><div class="n">2</div><h3>Dak-APK of meteen aan de slag</h3><p>Twijfel je? Ik kom langs met de Dak-APK (€49) en je krijgt een compleet rapport. Weet je het al? Dan spreken we gelijk de vaste prijs af.</p></div>
        <div class="stap"><div class="n">3</div><h3>Vaste prijs vooraf</h3><p>Je hoort de prijs vóór ik begin. Geen voorrijkosten, geen verrassingen.</p></div>
        <div class="stap"><div class="n">4</div><h3>Netjes gedaan</h3><p>Ik voer het werk uit, ruim op en geef garantie op wat ik doe.</p></div>
      </div>
    </div>
  </section>

  <!-- WERKGEBIED -->
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Werkgebied</p>
      <h2>In welke plaatsen ik kom</h2>
      <p class="lead">Klik op je plaats voor meer info — of bel gerust als je plaats er niet bij staat.</p>
      <div class="chips">
        {PLAATSEN.map((p) => <a class="chip" href={`/werkgebied/${p.slug}`}>{p.naam}</a>)}
        <a class="chip" href="/werkgebied">Hele werkgebied →</a>
      </div>
    </div>
  </section>

  <!-- KENNISBANK -->
  <section class="section section--white">
    <div class="wrap">
      <p class="eyebrow">Kennisbank</p>
      <h2>Daktips & eerlijke uitleg</h2>
      <p class="lead">Zo weet je wat er speelt voordat je belt — zonder verkooppraatje.</p>
      <div class="grid grid-3" style="margin-top:22px;">
        {ARTIKELEN.map((a) => (
          <a class="card" href={`/kennisbank/${a.slug}`}>
            <h3>{a.titel}</h3>
            <p>{a.metaDescription}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Veelgestelde vragen</p>
      <h2>Goed om te weten</h2>
      <div class="faq" style="margin-top:18px; max-width:780px;">
        {faq.map((f) => (
          <details>
            <summary>{f.v}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</Base>
