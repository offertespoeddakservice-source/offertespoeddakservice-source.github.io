---
import Base from "../layouts/Base.astro";
import { SITE, telHref, waHref } from "../site.config.ts";
import { DIENSTEN } from "../data/diensten.ts";
import { PLAATSEN } from "../data/plaatsen.ts";
import DienstIcon from "../components/DienstIcon.astro";
import EchteFotos from "../components/EchteFotos.astro";
import { ARTIKELEN } from "../data/artikelen.ts";
import { PRIJZEN, prijsVan, BTW_REGEL } from "../data/prijzen.ts";

const score = SITE.reviews.score.toString().replace(".", ",");
const googleReviewLink = SITE.reviewLink && !SITE.reviewLink.includes("JOUW_PLACE_ID") ? SITE.reviewLink : null;
const apkPrijs = prijsVan("apk");
// Richtprijzen op de homepage: een paar kleine klussen met een vanaf-bedrag, de rest staat op /prijzen (alles incl. btw)
const HOME_PRIJZEN = ["goot_reinigen", "dakpan", "platdak", "daklekkage", "nok_repareren"].map((k) => PRIJZEN.find((r) => r.sleutel === k)!);
const FOTO_WA = waHref("Hallo, ik wil graag weten wat het kost. Ik stuur een foto mee.");
// 14-11-2026: kachelpijp en aanbouw (meeste kliks en bezoeken) in plaats van opsporen en schoorsteen (0 kliks); die blijven in 'Alle uitleg op een rij'.
const HOME_UITLEG = ["daklek-tijdelijk-dichten", "dak-lekt-bij-harde-wind", "water-achter-dakgoot", "lekkage-bij-dakdoorvoer", "lekkage-bij-kachelpijp", "lekkage-bij-aanbouw", "dakraam-lekt", "dakgoot-lekt", "stormschade-eerste-hulp"];
const zichtbareArtikelen = ARTIKELEN.filter((a) => !a.verborgen);
const uitgelicht = HOME_UITLEG.map((s) => zichtbareArtikelen.find((a) => a.slug === s)).filter((a) => a) as typeof ARTIKELEN;
// 19-11-2026: een gewone regel 'Nu in de winter' met links naar de seizoensuitleg. Alleen artikelen die bestaan en zichtbaar zijn.
const WINTER_UITLEG = [
  { slug: "kerstverlichting-dakgoot", tekst: "lichtjes aan je dakgoot" },
  { slug: "vuurwerk-schade-dak", tekst: "vuurwerkschade aan je dak" },
  { slug: "dak-lekt-bij-sneeuw-of-vorst", tekst: "lekkage bij sneeuw of vorst" },
  { slug: "ijspegels-aan-dakgoot", tekst: "ijspegels aan je goot" },
  { slug: "storm-op-komst-dak", tekst: "storm op komst" },
  { slug: "dak-repareren-in-de-winter", tekst: "je dak repareren in de winter" },
].filter((w) => zichtbareArtikelen.some((a) => a.slug === w.slug));
// 24-11-2026 ronde 1: een gewone regel 'Na een storm' met links naar de stormuitleg. Alleen artikelen die bestaan en zichtbaar zijn.
const STORM_UITLEG = [
  { slug: "wachten-op-dakdekker-na-storm", tekst: "wachten op de dakdekker" },
  { slug: "dakpan-in-tuin-gevonden", tekst: "een dakpan in je tuin" },
  { slug: "dakgoot-losgeraakt", tekst: "een losgeraakte goot" },
  { slug: "plat-dak-losgewaaid-na-storm", tekst: "losgewaaide dakbedekking" },
  { slug: "schade-expert-dak", tekst: "de schade-expert van je verzekeraar" },
].filter((w) => zichtbareArtikelen.some((a) => a.slug === w.slug));

const faq = [
  { v: "Wat kost het om iemand te laten komen?", a: `Wil je weten hoe je dak ervoor staat? Dat doe ik via de Dak-APK: binnen een dagdeel een compleet keuringsrapport met foto's, voor ${apkPrijs}. Weet je al wat er moet gebeuren, bijvoorbeeld goten reinigen? Dan hoor je gewoon de vaste prijs vooraf.` },
  { v: "Hoe snel kun je komen?", a: "Bij spoed en lekkage vaak nog dezelfde dag in de regio Den Bosch. Bel of WhatsApp me, dan hoor je meteen wat kan." },
  { v: "Ben je ook 's nachts en in het weekend bereikbaar?", a: "Ja. Je kunt me dag en nacht bellen of appen, ook in het weekend. Bij een lek of stormschade zeg ik je meteen wat je zelf kunt doen en wanneer ik kan komen. Wat het kost, hoor je vooraf. Kan het veilig wachten tot een werkdag, dan zeg ik dat eerlijk." },
  { v: "Mijn dak lekt nu. Wat moet ik eerst doen?", a: "Zet een emmer onder de druppel, haal spullen weg die nat kunnen worden en ga niet zelf het dak op, zeker niet bij regen of wind. Maak een foto van de natte plek en stuur die via WhatsApp, of bel me. Dan hoor je wat je nu zelf kunt doen en wanneer ik kan komen. Op de spoedpagina staat wat je verder meteen kunt doen." },
  { v: "Werk je ook bij mij in de buurt?", a: "Ik werk vanuit Den Bosch, vooral in Brabant en in de steden eromheen, zoals Tilburg, Breda, Eindhoven, Helmond en Nijmegen. Woon je verder weg? Bel of app gerust met een foto van je dak. Dan zeg ik eerlijk of ik kan komen, en een klus verder weg plan ik vooraf met je in." },
  { v: "Krijg ik garantie?", a: "Ja. Op een reparatie krijg je 1 jaar garantie en op vervangen 2 jaar, zonder kleine lettertjes. Is er iets mee, dan kom ik gratis terug om het te verhelpen." },
  { v: "Wat stuur ik mee als ik een prijs wil weten?", a: "Een paar foto's helpen het meest. Maak er een van je dak of je goot vanaf de straat, en als het lekt ook een van de natte plek binnen. Zet erbij in welke plaats je woont en wat je ziet, bijvoorbeeld een losse pan, een goot die overloopt of een plek die na regen nat wordt. Stuur het via WhatsApp. Vaak kan ik dan al zeggen wat het ongeveer wordt, en voordat ik begin hoor je de vaste prijs." },
  { v: "Ik heb geen WhatsApp. Hoe stuur ik je een foto?", a: `Dat kan ook per e-mail, naar ${SITE.email}. Zet in je mail je adres, je telefoonnummer en wat je ziet, bijvoorbeeld een natte plek op het plafond of een pan die scheef ligt. Een foto van je dak vanaf de straat en een van de natte plek binnen helpen het meest. Lukt een foto niet, bel me dan op ${SITE.telefoonWeergave} en vertel wat er aan de hand is. Lekt het nu, bel dan liever meteen, want een mail zie ik niet altijd direct.` },
  { v: "Kom je ook voor één losse pan of een andere kleine klus?", a: `In de regio Den Bosch wel. Ook voor één kapotte of verschoven pan, een nokvorst die scheef ligt of een stukje lood dat loszit, kom ik gewoon. Een paar losse pannen vervangen of een nokvorst weer vastzetten kost ${prijsVan("dakpan")} incl. btw. Laat het liever maken zolang het nog klein is, want onder één kapotte pan worden de panlatten bij elke bui nat. Stuur een foto van je dak vanaf de straat via WhatsApp, dan hoor je vooraf de vaste prijs.` },
  { v: "Werk je ook voor een VvE, een verhuurder of een winkelpand?", a: "Ja. Ook als het dak niet van één bewoner is, kom ik kijken, bijvoorbeeld bij een rij huurwoningen, een klein appartementengebouw of een winkel met een woning erboven. De klus en de prijs spreek ik vooraf af met degene die de opdracht geeft, zoals het bestuur van de VvE, de beheerder of de verhuurder. Ik maak foto's van wat ik aantref en van wat ik heb gedaan, zodat iedereen kan zien wat er is gebeurd. Huur je zelf en lekt het, meld het dan eerst bij je verhuurder." },
  { v: "Moet ik thuis zijn als je komt?", a: "Dat hangt af van de klus. Ligt er een pan of nokvorst los en kan ik er vanaf de stoep of via een tuinpoort bij, dan kan ik dat ook doen als jij aan het werk bent, zolang we de prijs vooraf hebben afgesproken. Stuur dan vooraf een foto van je dak en zeg waar ik mijn ladder kwijt kan. Lekt het binnen, of wil je dat ik op zolder kijk waar het water vandaan komt, dan is het fijn als er iemand thuis is. Dat spreken we samen af." },
  { v: "Kun je in de winter ook aan mijn dak werken?", a: "Ja, het meeste werk kan gewoon in de winter, op een droge dag zonder ijs of sneeuw op het dak. Pannen terugleggen of vervangen lukt ook als het koud is. Lood, kit en dakbedekking hebben een droge ondergrond nodig, en dakmortel voor de nok en een coating in de goot ook een dag zonder vorst. Zulk werk plan ik dan op zo'n dag. Ligt er sneeuw of ijs op het dak, dan wacht ik tot het veilig is. Druppelt het nu binnen, dan zorg ik eerst dat het droog blijft, en volgt de nette reparatie op een geschikte dag. Wat het kost, hoor je vooraf." },
  { v: "Hoe betaal ik?", a: "Een kleine klus, zoals een paar losse pannen of een goot leegmaken, betaal je als hij klaar is, via iDEAL. Bij groter werk hoor je vooraf wat het kost en spreken we samen af hoe en wanneer je betaalt. Je krijgt een rekening met wat er is gedaan, die je zo nodig ook naar je verzekeraar kunt sturen." },
  { v: "Kan ik foto's zien van klussen die je hebt gedaan?", a: "Ja. Op de pagina met foto's van mijn werk staan foto's die ik zelf op het dak maakte: pannen en nokvorsten, lood rond de schoorsteen, dakgoten, platte daken en vogelwering. Geen stockfoto's. Wat klanten over mij schreven, lees je op Werkspot." },
  { v: "Welke dakdekker in Den Bosch kan ik bellen voor lekkage of een losse dakpan?", a: `Spoed Dak Service: dat ben ik, Rens, dakdekker in 's-Hertogenbosch. Ik werk door de hele stad en in de plaatsen eromheen, zoals Rosmalen, Empel, Engelen, Nuland en Vught, en verder in Brabant. Je belt of appt met mij zelf, dag en nacht, op ${SITE.telefoonWeergave}. Ik kom voor lekkage, losse of kapotte dakpannen en nokvorsten, lood rond de schoorsteen en het dakraam, dakgoten en stormschade. Bij een lek kom ik vaak nog dezelfde dag kijken. Ik ben bedrijfsaansprakelijk verzekerd, je hoort de prijs voordat ik begin, en op Werkspot geven klanten me een ${score} uit ${SITE.reviews.werkspotAantal} beoordelingen.` },
  // 22-11-2026 ronde 3: vraag over wat een lek kost, met prijzen uit prijzen.ts (opnieuw, zonder 'inclusief materiaal' en zonder toeslag).
  { v: "Wat kost het als mijn dak lekt?", a: `Dat hangt af van waar het lek zit. Een lek opsporen en dichtmaken kost ${prijsVan("daklekkage")} incl. btw. Is het een losse of kapotte pan, of een nokvorst die weer vast moet, dan is het vaak een kleine reparatie: ${prijsVan("dakpan")} incl. btw. Lekt het platte dak van je aanbouw, garage of berging, dan kost een gerichte reparatie ${prijsVan("platdak")} incl. btw. Moet er meer gebeuren, zoals nieuw lood rond de schoorsteen of een groter stuk dak, stuur dan een foto, dan hoor je wat het kost. Je hoort de vaste prijs voordat ik begin. Stuur een foto van de natte plek en van je dak vanaf de straat via WhatsApp.` },
  // 23-11-2026 ronde 2: vraag over plafondschade na een lek, wat ik wel en niet doe.
  { v: "Herstel je na een lek ook mijn plafond of de muur binnen?", a: "Nee, dat laat ik over aan een stukadoor of schilder. Mijn werk is dat het lek dicht is en dat het binnen droog blijft. Laat het plafond of de muur daarna eerst goed drogen, voordat er iemand aan begint, anders komt de vlek terug of laat de verf los. Is de isolatie op zolder nat geworden, trek die dan een stukje weg zodat hij kan drogen. Maak foto's van de schade binnen voordat er iets wordt hersteld, want daar vraagt je verzekeraar vaak om. Van mij krijg je foto's van wat ik op het dak aantrof en van de reparatie, met een korte omschrijving erbij. Hoe je een nat plafond laat drogen, lees je in de kennisbank." },
  // 24-11-2026 ronde 3: vraag over een lekkende of doorhangende dakgoot, zonder bedrag (gootprijzen niet noemen, Rens 03-11).
  { v: "Repareer je ook een dakgoot die lekt of doorhangt?", a: "Ja. Lekt een zinken goot bij een naad of een hoek, dan soldeer ik die opnieuw. Is het zink op meer plekken dun, maar hangt de goot nog stevig, dan kan ik hem van binnen coaten. Bij een kunststof goot vervang ik de verbinding, het hoekstuk of het stuk dat kapot is. Hangt de goot door, dan hang ik hem weer op afschot, zodat het water weer naar de regenpijp loopt. Is de goot echt op, dan zeg ik dat eerlijk en vervang ik hem. Wat het kost, hangt af van wat er lek is en hoe goed ik erbij kan. Maak tijdens of na een bui vanaf de straat een foto van de plek waar het druppelt en stuur die via WhatsApp. Dan hoor je vooraf wat het kost." },
  // 28-11-2026 ronde 1: vraag over dakgoot leegmaken voor het seizoen, met de vanaf-prijs voor één goot uit prijzen.ts (de homepage had nog geen vraag hierover).
  { v: "Kun je mijn dakgoot leegmaken, en wat kost dat?", a: `Ja. Ik haal blad, mos en zand uit de goot, maak de uitloop naar de regenpijp vrij en neem de troep mee. Eén goot, bijvoorbeeld alleen de voorgoot, kost ${prijsVan("goot_reinigen")} incl. btw. Moeten beide goten leeg, heb je een hoekhuis of een vrijstaand huis, of hangen je goten hoog, dan hoor je vooraf de vaste prijs. Zie ik bij het leegmaken dat de goot lekt of doorhangt, dan zeg ik dat, en je hoort eerst wat het herstel kost. Een goed moment is laat in de herfst, als het meeste blad van de bomen is, en voordat het gaat vriezen. Stuur een foto van je huis vanaf de straat via WhatsApp en zet erbij om welke goten het gaat.` },
];
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((f) => ({ "@type": "Question", name: f.v, acceptedAnswer: { "@type": "Answer", text: f.a } })),
};
---

<Base
  title={`Dakdekker Den Bosch: spoed en lekkage | ${SITE.bedrijfsnaam}`}
  description={`Dakdekker in de regio Den Bosch: één vaste man voor lekkage, spoed, goten en pannen. Dag en nacht bereikbaar, bij lekkage vaak dezelfde dag. Dak-APK ${apkPrijs}.`}
  path="/"
  schema={faqSchema}
>
  <!-- SPOEDBALK: acute lekkage direct naar bellen -->
  <div class="spoed-bar">
    <div class="wrap">
      <span>Lekkage of stormschade <strong>nú</strong>? Dag en nacht bereikbaar.</span>
      <a class="tel" href={waHref("Hallo, ik heb NU een lekkage/schade aan mijn dak. Ik stuur zo een foto mee.")}>App direct een foto</a>
      <a class="meer" href={telHref}>of bel {SITE.telefoonWeergave}</a>
      <a class="meer" href="/spoed/">Eerste hulp bij een lek →</a>
    </div>
  </div>

  <!-- HERO -->
  <section class="hero">
    <div class="wrap">
      <div class="topline">
        <span class="kicker">Dakdekker · {SITE.regioOmschrijving}</span>
        <span class="stars"><span class="ster">★★★★★</span> <b>{score}</b> <a class="bron" href={SITE.werkspotUrl} target="_blank" rel="noopener">op Werkspot</a></span>
      </div>
      <h1>Dakdekker in Den Bosch:<br />vakkundig dakwerk door één vaste man</h1>
      <p class="lead" style="margin-bottom:12px;">Spoed Dak Service is een dakdekker uit 's-Hertogenbosch voor daklekkage, spoed dakreparatie, losse dakpannen en nokvorsten, lood en dakgoten, in de regio Den Bosch en verder in Brabant.</p>
      <p class="lead">
        Geen callcenter, geen verrassingen achteraf. Je krijgt mij, Rens, aan de lijn,
        ik kom langs, en je hoort eerlijk wat er nodig is. Vaste prijs vooraf.
      </p>
      <p style="margin:12px 0 0; color:#fff; font-size:1.05rem;"><strong>Dag en nacht bereikbaar (24/7):</strong> bel of app <a href={telHref} style="color:inherit; text-decoration:underline;">{SITE.telefoonWeergave}</a>.</p>
      <div class="pricehook">
        <span class="van">Dak-APK<br />keuring</span>
        <span class="big">{apkPrijs}</span>
        <span class="per">compleet fotorapport<br />binnen een dagdeel</span>
      </div>
      <p style="margin:14px 0 0; color:#d3e0ec; font-size:1.02rem; max-width:660px;">
        <strong style="color:#fff;">Een offerte is altijd gratis.</strong> Weet je al wat er speelt? Bel of stuur een foto via WhatsApp, dan krijg je gewoon een prijs, géén {apkPrijs}.
        De <strong style="color:#fff;">Dak-APK ({apkPrijs}) is optioneel</strong>: een complete keuring mét fotorapport, handig als je wilt weten hoe je hele dak ervoor staat.
      </p>
      <div class="hero-checks">
        <span><span class="v">✓</span> Eerlijk advies, geen verkooppraatje</span>
        <span><span class="v">✓</span> Vaste prijs, geen verrassingen</span>
        <span><span class="v">✓</span> Garantie: 1 jaar op reparatie, 2 jaar op vervangen</span>
        <span><span class="v">✓</span> Vaak dezelfde dag bij spoed</span>
      </div>
      <div class="btn-row">
        <a class="btn btn--primary" href="/quiz/">Gratis prijsindicatie, vaak binnen 10 minuten</a>
        <a class="btn btn--wa" href={FOTO_WA}>Stuur een foto via WhatsApp</a>
        <a class="btn btn--ghost" href="/dak-apk/">Bekijk de Dak-APK</a>
      </div>
    </div>
  </section>

  <!-- DIENSTEN -->
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Wat ik doe</p>
      <h2>Voor je hele dak één aanspreekpunt</h2>
      <p class="lead">Van een verstopte goot tot een lekkend dak, snel, netjes, en met een eerlijke prijs vooraf.</p>
      <div class="grid grid-3" style="margin-top:26px;">
        {DIENSTEN.filter((d) => !d.verborgen).map((d, i) => (
          <a class="card" href={`/diensten/${d.slug}/`}>
            <DienstIcon slug={d.slug} />
            <h3 style="margin-top:6px;">{d.titel}</h3>
            <p>{d.kort}</p>
            {d.vanafPrijs && <span class="price">{d.vanafPrijs}</span>}
          </a>
        ))}
      </div>
      <p style="margin:14px 0 0; color:var(--muted); font-size:.95rem;">Alle bedragen zijn inclusief btw.</p>
      <p style="margin:10px 0 0;">Woon je in Den Bosch zelf? Hoe ik een lek bij jou aanpak, van de binnenstad tot Maaspoort, lees je bij <a href="/werkgebied/den-bosch/daklekkage/">daklekkage in Den Bosch</a>. Lekt je goot, kijk dan bij <a href="/werkgebied/den-bosch/dakgoot-vervangen/">dakgoot repareren in Den Bosch</a>, en na een storm bij <a href="/werkgebied/den-bosch/stormschade/">stormschade in Den Bosch</a>.</p>
      {/* 26-11-2026 ronde 1: ook dakreparatie en dakgoot schoonmaken in Den Bosch ('dakreparatie den bosch' plek 82, 'dakgoot schoonmaken den bosch' 205 vertoningen op plek 47). */}
      <p style="margin:10px 0 0;">Ligt er bij jou in Den Bosch een pan scheef of los, kijk dan bij <a href="/werkgebied/den-bosch/dakreparatie/">dakreparatie in Den Bosch</a>. Zit je goot vol blad of mos, lees dan hoe ik hem leegmaak bij <a href="/werkgebied/den-bosch/goten-reinigen/">dakgoot schoonmaken in Den Bosch</a>.</p>
    </div>
  </section>

  <!-- WAAROM RENS -->
  <section class="section section--white">
    <div class="wrap">
      <p class="eyebrow">Waarom mij</p>
      <h2>Een echte dakdekker, geen tussenpersoon</h2>
      <div class="grid grid-3" style="margin-top:22px;">
        <div class="card">
          <h3>Je krijgt mij</h3>
          <p>Eén vast gezicht van offerte tot oplevering. Korte lijnen: gewoon mijn nummer, geen callcenter.</p>
        </div>
        <div class="card">
          <h3>Eerlijke prijs vooraf</h3>
          <p>Vaste prijs voordat ik aan een klus begin, geen verrassingen achteraf. Wil je eerst weten hoe je dak ervoor staat? Dat kan via de Dak-APK, voor {apkPrijs}.</p>
        </div>
        <div class="card">
          {/* 28-11-2026 ronde 5: kaart over de thuisbasis met de wijken en een link naar dakdekker in Den Bosch (opnieuw tip 53 van ronde 4, zonder SITE.regioOmschrijving en zonder zin over verder weg). */}
          <h3>Thuisbasis Den Bosch</h3>
          <p>Ik werk vanuit 's-Hertogenbosch, dus in de binnenstad, de Muntel, de Kruiskamp, Maaspoort en Empel ben ik nooit ver weg. Ook in de dorpen eromheen ben ik vaak al bij jou in de buurt. Meer lees je bij <a href="/werkgebied/den-bosch/">dakdekker in Den Bosch</a>.</p>
        </div>
      </div>
      <div style="margin-top:28px;">
        <EchteFotos soort="pannen" max={3} inline />
      </div>
      <h3 style="margin-top:28px;">In het kort</h3>
      <ul>
        <li><strong>Wie:</strong> Spoed Dak Service, het bedrijf van {SITE.eigenaar}, dakdekker uit 's-Hertogenbosch (Den Bosch).</li>
        <li><strong>Waar:</strong> de regio Den Bosch en verder in Brabant, en in Gelderland rond Wijchen en Nijmegen. Een klus verder weg plan ik vooraf met je in.</li>
        <li><strong>Klussen:</strong> daklekkage, losse dakpannen en nokvorsten, lood, dakgoten repareren en schoonmaken, platte daken en stormschade.</li>
        <li><strong>Contact:</strong> bellen of WhatsApp op <a href={telHref}>{SITE.telefoonWeergave}</a>, dag en nacht bereikbaar.</li>
        <li><strong>Prijs:</strong> je hoort de vaste prijs voordat ik begin.</li>
        <li><strong>Betalen:</strong> een kleine klus, zoals een paar losse pannen of een goot leegmaken, betaal je als hij klaar is, via iDEAL. Bij groter werk spreken we vooraf af hoe en wanneer je betaalt.</li>
        <li><strong>Verzekerd:</strong> bedrijfsaansprakelijk verzekerd.</li>
        <li><strong>Reviews:</strong> <a href={SITE.werkspotUrl} target="_blank" rel="noopener">{score} op Werkspot</a>{SITE.reviews.werkspotAantal > 0 ? ` (${SITE.reviews.werkspotAantal} reviews)` : ""}.</li>
      </ul>
    </div>
  </section>

  <!-- RICHTPRIJZEN (adverteer de prijzen, laat mensen snel kiezen) -->
  <section class="section section--soft">
    <div class="wrap">
      <p class="eyebrow">Wat kost het?</p>
      <h2>Richtprijzen: je weet meteen waar je aan toe bent</h2>
      <p class="lead">Geen offerte-gedoe of verrassingen achteraf. De vaste prijs hoor je voordat ik begin.</p>

      <!-- Stuur een foto voorop (quiz-plan 28-10): de snelste weg naar jouw prijs -->
      <div class="foto-eerst" style="margin-top:22px;">
        <div>
          <strong>Snelste weg: stuur een foto</strong>
          <span>Beantwoord een paar korte vragen of stuur een foto via WhatsApp. Vaak heb je je prijsindicatie binnen 10 minuten.</span>
        </div>
        <div class="btn-row">
          <a class="btn btn--primary" href="/quiz/">Gratis prijsindicatie, vaak binnen 10 minuten</a>
          <a class="btn btn--wa" href={FOTO_WA}>Stuur een foto via WhatsApp</a>
        </div>
      </div>

      <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:16px; margin-top:22px;">
        <a href="/dak-apk/" style="text-decoration:none; background:var(--navy); border-radius:14px; padding:22px; display:block;">
          <span style="display:block; font-family:var(--font-display); font-weight:800; text-transform:uppercase; letter-spacing:.03em; color:#ffb486; font-size:.85rem;">Dak-APK keuring · optioneel</span>
          <strong style="display:block; font-family:var(--font-display); color:#fff; font-size:2.4rem; line-height:1; margin:8px 0;">{apkPrijs}</strong>
          <span style="display:block; color:#c2d2e3; font-size:.95rem;">Alleen als je een volledige keuring mét fotorapport wilt. Bekend probleem? Vraag gewoon een gratis prijs.</span>
        </a>
        {HOME_PRIJZEN.map((r) => (
          <a href={r.href ?? "/prijzen/"} style="text-decoration:none; background:#fff; border:1px solid var(--line); border-radius:14px; padding:22px; display:block;">
            <span style="display:block; font-family:var(--font-display); font-weight:800; text-transform:uppercase; letter-spacing:.03em; color:var(--navy); font-size:.85rem;">{r.dienst}</span>
            <strong style="display:block; font-family:var(--font-display); color:var(--orange); font-size:2.4rem; line-height:1; margin:8px 0;"><span style="font-size:1rem;">vanaf</span> {r.prijs.replace(/^vanaf\s*/, "")}</strong>
            <span style="display:block; color:var(--muted); font-size:.95rem;">{r.uitleg}</span>
          </a>
        ))}
      </div>
      <p style="margin:16px 0 0; color:var(--muted); font-size:.95rem;">{BTW_REGEL} Goot vervangen, nokvorsten vervangen, loodwerk of groter werk? Stuur een foto, dan hoor je wat het kost.</p>

      <div class="btn-row" style="margin-top:20px;">
        <a class="btn btn--outline" href="/prijzen/">Alle prijzen</a>
        <a class="btn btn--primary" href={telHref}>Bel {SITE.telefoonWeergave}</a>
      </div>
    </div>
  </section>

  <!-- SOCIAL PROOF / REVIEWS -->
  <section class="section section--navy" style="text-align:center;">
    <div class="wrap">
      <p class="eyebrow" style="color:#ffb486;">Wat klanten zeggen</p>
      <div class="stars" style="justify-content:center; margin-bottom:6px;">
        <span class="ster" style="font-size:1.6rem;">★★★★★</span> <b style="font-size:1.9rem;">{score}</b> <a class="bron" style="font-size:1rem;" href={SITE.werkspotUrl} target="_blank" rel="noopener">op Werkspot ({SITE.reviews.werkspotAantal} reviews)</a>
      </div>
      <h2>Mensen kiezen voor een échte vakman uit de buurt</h2>
      <p class="lead" style="margin:0 auto 8px; color:#c2d2e3;">
        Geen callcenter, wél iemand die terugbelt en eerlijk zegt wat nodig is. Dit schreven klanten op Werkspot:
      </p>
      <div class="reviewgrid">
        <figure class="reviewkaart" style="margin:0;">
          <span class="rster" aria-label="5 van 5 sterren">★★★★★</span>
          <blockquote>„Dakgoten keurig netjes schoongemaakt zonder de rommel uit de goten op het terras of in de tuin te morsen. Aanrader!"</blockquote>
          <figcaption>Ard-Jan, Tiel · goten reinigen</figcaption>
        </figure>
        <figure class="reviewkaart" style="margin:0;">
          <span class="rster" aria-label="5 van 5 sterren">★★★★★</span>
          <blockquote>„Snel en mooi dak geplaatst voor een hele nette prijs. Blij mee!"</blockquote>
          <figcaption>F. Spolders, Zoetermeer · dakreparatie</figcaption>
        </figure>
        <figure class="reviewkaart" style="margin:0;">
          <span class="rster" aria-label="5 van 5 sterren">★★★★★</span>
          <blockquote>„Prima werk geleverd. Was flexibel in het plannen, dacht mee en kwam met oplossingen."</blockquote>
          <figcaption>Roos, Oosterbeek · regenpijp vervangen</figcaption>
        </figure>
      </div>
      <div class="btn-row" style="justify-content:center;">
        <a class="btn btn--ghost" href={SITE.werkspotUrl} target="_blank" rel="noopener">Lees alle {SITE.reviews.werkspotAantal} reviews op Werkspot</a>
        {googleReviewLink && <a class="btn btn--primary" href={googleReviewLink}>Plaats een review op Google</a>}
      </div>
      <p style="margin:16px auto 0; color:#9fb4c9; font-size:.92rem; max-width:60ch;">
        Ben je na de klus tevreden? Een korte review op Google helpt mij enorm, én helpt je buren een betrouwbare dakdekker te vinden.
      </p>
    </div>
  </section>

  <!-- ZO WERKT HET -->
  <section class="section section--white">
    <div class="wrap">
      <p class="eyebrow">Zo werkt het</p>
      <h2>Van belletje tot klaar dak in 4 stappen</h2>
      <div class="stappen">
        <div class="stap"><div class="n">1</div><h3>Bel of app</h3><p>Je krijgt mij direct aan de lijn. Vertel kort wat er speelt.</p></div>
        <div class="stap"><div class="n">2</div><h3>Dak-APK of meteen aan de slag</h3><p>Twijfel je? Ik kom langs met de Dak-APK ({apkPrijs}) en je krijgt een compleet rapport. Weet je het al? Dan spreken we gelijk de vaste prijs af.</p></div>
        <div class="stap"><div class="n">3</div><h3>Vaste prijs vooraf</h3><p>Je hoort de prijs vóór ik begin. Geen voorrijkosten, geen verrassingen.</p></div>
        <div class="stap"><div class="n">4</div><h3>Netjes gedaan</h3><p>Ik voer het werk uit en ruim op. Je krijgt 1 jaar garantie op reparatie en 2 jaar op vervangen.</p></div>
      </div>
    </div>
  </section>

  <!-- WERKGEBIED -->
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Werkgebied</p>
      <h2>In welke plaatsen ik kom</h2>
      <p class="lead">Klik op je plaats voor meer info, of bel gerust als je plaats er niet bij staat.</p>
      <div class="chips">
        {PLAATSEN.map((p) => <a class="chip" href={`/werkgebied/${p.slug}/`}>{p.naam}</a>)}
        <a class="chip" href="/werkgebied/">Hele werkgebied →</a>
      </div>
      {/* 27-11-2026 ronde 2: Rosmalen, Veghel en Heusden vooraan in deze zin (opnieuw tip 1 van ronde 1, nu met de spaties goed). Vught niet: die lekkagepagina meten we na het terugzetten van de titel op 26-11. */}
      <p style="margin-top:18px;">Lekt het bij jou? Hoe ik een lek in jouw plaats aanpak, lees je bij daklekkage in <a href="/werkgebied/rosmalen/daklekkage/">Rosmalen</a>, <a href="/werkgebied/veghel/daklekkage/">Veghel</a>, <a href="/werkgebied/heusden/daklekkage/">Heusden</a>, <a href="/werkgebied/berlicum/daklekkage/">Berlicum</a>, <a href="/werkgebied/vlijmen/daklekkage/">Vlijmen</a>, <a href="/werkgebied/drunen/daklekkage/">Drunen</a>, <a href="/werkgebied/boxtel/daklekkage/">Boxtel</a>, <a href="/werkgebied/sint-michielsgestel/daklekkage/">Sint-Michielsgestel</a>, <a href="/werkgebied/uden/daklekkage/">Uden</a>, <a href="/werkgebied/waalwijk/daklekkage/">Waalwijk</a> en <a href="/werkgebied/tilburg/daklekkage/">Tilburg</a>.</p>
      <p style="margin-top:12px;">Woon je verder weg? Ook bij een lek in <a href="/werkgebied/eindhoven/daklekkage/">Eindhoven</a>, <a href="/werkgebied/helmond/daklekkage/">Helmond</a>, <a href="/werkgebied/breda/daklekkage/">Breda</a> of <a href="/werkgebied/wijchen/daklekkage/">Wijchen</a> kun je me bellen of appen met een foto van de natte plek. Dan hoor je eerlijk wanneer ik kan komen.</p>
      <p style="margin-top:12px;">Lekt je dakgoot, of hangt hij door? Hoe ik een goot bij jou in de buurt repareer, lees je bij dakgoot repareren in <a href="/werkgebied/vught/dakgoot-vervangen/">Vught</a>, <a href="/werkgebied/rosmalen/dakgoot-vervangen/">Rosmalen</a>, <a href="/werkgebied/oss/dakgoot-vervangen/">Oss</a>, <a href="/werkgebied/veghel/dakgoot-vervangen/">Veghel</a>, <a href="/werkgebied/boxtel/dakgoot-vervangen/">Boxtel</a>, <a href="/werkgebied/oisterwijk/dakgoot-vervangen/">Oisterwijk</a>, <a href="/werkgebied/sint-michielsgestel/dakgoot-vervangen/">Sint-Michielsgestel</a>, <a href="/werkgebied/waalwijk/dakgoot-vervangen/">Waalwijk</a> en <a href="/werkgebied/uden/dakgoot-vervangen/">Uden</a>.</p>
    </div>
  </section>

  <!-- KENNISBANK -->
  <section class="section section--white">
    <div class="wrap">
      <p class="eyebrow">Kennisbank</p>
      <h2>Daktips & eerlijke uitleg</h2>
      <p class="lead">Zo weet je wat er speelt voordat je belt, zonder verkooppraatje.</p>
      <div class="grid grid-3" style="margin-top:22px;">
        {uitgelicht.map((a) => (
          <a class="card" href={`/kennisbank/${a.slug}/`}>
            <h3>{a.titel}</h3>
            <p>{a.metaDescription}</p>
          </a>
        ))}
      </div>
      {WINTER_UITLEG.length > 0 && (
        <p style="margin-top:18px;"><strong>Nu in de winter:</strong> {WINTER_UITLEG.map((w, i) => <>{i > 0 && (i === WINTER_UITLEG.length - 1 ? " en " : ", ")}<a href={`/kennisbank/${w.slug}/`}>{w.tekst}</a></>)}.</p>
      )}
      {STORM_UITLEG.length > 0 && (
        <p style="margin-top:10px;"><strong>Na een storm:</strong> {STORM_UITLEG.map((w, i) => <>{i > 0 && (i === STORM_UITLEG.length - 1 ? " en " : ", ")}<a href={`/kennisbank/${w.slug}/`}>{w.tekst}</a></>)}.</p>
      )}
      {/* 26-11-2026 ronde 2: de lijst met een link naar elk uitlegartikel is weg. De homepage had 2330 vertoningen op plek 59 en 'dakdekker den bosch' staat niet tussen de zoekwoorden. De artikelen blijven gelinkt via de voettekst en /kennisbank/. */}
      <p style="margin-top:18px;">Alle andere uitleg vind je in de kennisbank, per onderwerp op een rij: lekkage, dakgoten, storm, platte daken, pannen en de schoorsteen.</p>
      <p style="margin-top:18px;"><a class="btn btn--outline" href="/kennisbank/">Naar de kennisbank</a></p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Veelgestelde vragen</p>
      <h2>Goed om te weten</h2>
      <div class="faq" style="margin-top:18px; max-width:780px;">
        {faq.map((f) => (
          <details>
            <summary>{f.v}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
      <p style="margin-top:16px;">Foto's van mijn eigen klussen zie je op <a href="/mijn-werk/">foto's van mijn werk</a>.</p>
    </div>
  </section>
</Base>
