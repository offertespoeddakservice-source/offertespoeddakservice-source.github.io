---
import Base from "../layouts/Base.astro";
import { SITE, telHref, waHref } from "../site.config.ts";
import { PRIJZEN, BTW_REGEL, inclBtw } from "../data/prijzen.ts";

// Alle rijen uit src/data/prijzen.ts (incl. btw). Rijen zonder bedrag ("stuur een foto") krijgen een WhatsApp-link.
const rijen = PRIJZEN;
const FOTO_WA = waHref("Hallo, ik wil graag weten wat het kost. Ik stuur een foto mee.");

const faq = [
  { v: "Waarom staat er niet bij alles een bedrag?", a: "Elk dak is anders. Bij kleine klussen zie je hierboven een vanaf-prijs. Bij grotere klussen, zoals een goot of nok vervangen of loodwerk, hangt het te veel af van je dak. Stuur een foto, dan hoor je wat het kost. De vaste prijs hoor je altijd voordat ik begin." },
  { v: "Hoe kom ik het snelst aan een prijs?", a: "Beantwoord de korte vragen of stuur een foto via WhatsApp. Meestal staat je prijsindicatie binnen 10 minuten op WhatsApp. Is het wat lastiger, dan kijken we er persoonlijk naar en hoor je binnen 24 uur van ons." },
  { v: "Zijn de prijzen inclusief btw?", a: "Ja. Alle bedragen op deze site zijn inclusief btw. Een vanaf-prijs is wat het minimaal kost. Meer werk of verder rijden, dan wordt het meer, en dat hoor je vooraf." },
  { v: "Reken je voorrijkosten?", a: "Nee, een prijs aanvragen is gratis en vrijblijvend. Wil je een complete keuring van je dak mét fotorapport? Dat is de Dak-APK (€49). Weet je al wat er moet gebeuren? Dan hoor je gewoon gratis de vaste prijs vooraf." },
];
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((f) => ({ "@type": "Question", name: f.v, acceptedAnswer: { "@type": "Answer", text: f.a } })),
};
---

<Base
  title={`Prijzen dakdekker: eerlijk & vooraf | ${SITE.bedrijfsnaam}`}
  description={`Wat kost een dakdekker? Dakgoot reinigen ${inclBtw("goot_reinigen")}, dakpan vervangen ${inclBtw("dakpan")}, daklekkage ${inclBtw("daklekkage")}. Stuur een foto voor je prijs, vaste prijs vooraf.`}
  path="/prijzen"
  schema={faqSchema}
>
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow" style="color:#ffb486;">Prijzen</p>
      <h1>Eerlijke prijzen, altijd vooraf</h1>
      <p class="lead">Geen verrassingen achteraf. Hieronder de vanaf-prijzen: bij elke klus hoor je de vaste prijs voordat ik begin.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap" style="max-width:820px;">
      <!-- Stuur een foto voorop (quiz-plan 28-10) -->
      <div class="foto-eerst" style="margin-bottom:26px;">
        <div>
          <strong>Snelste weg: stuur een foto</strong>
          <span>Beantwoord een paar korte vragen of stuur een foto via WhatsApp. Meestal heb je je prijsindicatie binnen 10 minuten.</span>
        </div>
        <div class="btn-row">
          <a class="btn btn--primary" href="/quiz/">Gratis prijs, meestal binnen 10 minuten</a>
          <a class="btn btn--wa" href={FOTO_WA}>Stuur een foto via WhatsApp</a>
        </div>
      </div>

      <div class="table-scroll">
      <table style="width:100%; border-collapse:collapse;">
        <thead>
          <tr style="text-align:left; border-bottom:2px solid var(--line);">
            <th style="padding:12px 10px;">Klus</th>
            <th style="padding:12px 10px;">Prijs (incl. btw)</th>
            <th style="padding:12px 10px;">Toelichting</th>
          </tr>
        </thead>
        <tbody>
          {rijen.map((r) => (
            <tr style="border-bottom:1px solid var(--line);">
              <td style="padding:12px 10px; font-weight:700; color:var(--navy);">{r.href ? <a href={r.href} style="color:inherit;">{r.dienst}</a> : r.dienst}</td>
              <td style="padding:12px 10px; color:var(--orange-text); font-weight:700; white-space:nowrap;">
                {r.fotoEerst ? <a href={FOTO_WA} style="color:inherit;">Stuur een foto</a> : r.prijs}
              </td>
              <td style="padding:12px 10px; color:var(--muted);">{r.uitleg}</td>
            </tr>
          ))}
        </tbody>
      </table>
      </div>
      <p class="notice" style="margin-top:20px;">
        {BTW_REGEL} Wijkt de einduitkomst meer dan 10% af van de prijs die je vooraf hoorde, dan laat ik dat vooraf weten, zoals de wet ook voorschrijft (art. 7:753 BW).
      </p>
      <div class="btn-row" style="margin-top:22px;">
        <a class="btn btn--primary" href="/quiz/">Gratis prijs, meestal binnen 10 minuten</a>
        <a class="btn btn--outline" href={telHref}>Bel {SITE.telefoonWeergave}</a>
      </div>
    </div>
  </section>

  <section class="section section--soft">
    <div class="wrap">
      <h2>Vragen over prijs</h2>
      <div class="faq" style="margin-top:16px; max-width:760px;">
        {faq.map((f) => (
          <details>
            <summary>{f.v}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</Base>
