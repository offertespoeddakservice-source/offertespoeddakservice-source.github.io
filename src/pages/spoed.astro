---
import Base from "../layouts/Base.astro";
import { SITE, telHref, waHref } from "../site.config.ts";
import { prijsVan, inclBtw } from "../data/prijzen.ts";
import EchteFotos from "../components/EchteFotos.astro";
import { ARTIKELEN } from "../data/artikelen.ts";

const heeftTijdelijk = ARTIKELEN.some((a) => a.slug === "daklek-tijdelijk-dichten" && !a.verborgen);
const heeftHuurhuis = ARTIKELEN.some((a) => a.slug === "lekkage-huurhuis" && !a.verborgen);
const heeftGevelpannen = ARTIKELEN.some((a) => a.slug === "gevelpannen-los" && !a.verborgen);
const heeftGootLos = ARTIKELEN.some((a) => a.slug === "dakgoot-losgeraakt" && !a.verborgen);
const heeftSchoorsteenStorm = ARTIKELEN.some((a) => a.slug === "schoorsteen-na-storm" && !a.verborgen);

const lekPrijs = prijsVan("daklekkage");
const gotenPrijs = prijsVan("goot_reinigen");
const kleinPrijs = prijsVan("dakpan");
const score = SITE.reviews.score.toString().replace(".", ",");

const stappen = [
  { n: "1", titel: "Beperk de schade binnen", tekst: "Zet een emmer onder het lek, leg handdoeken neer en schuif spullen en meubels opzij. Druppelt het uit een lamp of spotje, zet dan in de meterkast de groep van die kamer uit. Bolt het plafond op, ga er dan niet onder staan. Bij een kleine bolling kun je boven de emmer één klein gaatje prikken, zodat het water gecontroleerd naar beneden komt. Hangt het plafond ver door of zie je scheuren, blijf er dan weg." },
  { n: "2", titel: "Blijf zelf van het dak af", tekst: "Zeker bij storm of regen: klim niet zelf het dak op. Een natte pan of ladder is zo gebeurd, en de schade wordt er zelden beter van." },
  { n: "3", titel: "Maak foto's", tekst: "Foto's van de natte plek binnen en (vanaf de grond) van het dak. Handig voor mij om alvast mee te kijken, en voor je verzekering bij stormschade." },
  { n: "4", titel: "Bel of app mij direct", tekst: "Bel of stuur je foto's via WhatsApp. Ik zeg meteen wat je nu zelf kunt doen en wanneer ik er kan zijn, bij spoed in de regio vaak nog dezelfde dag." },
];

const faq = [
  { v: "Hoe snel kun je er zijn bij een lekkage?", a: "Bij spoed in de regio Den Bosch vaak nog dezelfde dag. Bel of WhatsApp 06 10 18 53 57, dan hoor je meteen wanneer ik kan. Bij een officiële stormwaarschuwing kan het drukker zijn. Ook dan hoor je meestal binnen een dag waar je aan toe bent." },
  { v: "Wat kost een spoedreparatie?", a: `Een daklekkage opsporen en dichten kost ${inclBtw("daklekkage")}, inclusief materiaal. Buiten kantooruren ('s avonds, 's nachts, weekend en feestdagen) geldt een spoedtoeslag. Je hoort altijd de vaste prijs vóórdat ik begin, ook midden in de nacht.` },
  { v: "Kom je ook 's avonds, 's nachts of in het weekend?", a: "Ja, ik ben dag en nacht bereikbaar (24/7). Een actief lek of een open dak na storm kan niet wachten. App een foto of bel 06 10 18 53 57, op elk moment." },
  { v: "Is de natte plek binnen ook de plek van het lek?", a: "Zelden. Water loopt langs balken en folie en komt vaak meters verderop naar binnen. Ik spoor het echte lek op zonder onnodig sloopwerk." },
  { v: "Valt stormschade onder mijn verzekering?", a: "Storm- en hagelschade valt vaak onder je opstalverzekering. Ik maak duidelijke foto's en een omschrijving die je direct kunt indienen." },
  { v: "Is het spoed, of kan het wachten?", a: "Druppelt het binnen, ligt er een pan of nokvorst op straat of zie je een open plek in je dak, dan is het spoed: bel of app me meteen. Een oude, droge kring op het plafond, of een scheve pan terwijl het binnen droog blijft, kan meestal een paar dagen wachten. Twijfel je, stuur dan een foto via WhatsApp. Dan zeg ik eerlijk of het vandaag moet of dat het kan wachten tot overdag op een werkdag. Dan komt er ook geen spoedtoeslag bij." },
  { v: "Wat doe je bij een spoed dakreparatie?", a: "Eerst zorg ik dat het binnen droog blijft: een losse pan terugleggen, een open plek afdekken of een volle goot leegmaken. Vaak kan ik het lek daarna meteen goed maken. Is daar een passende pan of nieuw lood voor nodig, dan maak ik het eerst waterdicht en kom ik terug voor de nette reparatie. Je hoort vooraf wat het kost." },
  { v: "Ik huur mijn huis en het lekt. Mag ik jou zelf bellen?", a: "Meld het lek eerst bij je verhuurder. Het dak is in de regel zijn zaak, en hij moet meestal akkoord geven voor de reparatie. Huur je van een woningcorporatie, bel dan hun nummer voor reparaties, want die hebben vaak hun eigen vakmensen. Is je verhuurder 's avonds of in het weekend niet te bereiken en druppelt het binnen, dan kun je mij bellen of appen. Je hoort vooraf wat het kost, en ik maak foto's van wat ik aantref. Die kun je aan je verhuurder laten zien, zodat jullie samen kunnen afspreken wie de rekening betaalt." },
  { v: "Ik bel voor mijn ouders of een buurvrouw. Kan dat?", a: "Ja, dat kan gewoon. Stuur me het adres en een foto van de natte plek of van het dak vanaf de straat, en zeg wie er thuis is als ik kom. Je hoort vooraf wat het kost. Als je wilt, kan ik jou na afloop een foto sturen van wat ik heb gedaan, zodat je weet dat het in orde is, ook als je er zelf niet bij bent." },
  { v: "Ik ben op vakantie of niet thuis, en de buren zien dat er pannen van mijn dak zijn gewaaid. Kun je toch komen?", a: "Vaak wel. Kan ik van buiten bij de plek, en spreken we de prijs vooraf af, dan repareer ik een losse pan of nokvorst ook als je niet thuis bent. Vraag de buren om een foto van het dak vanaf de straat en stuur die via WhatsApp, samen met je adres. Lekt het ook binnen, dan is het fijn als iemand met een sleutel even binnen kan kijken en een emmer onder de druppel kan zetten." },
  { v: "Kan ik het lek zelf afdekken met een zeil of tape tot je er bent?", a: "Niet op het dak. Een nat dak is glad, en een zeil vangt bij wind zoveel kracht dat het je zo van de ladder trekt. Vang het water liever binnen op: een emmer onder de druppel, plastic of handdoeken eronder, en spullen opzij. Kun je op zolder veilig bij de plek, zet dan een bak onder de plek waar het van de pannen of het hout druppelt, maar stop geen isolatie of doeken tussen de pannen. Bel of app me met een foto, dan zeg ik wat je nog meer kunt doen, en als ik er ben dek ik het zelf af." },
  { v: "Wanneer bel ik 112 in plaats van jou?", a: "Bel 112 als er direct gevaar is voor mensen op straat of in huis. Bijvoorbeeld als er bij storm een schoorsteen, een stuk dak of een losse plaat dreigt te vallen boven de stoep of de weg. De brandweer kan de plek dan afzetten of iets tijdelijk vastzetten. Een lek binnen, een pan die scheef ligt of een nokvorst in de tuin is geen zaak voor 112: dan bel of app je mij met een foto. Is de brandweer geweest, stuur me dan ook een foto van de plek, dan hoor je wat er nog moet gebeuren en wat het kost." },
];
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((f) => ({ "@type": "Question", name: f.v, acceptedAnswer: { "@type": "Answer", text: f.a } })),
};
// Spoed als dienst in de gegevens voor Google en AI: wie, wat, waar en dag en nacht bereikbaar. Geen prijs.
const spoedSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Spoed dakdekker bij daklekkage en stormschade",
  serviceType: "Spoed dakreparatie",
  description: "Spoed bij daklekkage en stormschade aan je dak: eerst de schade beperken, daarna een nette reparatie. Dag en nacht bereikbaar.",
  url: `${SITE.url}/spoed/`,
  provider: { "@type": "RoofingContractor", "@id": `${SITE.url}/#bedrijf`, name: SITE.bedrijfsnaam, telephone: `+${SITE.telefoonE164}` },
  areaServed: [{ "@type": "State", name: "Noord-Brabant" }, { "@type": "City", name: SITE.basisplaats }],
  hoursAvailable: { "@type": "OpeningHoursSpecification", dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"], opens: "00:00", closes: "23:59" },
};
---

<Base
  title={`Spoed dakdekker en daklekkage Den Bosch | ${SITE.bedrijfsnaam}`}
  description="Acute daklekkage of stormschade? Spoed dakdekker in de regio Den Bosch, vaak dezelfde dag langs, ook 's avonds en in het weekend. Bel 06 10 18 53 57."
  path="/spoed"
  schema={[faqSchema, spoedSchema]}
>
  <section class="hero">
    <div class="wrap">
      <div class="topline">
        <span class="kicker">Spoed · {SITE.regioOmschrijving}</span>
        <span class="stars"><span class="ster">★★★★★</span> <b>{score}</b> <a class="bron" href={SITE.werkspotUrl} target="_blank" rel="noopener">op Werkspot</a></span>
      </div>
      <h1>Spoed dakdekker bij lekkage of stormschade<br />Vaak dezelfde dag langs</h1>
      <p class="lead" style="margin-bottom:12px;">Spoed Dak Service is een dakdekker uit 's-Hertogenbosch voor daklekkage, stormschade en spoed dakreparatie, dag en nacht bereikbaar, in de regio Den Bosch en verder in Brabant.</p>
      <p class="lead">
        Een lek wacht niet, ik ook niet. Bel of stuur direct een foto via WhatsApp, je krijgt mij
        (Rens) meteen aan de lijn, ik zeg wat je nú zelf kunt doen en wanneer ik er ben.
      </p>
      <p style="margin:16px 0 0; font-size:1.1rem; color:#fff;">
        <strong style="font-family:var(--font-display);">Dag en nacht bereikbaar: 24/7</strong>
        <span style="color:#c2d2e3;">, lek dichten {lekPrijs} incl. btw, vaste prijs vooraf, ook bij spoed.</span>
      </p>
      <div class="btn-row" style="margin-top:22px;">
        <a class="btn btn--wa" href={waHref("Hallo, ik heb NU een lekkage/schade aan mijn dak. Ik stuur zo een foto mee.")}>WhatsApp een foto</a>
        <a class="btn btn--primary" href={telHref}>Bel direct {SITE.telefoonWeergave}</a>
      </div>
    </div>
  </section>

  <section class="section section--white">
    <div class="wrap">
      <p class="eyebrow">Terwijl je wacht</p>
      <h2>Dit doe je nu eerst</h2>
      <div class="stappen">
        {stappen.map((s) => (
          <div class="stap"><div class="n">{s.n}</div><h3>{s.titel}</h3><p>{s.tekst}</p></div>
        ))}
      </div>
      <p style="margin-top:20px;">
        Wil je alvast weten waar het lek kan zitten? Lees hoe ik <a href="/kennisbank/daklekkage-opsporen/">een daklekkage opspoor</a>, of kijk bij <a href="/kennisbank/lekkage-bij-schoorsteen/">lekkage bij de schoorsteen</a> en <a href="/kennisbank/dakraam-lekt/">een lekkend dakraam</a>. Druppels op zolder terwijl het niet heeft geregend? Dan is het vaak <a href="/kennisbank/condens-of-lekkage-op-zolder/">condens en geen lek</a>. Is het na een storm gebeurd, lees dan <a href="/kennisbank/stormschade-eerste-hulp/">stormschade: eerste hulp</a>.
      </p>
      <p style="margin-top:16px;">Komt het water vooral bij harde wind binnen? Lees dan <a href="/kennisbank/dak-lekt-bij-harde-wind/">dak lekt bij harde wind</a>. Ligt er specie in de goot of staat de nok scheef, kijk dan bij <a href="/kennisbank/nokvorsten-los/">losse nokvorsten</a>. Is er een tak op je dak gevallen, lees <a href="/kennisbank/tak-of-boom-op-dak/">tak of boom op je dak</a>. En wil je voorkomen dat er bij de volgende storm weer pannen loskomen, lees dan <a href="/kennisbank/dakpannen-vastzetten-tegen-storm/">dakpannen vastzetten tegen storm</a>.</p>
      {(heeftGevelpannen || heeftGootLos || heeftSchoorsteenStorm) && (
        <p style="margin-top:16px;">
          {heeftGevelpannen && <>Liggen na de storm de pannen langs de zijkant van je dak los of scheef, lees dan <a href="/kennisbank/gevelpannen-los/">gevelpannen los</a>.</>}
          {heeftGootLos && <> Hangt je dakgoot los, kijk dan bij <a href="/kennisbank/dakgoot-losgeraakt/">dakgoot losgeraakt na een storm</a>.</>}
          {heeftSchoorsteenStorm && <> Staat de kap op je schoorsteen scheef, of ligt er lood of steen los, lees dan <a href="/kennisbank/schoorsteen-na-storm/">schoorsteen beschadigd na een storm</a>.</>}
        </p>
      )}
      <p style="margin-top:16px;">Bolt je plafond op, lees dan wat je doet in <a href="/kennisbank/plafond-bolt-op-door-lekkage/">plafond bolt op door lekkage</a>. Druppelt het uit een lamp of spotje, kijk dan bij <a href="/kennisbank/water-uit-lamp-plafond/">water uit de lamp of spotjes</a>.</p>
      <p style="margin-top:16px;">Is het nat bovenin de muur, net onder het plafond? Dan komt het water vaak van de goot erboven: lees <a href="/kennisbank/water-achter-dakgoot/">water achter de dakgoot</a>. Zit de natte plek boven een raam met een erker of luifel, kijk dan bij <a href="/kennisbank/erker-lekt/">erker of luifel lekt</a>. En is het nat langs de muur met de buren, lees dan <a href="/kennisbank/lekkage-muur-buren/">lekkage langs de muur met de buren</a>.</p>
      <p style="margin-top:16px;">Hoor je water druppelen, maar zie je nog geen natte plek? Lees dan <a href="/kennisbank/druppelen-horen-plafond/">druppelen horen in je plafond</a>. Lekt het nog terwijl je dak net is gerepareerd, kijk dan bij <a href="/kennisbank/dak-lekt-na-reparatie/">dak lekt na de reparatie</a>. Lekt het platte dak van je aanbouw, garage of schuur, lees dan <a href="/kennisbank/epdm-dak-lekt/">EPDM-dak lekt</a> of <a href="/kennisbank/dakleer-repareren/">dakleer repareren</a>. En is het lek gemaakt, maar zit er nog een natte plek, dan lees je in <a href="/kennisbank/plafond-drogen-na-lekkage/">plafond drogen na een lekkage</a> hoe lang dat duurt.</p>
      {(heeftTijdelijk || heeftHuurhuis) && (
        <p style="margin-top:16px;">
          {heeftTijdelijk && <>Moet je even wachten tot ik er ben? Wat je binnen en op zolder zelf veilig kunt doen om het droog te houden, lees je in <a href="/kennisbank/daklek-tijdelijk-dichten/">daklek tijdelijk dichten</a>.</>}
          {heeftHuurhuis && <> Huur je je huis, lees dan in <a href="/kennisbank/lekkage-huurhuis/">lekkage in een huurhuis</a> hoe je het meldt en wie de reparatie regelt.</>}
        </p>
      )}
      <p style="margin-top:22px;">Een scheve of kapotte pan zie je van beneden bijna niet. Twee foto's die ik zelf op het dak maakte:</p>
      <EchteFotos soort="pannen" max={2} inline />
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Waar ik direct bij help</p>
      <h2>Spoedklussen</h2>
      <div class="grid grid-2" style="margin-top:22px;">
        <a class="card" href="/diensten/daklekkage/">
          <h3>Daklekkage</h3>
          <p>Lek opsporen zonder sloopwerk en snel dichten: eerst de schade stoppen, dan netjes herstellen.</p>
          <span class="price">{lekPrijs}</span>
        </a>
        <a class="card" href="/diensten/stormschade/">
          <h3>Stormschade</h3>
          <p>Weggewaaide pannen of een open dak: afdekken, herstellen en foto's voor je verzekering.</p>
          <span class="price">prijs vooraf</span>
        </a>
        <a class="card" href="/diensten/dakgoot-vervangen/">
          <h3>Overlopende of kapotte goot</h3>
          <p>Water langs de gevel? Verstopping verhelpen of de goot herstellen voordat het een lek wordt.</p>
          <span class="price">reinigen {gotenPrijs}</span>
        </a>
        <a class="card" href="/diensten/dakreparatie/">
          <h3>Spoed dakreparatie</h3>
          <p>Een losse pan, een nokvorst die eraf ligt of lood dat loslaat: eerst dicht, dan netjes herstellen.</p>
          <span class="price">{kleinPrijs}</span>
        </a>
      </div>
      <p class="notice" style="margin-top:20px;">
        Buiten kantooruren ('s avonds, 's nachts, weekend en feestdagen) geldt een spoedtoeslag. Ook dan hoor je de vaste prijs vóórdat ik begin. Alle bedragen zijn inclusief btw. Alle prijzen staan op de <a href="/prijzen/">prijzen-pagina</a>.
      </p>
      <p style="margin-top:16px;">Hoe ik een lek bij jou in de buurt aanpak, lees je per plaats: daklekkage in <a href="/werkgebied/den-bosch/daklekkage/">Den Bosch</a>, <a href="/werkgebied/rosmalen/daklekkage/">Rosmalen</a>, <a href="/werkgebied/vught/daklekkage/">Vught</a>, <a href="/werkgebied/oisterwijk/daklekkage/">Oisterwijk</a>, <a href="/werkgebied/heusden/daklekkage/">Heusden</a>, <a href="/werkgebied/schijndel/daklekkage/">Schijndel</a>, <a href="/werkgebied/veghel/daklekkage/">Veghel</a> en <a href="/werkgebied/oss/daklekkage/">Oss</a>. Andere plaatsen vind je bij <a href="/werkgebied/">mijn werkgebied</a>.</p>
      <h3 style="margin-top:28px;">In het kort</h3>
      <ul>
        <li><strong>Wie:</strong> Spoed Dak Service, het bedrijf van {SITE.eigenaar}, dakdekker uit 's-Hertogenbosch (Den Bosch). Je belt of appt met {SITE.eigenaar} zelf, niet met een callcenter.</li>
        <li><strong>Wanneer is het spoed:</strong> als het binnen druppelt, als er een pan of nokvorst op straat ligt of als er een open plek in je dak zit.</li>
        <li><strong>Bereikbaar:</strong> dag en nacht (24/7), ook in het weekend. Bellen of WhatsApp op <a href={telHref}>{SITE.telefoonWeergave}</a>.</li>
        <li><strong>Waar:</strong> vanuit Den Bosch in de regio Den Bosch en verder in Brabant. In de regio kan ik bij spoed vaak nog dezelfde dag komen. Een klus verder weg plan ik vooraf met je in.</li>
        <li><strong>Eerst droog:</strong> ik zorg eerst dat het binnen droog blijft, met afdekken, een pan terugleggen of de goot leegmaken. Daarna volgt de nette reparatie.</li>
        <li><strong>Prijs:</strong> je hoort de vaste prijs voordat ik begin, ook 's nachts.</li>
        <li><strong>Verzekerd:</strong> bedrijfsaansprakelijk verzekerd. Ik maak foto's en een korte omschrijving die je naar je verzekeraar kunt sturen.</li>
        <li><strong>Reviews:</strong> <a href={SITE.werkspotUrl} target="_blank" rel="noopener">{score} op Werkspot</a>{SITE.reviews.werkspotAantal > 0 ? ` (${SITE.reviews.werkspotAantal} reviews)` : ""}.</li>
      </ul>
    </div>
  </section>

  <section class="section section--soft">
    <div class="wrap">
      <h2>Veelgestelde spoedvragen</h2>
      <div class="faq" style="margin-top:16px; max-width:760px;">
        {faq.map((f) => (
          <details>
            <summary>{f.v}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
      <p style="margin-top:18px; max-width:760px;">Staat je vraag er niet bij? Stuur me een foto via <a href={waHref("Hallo, mijn dak lekt. Ik stuur je een foto.")}>WhatsApp</a> of bel <a href={telHref}>{SITE.telefoonWeergave}</a>, dan kijk ik met je mee.</p>
    </div>
  </section>
</Base>
