---
import Base from "../layouts/Base.astro";
import { SITE, telHref, waHref } from "../site.config.ts";
---

<Base
  title={`Contact & offerte | ${SITE.bedrijfsnaam}`}
  description="Vraag een gratis, vrijblijvende offerte aan of bel direct. Spoed Dak Service, dakdekker in de regio Den Bosch. Bel, WhatsApp of vul het formulier in."
  path="/contact"
>
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow" style="color:#ffb486;">Contact</p>
      <h1>Gratis offerte of direct contact</h1>
      <p class="lead">Stuur het liefst een appje: met een foto van je dak erbij kan ik meteen meekijken en krijg je snel een prijs. Bellen kan natuurlijk ook, al zit ik vaak op het dak of onderweg.</p>
      <div class="btn-row" style="margin-top:22px;">
        <a class="btn btn--wa" href={waHref("Hallo, ik wil graag een offerte voor mijn dak.")}>WhatsApp Rens</a>
        <a class="btn btn--primary" href={telHref}>Bel {SITE.telefoonWeergave}</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap split">
      <div>
        <h2>Offerte aanvragen</h2>
        <p class="lead" style="font-size:1.05rem;">Vul kort in wat er speelt, dan neem ik contact op.</p>
        <form class="form" id="contact-form" method="POST" action={`mailto:${SITE.email}`} enctype="text/plain">
          <label>Naam
            <input type="text" name="naam" required autocomplete="name" />
          </label>
          <label>Telefoon
            <input type="tel" name="telefoon" required autocomplete="tel" />
          </label>
          <label>E-mail (optioneel)
            <input type="email" name="email" autocomplete="email" />
          </label>
          <label>Plaats
            <input type="text" name="plaats" autocomplete="address-level2" />
          </label>
          <label>Waar kan ik mee helpen?
            <select name="service">
              <option>Goten reinigen</option>
              <option>Daklekkage / spoed</option>
              <option>Dakreparatie</option>
              <option>Plat dak / EPDM</option>
              <option>Stormschade</option>
              <option>Iets anders</option>
            </select>
          </label>
          <label>Korte omschrijving
            <textarea name="beschrijving" placeholder="Bijv. goot loopt over aan de achterkant"></textarea>
          </label>
          <div style="position:absolute; left:-9999px; top:auto;" aria-hidden="true">
            <label>Website<input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
          </div>
          <div class="btn-row">
            <button class="btn btn--primary" type="submit" id="contact-verstuur">Verstuur aanvraag</button>
            <a class="btn btn--wa" id="contact-wa-link" href={waHref("Hallo, ik wil graag een offerte voor mijn dak.")}>Liever appen? WhatsApp Rens</a>
          </div>
          <p class="notice" id="contact-bevestiging" style="display:none; background:#e8f7ee; border-color:#9fd8b4; color:#155c33;"></p>
          <p class="notice">Je aanvraag komt direct bij mij binnen. Je hoeft verder niets te doen. Ik gebruik je gegevens alleen om je aanvraag op te pakken; maak je het formulier niet af, dan kan ik je nog even terugbellen. Zie de <a href="/privacy/">privacyverklaring</a>. Liever direct? Bel, dan heb je meteen antwoord.</p>
        </form>
        <script define:vars={{ telefoonE164: SITE.telefoonE164 }}>
          const contactForm = document.getElementById("contact-form");
          if (contactForm) {
            // Aanvraag gaat naar het eigen, beveiligde systeem (Cloudflare) — direct
            // vastgelegd + pushmelding naar Rens. WhatsApp blijft de terugvaloptie.
            const API = "https://spoeddak.pages.dev/api/aanvraag";
            const bevestiging = document.getElementById("contact-bevestiging");
            const waLink = document.getElementById("contact-wa-link");
            const verstuurKnop = document.getElementById("contact-verstuur");
            const sid = Array.from(crypto.getRandomValues(new Uint8Array(12)), (b) => b.toString(16).padStart(2, "0")).join("");
            let klaar = false;

            const velden = () => {
              const d = new FormData(contactForm);
              return {
                sid,
                bron: "contact",
                pagina: location.pathname,
                naam: d.get("naam") || "",
                telefoon: d.get("telefoon") || "",
                email: d.get("email") || "",
                plaats: d.get("plaats") || "",
                service: d.get("service") || "",
                beschrijving: d.get("beschrijving") || "",
                website: d.get("website") || "",
              };
            };
            const maakBericht = () => {
              const v = velden();
              return [
                "Hallo, ik wil graag een offerte aanvragen.",
                `Naam: ${v.naam}`,
                `Tel: ${v.telefoon}`,
                v.email ? `E-mail: ${v.email}` : null,
                v.plaats ? `Plaats: ${v.plaats}` : null,
                `Dienst: ${v.service}`,
                v.beschrijving ? `Omschrijving: ${v.beschrijving}` : null,
              ].filter(Boolean).join("\n");
            };
            const meetConversie = (label) => {
              if (typeof gtag === "function") {
                gtag('event','conversion',{'send_to':'AW-18338222053/' + label,'value':1.0,'currency':'EUR'});
              }
            };

            contactForm.addEventListener("submit", async (e) => {
              e.preventDefault();
              if (!contactForm.reportValidity()) return;
              verstuurKnop.disabled = true;
              verstuurKnop.textContent = "Versturen…";
              let gelukt = false;
              try {
                const res = await fetch(API, {
                  method: "POST",
                  keepalive: true,
                  headers: { "Content-Type": "text/plain;charset=UTF-8" },
                  body: JSON.stringify({ ...velden(), status: "compleet" }),
                });
                gelukt = res.ok;
              } catch (fout) { gelukt = false; }
              meetConversie('9ZoXCLXKt9ccEOWfrKhE');
              if (gelukt) {
                klaar = true;
                verstuurKnop.textContent = "Verstuurd ✓";
                bevestiging.textContent = "Gelukt: je aanvraag is binnen! Ik reageer meestal dezelfde dag, vaak binnen een paar uur. Wil je alvast foto's van je dak sturen? Dat kan via WhatsApp, dan kan ik meteen meekijken voor een prijs.";
                if (waLink) {
                  waLink.textContent = "📷 Foto's nasturen via WhatsApp";
                  waLink.href = `https://wa.me/${telefoonE164}?text=${encodeURIComponent(`Hallo, ik heb net het formulier ingevuld (${velden().naam}). Hierbij alvast wat foto's van mijn dak.`)}`;
                }
              } else {
                verstuurKnop.disabled = false;
                verstuurKnop.textContent = "Verstuur aanvraag";
                window.open(`https://wa.me/${telefoonE164}?text=${encodeURIComponent(maakBericht())}`, "_blank", "noopener");
                bevestiging.textContent = "Het formulier kon me net niet direct bereiken, daarom is WhatsApp geopend met je aanvraag, druk daar nog op verzenden. Of bel me even, dan heb je meteen antwoord.";
              }
              bevestiging.style.display = "block";
              bevestiging.scrollIntoView({ block: "nearest" });
            });

            // Halverwege gestopt met een bereikbaar nummer of mailadres? Dan komt de
            // aanvraag als "half ingevuld" binnen, zodat Rens kan terugbellen.
            window.addEventListener("pagehide", () => {
              if (klaar) return;
              const v = velden();
              const cijfers = String(v.telefoon).replace(/[^0-9]/g, "");
              if (cijfers.length < 8 && !String(v.email).includes("@")) return;
              try {
                navigator.sendBeacon(API, new Blob([JSON.stringify({ ...v, status: "onafgemaakt" })], { type: "text/plain;charset=UTF-8" }));
                klaar = true;
              } catch (fout) {}
            });
          }
        </script>
      </div>
      <aside>
        <div class="card">
          <h3>Direct</h3>
          <ul class="checks" style="margin-top:8px;">
            <li><a href={telHref}>{SITE.telefoonWeergave}</a></li>
            <li><a href={waHref()}>WhatsApp Rens</a></li>
            <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
          </ul>
          <p style="margin-top:10px; color:var(--muted);">Werkgebied: {SITE.regioOmschrijving}.</p>
          <p style="margin-top:6px; color:var(--muted);">Dag en nacht bereikbaar (24/7). Meestal dezelfde dag antwoord.</p>
        </div>
      </aside>
    </div>
  </section>
</Base>
