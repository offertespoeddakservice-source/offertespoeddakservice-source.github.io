---
import Base from "../layouts/Base.astro";
import { SITE, telHref, waHref } from "../site.config.ts";
---

<Base
  title={`Contact & offerte | ${SITE.bedrijfsnaam}`}
  description="Vraag een gratis, vrijblijvende offerte aan of bel direct. Spoed Dak Service — dakdekker in de regio Den Bosch. Bel, WhatsApp of vul het formulier in."
  path="/contact"
>
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow" style="color:#ffb486;">Contact</p>
      <h1>Gratis offerte of direct contact</h1>
      <p class="lead">Stuur het liefst een appje — met een foto van je dak erbij kan ik meteen meekijken en krijg je snel een prijs. Bellen kan natuurlijk ook, al zit ik vaak op het dak of onderweg.</p>
      <div class="btn-row" style="margin-top:22px;">
        <a class="btn btn--wa" href={waHref("Hoi Rens, ik wil graag een offerte voor mijn dak.")}>WhatsApp Rens</a>
        <a class="btn btn--primary" href={telHref}>Bel {SITE.telefoonWeergave}</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap split">
      <div>
        <h2>Offerte aanvragen</h2>
        <p class="lead" style="font-size:1.05rem;">Vul kort in wat er speelt, dan neem ik contact op.</p>
        <form class="form" id="contact-form" method="POST" action={`mailto:${SITE.email}`} enctype="text/plain">
          <label>Naam
            <input type="text" name="naam" required autocomplete="name" />
          </label>
          <label>Telefoon
            <input type="tel" name="telefoon" required autocomplete="tel" />
          </label>
          <label>E-mail (optioneel)
            <input type="email" name="email" autocomplete="email" />
          </label>
          <label>Plaats
            <input type="text" name="plaats" autocomplete="address-level2" />
          </label>
          <label>Waar kan ik mee helpen?
            <select name="service">
              <option>Goten reinigen</option>
              <option>Daklekkage / spoed</option>
              <option>Dakreparatie</option>
              <option>Plat dak / EPDM</option>
              <option>Stormschade</option>
              <option>Iets anders</option>
            </select>
          </label>
          <label>Korte omschrijving
            <textarea name="beschrijving" placeholder="Bijv. goot loopt over aan de achterkant"></textarea>
          </label>
          <div class="btn-row">
            <button class="btn btn--wa" type="submit">Verstuur via WhatsApp</button>
            <button class="btn btn--outline" type="button" id="contact-mail">Verstuur via e-mail</button>
          </div>
          <p class="notice" id="contact-bevestiging" style="display:none; background:#e8f7ee; border-color:#9fd8b4; color:#155c33;"></p>
          <p class="notice">Je aanvraag gaat via je eigen WhatsApp of e-mail — zo zie je zelf precies wat je verstuurt. Liever direct? Bel, dan heb je meteen antwoord.</p>
        </form>
        <script define:vars={{ telefoonE164: SITE.telefoonE164, email: SITE.email }}>
          const contactForm = document.getElementById("contact-form");
          if (contactForm) {
            const bevestiging = document.getElementById("contact-bevestiging");
            const maakBericht = () => {
              const data = new FormData(contactForm);
              return [
                "Hoi Rens, ik wil graag een offerte aanvragen.",
                `Naam: ${data.get("naam") || ""}`,
                `Telefoon: ${data.get("telefoon") || ""}`,
                data.get("email") ? `E-mail: ${data.get("email")}` : null,
                data.get("plaats") ? `Plaats: ${data.get("plaats")}` : null,
                `Dienst: ${data.get("service") || ""}`,
                data.get("beschrijving") ? `Omschrijving: ${data.get("beschrijving")}` : null,
              ].filter(Boolean).join("\n");
            };
            const meetConversie = (label) => {
              if (typeof gtag === "function") {
                gtag('event','conversion',{'send_to':'AW-18338222053/' + label,'value':1.0,'currency':'EUR'});
              }
            };
            contactForm.addEventListener("submit", (e) => {
              e.preventDefault();
              if (!contactForm.reportValidity()) return;
              meetConversie('9ZoXCLXKt9ccEOWfrKhE');
              window.open(`https://wa.me/${telefoonE164}?text=${encodeURIComponent(maakBericht())}`, "_blank", "noopener");
              if (bevestiging) {
                bevestiging.textContent = "WhatsApp is geopend met je aanvraag — druk daar nog op verzenden, anders komt hij niet aan. Geen WhatsApp op dit apparaat? Gebruik dan de e-mailknop of bel me even.";
                bevestiging.style.display = "block";
                bevestiging.scrollIntoView({ block: "nearest" });
              }
            });
            const mailKnop = document.getElementById("contact-mail");
            if (mailKnop) {
              mailKnop.addEventListener("click", () => {
                if (!contactForm.reportValidity()) return;
                meetConversie('QcJRCLjKt9ccEOWfrKhE');
                window.location.href = `mailto:${email}?subject=${encodeURIComponent("Offerte-aanvraag via spoeddakservice.nl")}&body=${encodeURIComponent(maakBericht())}`;
                if (bevestiging) {
                  bevestiging.textContent = "Je e-mailprogramma is geopend met je aanvraag — druk daar nog op verzenden. Opent er niets? Mail dan naar " + email + " of bel me even.";
                  bevestiging.style.display = "block";
                  bevestiging.scrollIntoView({ block: "nearest" });
                }
              });
            }
          }
        </script>
      </div>
      <aside>
        <div class="card">
          <h3>Direct</h3>
          <ul class="checks" style="margin-top:8px;">
            <li><a href={telHref}>{SITE.telefoonWeergave}</a></li>
            <li><a href={waHref()}>WhatsApp Rens</a></li>
            <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
          </ul>
          <p style="margin-top:10px; color:var(--muted);">Werkgebied: {SITE.regioOmschrijving}.</p>
          <p style="margin-top:6px; color:var(--muted);">Dag en nacht bereikbaar (24/7). Meestal dezelfde dag antwoord.</p>
        </div>
      </aside>
    </div>
  </section>
</Base>
