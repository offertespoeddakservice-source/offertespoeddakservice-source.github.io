---
import Base from "../../layouts/Base.astro";
import { SITE, telHref, waHref } from "../../site.config.ts";
import { DIENSTEN } from "../../data/diensten.ts";
import DienstIcon from "../../components/DienstIcon.astro";
import { MATRIX } from "../../data/matrix.ts";
import { getPlaats } from "../../data/plaatsen.ts";
import { ARTIKELEN } from "../../data/artikelen.ts";
const fluitBestaat = ARTIKELEN.some((a) => a.slug === "dak-fluit-bij-harde-wind" && !a.verborgen);
// Dakreparatie per plaats: alle plaatsen met een eigen pagina, zodat nieuwe pagina's vanzelf meekomen.
const dakrepPlaatsen = MATRIX.filter((c) => c.dienst === "dakreparatie").map((c) => getPlaats(c.plaats)).filter((p) => p) as NonNullable<ReturnType<typeof getPlaats>>[];
// Dakgoot schoonmaken en dakgoot repareren per plaats: komt vanzelf uit de lijst met pagina's. Den Bosch, Vught en Veghel staan voor het repareren al in de zin hierboven.
const gotenPlaatsen = MATRIX.filter((c) => c.dienst === "goten-reinigen").map((c) => getPlaats(c.plaats)).filter((p) => p) as NonNullable<ReturnType<typeof getPlaats>>[];
const gootRepPlaatsen = MATRIX.filter((c) => c.dienst === "dakgoot-vervangen" && !["den-bosch", "vught", "veghel"].includes(c.plaats)).map((c) => getPlaats(c.plaats)).filter((p) => p) as NonNullable<ReturnType<typeof getPlaats>>[];
// Gestructureerde gegevens: het dienstenoverzicht als verzameling, met alle zichtbare diensten in de volgorde van de pagina. Geen prijzen.
const lijstSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Diensten van Spoed Dak Service",
  url: `${SITE.url}/diensten/`,
  inLanguage: "nl-NL",
  publisher: { "@id": `${SITE.url}/#bedrijf` },
  mainEntity: {
    "@type": "ItemList",
    itemListElement: DIENSTEN.filter((d) => !d.verborgen).map((d, i) => ({ "@type": "ListItem", position: i + 1, url: `${SITE.url}/diensten/${d.slug}/`, name: d.titel })),
  },
};
const faq = [
  { v: "Kun je meerdere klussen in één keer doen?", a: "Ja, en dat is vaak handig. Maak ik je goten leeg, dan kijk ik ook naar de nok, de pannen en het lood. Zit er iets los, dan hoor je eerst wat het kost om dat mee te nemen, en jij beslist of het in dezelfde keer gebeurt. Dan hoef ik niet twee keer te komen." },
  { v: "Werk je ook aan het dak van een schuur, garage of berging?", a: "Ja. Lekt het dakleer of de dakbedekking van een schuur, garage, berging of aanbouw, dan repareer ik dat, en is het hout eronder rot, dan vervang ik dat als het nodig is. De goten van zo'n gebouw maak ik ook leeg. Liggen er grijze golfplaten van voor 1994 op, dan boor of zaag ik daar niet in, want daar kan asbest in zitten. Laat die eerst onderzoeken." },
  { v: "Ik huur mijn huis of woon in een appartement. Kun je dan ook komen?", a: "Ja. Huur je, meld een lek of een kapotte goot dan eerst bij je verhuurder, want die is in de regel verantwoordelijk voor het dak en moet akkoord geven. Woon je in een appartement, dan is het dak meestal van de VvE. Vraagt je verhuurder of de VvE mij om te komen, of hebben jullie dat samen afgesproken, dan kijk ik waar het lekt en maak ik foto's van wat ik zie. Druppelt het nu, zet dan een emmer neer en stuur me een foto." },
  { v: "Welke klussen doe je niet?", a: "Schoorsteen vegen, daken schoonmaken of ontmossen, zonnepanelen schoonmaken en daken isoleren doe ik zelf niet. Ook aan de stenen van een gevel of schoorsteen werk ik niet. Wel maak ik je goten leeg, repareer ik pannen, de nok en het lood, en zet ik een kap op een schoorsteen waar regen in valt. Lekt het onder je zonnepanelen of zitten er duiven onder, dan kom ik ook. Twijfel je of je klus bij mij past, stuur dan een foto via WhatsApp." },
];
const faqSchema = { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: faq.map((f) => ({ "@type": "Question", name: f.v, acceptedAnswer: { "@type": "Answer", text: f.a } })) };
---

<Base
  title={`Dakdekker diensten regio Den Bosch | ${SITE.bedrijfsnaam}`}
  description="Alle dakdiensten in de regio Den Bosch: daklekkage en spoed, goten reinigen en repareren, dakpannen, lood, platte daken (EPDM) en stormschade."
  path="/diensten"
  schema={[lijstSchema, faqSchema]}
>
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow" style="color:#ffb486;">Diensten</p>
      <h1>Mijn dakdiensten in de regio Den Bosch: van lekkage tot dakgoot</h1>
      <p class="lead">Spoed Dak Service is een dakdekker uit 's-Hertogenbosch. Van een verstopte goot tot een lekkend dak: ik help je er snel en netjes vanaf, met een eerlijke prijs vooraf.</p>
      <p style="margin-top:12px; color:#c2d2e3;"><strong>Lekt het nu?</strong> Op de <a href="/spoed/">spoedpagina</a> lees je wat je meteen kunt doen, of bel of WhatsApp me.</p>
    </div>
  </section>
  <section class="section">
    <div class="wrap">
      <h2 class="sr-only">Alle dakdiensten</h2>
      <div class="grid grid-3">
        {DIENSTEN.filter((d) => !d.verborgen).map((d) => (
          <a class="card" href={`/diensten/${d.slug}/`}>
            <DienstIcon slug={d.slug} />
            <h3>{d.titel}</h3>
            <p>{d.kort}</p>
            {d.vanafPrijs && <span class="price">{d.vanafPrijs}</span>}
          </a>
        ))}
      </div>
      <p class="notice" style="margin-top:22px;">
        Vanaf-prijzen, inclusief btw: je hoort altijd de <strong>vaste prijs vooraf</strong>, en een prijs aanvragen is <strong>gratis</strong>. Geen bedrag? Stuur een foto. Alle prijzen op de <a href="/prijzen/">prijzen-pagina</a>.
      </p>
      <h2 style="margin-top:28px;">Welke klus heb je nodig?</h2>
      <ul>
        <li><strong>Druppelt het nu binnen?</strong> Kijk eerst op de <a href="/spoed/">spoedpagina</a> wat je meteen doet, en lees bij <a href="/diensten/daklekkage/">daklekkage</a> hoe ik het lek zoek.</li>
        <li><strong>Ligt er na een storm een pan scheef of mist er iets?</strong> Dan is het <a href="/diensten/stormschade/">stormschade</a>: ik dek eerst af en herstel daarna netjes.</li>
        <li><strong>Hoor je bij harde wind getik, geklapper of gefluit op je dak?</strong> Dan zit er vaak iets los, of blaast de wind door een kier bij een pan, de nok of het lood. Lees <a href="/kennisbank/dakpannen-klapperen-bij-wind/">dakpannen klapperen bij wind</a>{fluitBestaat && <> of <a href="/kennisbank/dak-fluit-bij-harde-wind/">fluiten of gieren bij harde wind</a></>}, en kijk bij <a href="/diensten/dakreparatie/">dakreparatie</a> wat ik eraan doe.</li>
        <li><strong>Loopt je goot bij een bui over de rand?</strong> Meestal zit hij vol of is de uitloop verstopt. Dan is <a href="/diensten/goten-reinigen/">dakgoot schoonmaken</a> vaak genoeg.</li>
        <li><strong>Druppelt je goot steeds op dezelfde plek, ook als hij leeg is?</strong> Dan lekt hij bij een naad, een hoek of de uitloop: zie <a href="/diensten/dakgoot-vervangen/">dakgoot repareren of vervangen</a>.</li>
        <li><strong>Een losse of kapotte pan, een nokvorst die scheef ligt of lood dat loszit?</strong> Dat valt onder <a href="/diensten/dakreparatie/">dakreparatie</a>.</li>
        <li><strong>Lekt het platte dak van je aanbouw, garage of berging?</strong> Zie <a href="/diensten/platte-daken/">platte daken</a>.</li>
        <li><strong>Lekt het naast de schoorsteen, rond een dakraam of bij een dakkapel?</strong> Dan zit het vaak in het lood of in de aansluiting op de pannen: zie <a href="/diensten/lood-vervangen/">lood vervangen</a>. Hoe je het herkent, lees je in <a href="/kennisbank/dakraam-lekt/">dakraam lekt</a> en <a href="/kennisbank/dakkapel-lekt/">dakkapel lekt</a>.</li>
        <li><strong>Wil je weten hoe je hele dak ervoor staat?</strong> Vraag dan de <a href="/dak-apk/">Dak-APK</a> aan: ik kijk je hele dak na en je krijgt een rapport met foto's.</li>
      </ul>
      <p>Twijfel je welke klus het is? Stuur een foto via <a href={waHref("Hallo, ik weet niet welke klus ik nodig heb. Ik stuur een foto.")}>WhatsApp</a>, dan zeg ik het je.</p>
      <p style="margin-top:16px;">Lekt het bij jou thuis? Hoe ik een lek aanpak in jouw buurt, lees je bij daklekkage in <a href="/werkgebied/vlijmen/daklekkage/">Vlijmen</a>, <a href="/werkgebied/heusden/daklekkage/">Heusden</a>, <a href="/werkgebied/oisterwijk/daklekkage/">Oisterwijk</a>, <a href="/werkgebied/schijndel/daklekkage/">Schijndel</a>, <a href="/werkgebied/boxtel/daklekkage/">Boxtel</a> en <a href="/werkgebied/sint-michielsgestel/daklekkage/">Sint-Michielsgestel</a>. Andere plaatsen vind je bij <a href="/werkgebied/">mijn werkgebied</a>.</p>
      <p style="margin-top:12px;">Stormschade aan je dak? Hoe ik dat aanpak, lees je bij stormschade in <a href="/werkgebied/den-bosch/stormschade/">Den Bosch</a>, <a href="/werkgebied/rosmalen/stormschade/">Rosmalen</a>, <a href="/werkgebied/vught/stormschade/">Vught</a>, <a href="/werkgebied/oss/stormschade/">Oss</a>, <a href="/werkgebied/schijndel/stormschade/">Schijndel</a> en <a href="/werkgebied/boxtel/stormschade/">Boxtel</a>. Lekt je dakgoot, lees dan hoe ik een goot repareer in <a href="/werkgebied/den-bosch/dakgoot-vervangen/">Den Bosch</a>, <a href="/werkgebied/vught/dakgoot-vervangen/">Vught</a> en <a href="/werkgebied/veghel/dakgoot-vervangen/">Veghel</a>.</p>
      {dakrepPlaatsen.length > 0 && (
        <p style="margin-top:12px;">Ligt er een pan scheef of zit de nok los? Hoe ik een losse pan of nokvorst vastzet of vervang, lees je per plaats bij dakreparatie in {dakrepPlaatsen.map((p, i) => (<>{i > 0 && (i === dakrepPlaatsen.length - 1 ? " en " : ", ")}<a href={`/werkgebied/${p.slug}/dakreparatie/`}>{p.naam}</a></>))}.</p>
      )}
      {gotenPlaatsen.length > 0 && (
        <p style="margin-top:12px;">Zit je goot vol blad? Hoe ik een volle goot leegmaak en de uitloop vrijmaak, lees je per plaats bij dakgoot schoonmaken in {gotenPlaatsen.map((p, i) => (<>{i > 0 && (i === gotenPlaatsen.length - 1 ? " en " : ", ")}<a href={`/werkgebied/${p.slug}/goten-reinigen/`}>{p.naam}</a></>))}.{gootRepPlaatsen.length > 0 && (<> Een lekkende goot repareer ik ook in {gootRepPlaatsen.map((p, i) => (<>{i > 0 && (i === gootRepPlaatsen.length - 1 ? " en " : ", ")}<a href={`/werkgebied/${p.slug}/dakgoot-vervangen/`}>{p.naam}</a></>))}.</>)}</p>
      )}
    </div>
  </section>

  <section class="section section--white"><div class="wrap"><h2>Vragen over mijn werk</h2><div class="faq" style="margin-top:16px; max-width:760px;">{faq.map((f) => (<details><summary>{f.v}</summary><p>{f.a}</p></details>))}</div></div></section>

  <!-- ANDERE VRAAG? (vangnet voor klussen die er niet bij staan) -->
  <section class="section section--navy" style="text-align:center;">
    <div class="wrap" style="max-width:760px;">
      <p class="eyebrow" style="color:#ffb486;">Andere vraag?</p>
      <h2>Staat jouw klus er niet bij?</h2>
      <p class="lead" style="margin:0 auto 22px; color:#c2d2e3;">
        Geen probleem. Bel of stuur een foto via WhatsApp,
        dan zeg ik eerlijk of ik je kan helpen en wat het ongeveer kost. Een offerte is gratis.
      </p>
      <div class="btn-row" style="justify-content:center;">
        <a class="btn btn--wa" href={waHref("Hallo, ik heb een vraag over mijn dak.")}>WhatsApp Rens</a>
        <a class="btn btn--primary" href={telHref}>Bel {SITE.telefoonWeergave}</a>
      </div>
    </div>
  </section>
</Base>
