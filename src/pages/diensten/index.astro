---
import Base from "../../layouts/Base.astro";
import { SITE, telHref, waHref } from "../../site.config.ts";
import { DIENSTEN } from "../../data/diensten.ts";
import DienstIcon from "../../components/DienstIcon.astro";
import { MATRIX } from "../../data/matrix.ts";
import { getPlaats } from "../../data/plaatsen.ts";
import { ARTIKELEN } from "../../data/artikelen.ts";
const fluitBestaat = ARTIKELEN.some((a) => a.slug === "dak-fluit-bij-harde-wind" && !a.verborgen);
const stopcontactBestaat = ARTIKELEN.some((a) => a.slug === "water-uit-stopcontact-bij-regen" && !a.verborgen);
const plafondBestaat = ARTIKELEN.some((a) => a.slug === "plafond-naar-beneden-door-lekkage" && !a.verborgen);
const noodBestaat = ARTIKELEN.some((a) => a.slug === "noodreparatie-dak" && !a.verborgen);
const burenBestaat = ARTIKELEN.some((a) => a.slug === "dak-repareren-via-buren" && !a.verborgen);
// 18-11-2026 ronde 3: regel voor een goot in de dakrand, in het dak of tussen twee daken. Alleen links naar artikelen die bestaan.
const verholenBestaat = ARTIKELEN.some((a) => a.slug === "verholen-goot-lekt" && !a.verborgen);
const zakgootBestaat = ARTIKELEN.some((a) => a.slug === "zakgoot-lekt" && !a.verborgen);
// 19-11-2026 ronde 3: regels voor een schoorsteenbrand, klimop over de dakrand en een marter onder de pannen. Alleen links naar artikelen die bestaan.
const brandBestaat = ARTIKELEN.some((a) => a.slug === "dak-nakijken-na-schoorsteenbrand" && !a.verborgen);
const klimopBestaat = ARTIKELEN.some((a) => a.slug === "klimop-op-dak-of-in-dakgoot" && !a.verborgen);
const marterBestaat = ARTIKELEN.some((a) => a.slug === "marter-onder-dakpannen" && !a.verborgen);
// 19-11-2026 ronde 4: zin naar de uitleg over welke vakman je belt, alleen als dat artikel bestaat.
const vakmanBestaat = ARTIKELEN.some((a) => a.slug === "welke-vakman-voor-je-dak" && !a.verborgen);
// 21-11-2026 ronde 1: regel voor lekkage in een appartementengebouw en een dakdekker die niet komt. Alleen links naar artikelen die bestaan.
const vveBestaat = ARTIKELEN.some((a) => a.slug === "daklekkage-vve" && !a.verborgen);
const nietGekomenBestaat = ARTIKELEN.some((a) => a.slug === "dakdekker-komt-niet-opdagen" && !a.verborgen);
// 23-11-2026 ronde 2: regel voor goede pannen op rotte latten of zonder folie (dak omdekken). Alleen als het artikel bestaat.
const omdekkenBestaat = ARTIKELEN.some((a) => a.slug === "dak-omdekken" && !a.verborgen);
// 24-11-2026 ronde 1: regel over de schade-expert, alleen als het artikel bestaat.
const expertBestaat = ARTIKELEN.some((a) => a.slug === "schade-expert-dak" && !a.verborgen);
// 20-11-2026 ronde 4: regel om je dak, goot, pannen of dakbedekking te herkennen. Alleen links naar artikelen die bestaan.
const herken = [
  { slug: "welk-soort-dak-heb-ik", anker: "welk soort dak" },
  { slug: "welke-dakgoot-heb-ik", anker: "welke dakgoot" },
  { slug: "welke-dakpan-heb-ik", anker: "welke dakpan" },
  { slug: "welke-dakbedekking-heb-ik", anker: "welke dakbedekking op je platte dak" },
].filter((h) => ARTIKELEN.some((a) => a.slug === h.slug && !a.verborgen));
// Dakreparatie per plaats: alle plaatsen met een eigen pagina, zodat nieuwe pagina's vanzelf meekomen.
const dakrepPlaatsen = MATRIX.filter((c) => c.dienst === "dakreparatie").map((c) => getPlaats(c.plaats)).filter((p) => p) as NonNullable<ReturnType<typeof getPlaats>>[];
// Dakgoot schoonmaken en dakgoot repareren per plaats: komt vanzelf uit de lijst met pagina's. Den Bosch, Vught en Veghel staan voor het repareren al in de zin hierboven.
const gotenPlaatsen = MATRIX.filter((c) => c.dienst === "goten-reinigen").map((c) => getPlaats(c.plaats)).filter((p) => p) as NonNullable<ReturnType<typeof getPlaats>>[];
const gootRepPlaatsen = MATRIX.filter((c) => c.dienst === "dakgoot-vervangen" && !["den-bosch", "vught", "veghel"].includes(c.plaats)).map((c) => getPlaats(c.plaats)).filter((p) => p) as NonNullable<ReturnType<typeof getPlaats>>[];
// Gestructureerde gegevens: het dienstenoverzicht als verzameling, met alle zichtbare diensten in de volgorde van de pagina. Geen prijzen.
const lijstSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Diensten van Spoed Dak Service",
  url: `${SITE.url}/diensten/`,
  inLanguage: "nl-NL",
  publisher: { "@id": `${SITE.url}/#bedrijf` },
  mainEntity: {
    "@type": "ItemList",
    itemListElement: DIENSTEN.filter((d) => !d.verborgen).map((d, i) => ({ "@type": "ListItem", position: i + 1, url: `${SITE.url}/diensten/${d.slug}/`, name: d.titel })),
  },
};
const faq = [
  { v: "Kun je meerdere klussen in één keer doen?", a: "Ja, en dat is vaak handig. Maak ik je goten leeg, dan kijk ik ook naar de nok, de pannen en het lood. Zit er iets los, dan hoor je eerst wat het kost om dat mee te nemen, en jij beslist of het in dezelfde keer gebeurt. Dan hoef ik niet twee keer te komen." },
  { v: "Werk je ook aan het dak van een schuur, garage of berging?", a: "Ja. Lekt het dakleer of de dakbedekking van een schuur, garage, berging of aanbouw, dan repareer ik dat, en is het hout eronder rot, dan vervang ik dat als het nodig is. De goten van zo'n gebouw maak ik ook leeg. Liggen er grijze golfplaten van voor 1994 op, dan boor of zaag ik daar niet in, want daar kan asbest in zitten. Laat die eerst onderzoeken." },
  { v: "Ik huur mijn huis of woon in een appartement. Kun je dan ook komen?", a: "Ja. Huur je, meld een lek of een kapotte goot dan eerst bij je verhuurder, want die is in de regel verantwoordelijk voor het dak en moet akkoord geven. Woon je in een appartement, dan is het dak meestal van de VvE. Vraagt je verhuurder of de VvE mij om te komen, of hebben jullie dat samen afgesproken, dan kijk ik waar het lekt en maak ik foto's van wat ik zie. Druppelt het nu, zet dan een emmer neer en stuur me een foto." },
  { v: "Welke klussen doe je niet?", a: "Schoorsteen vegen, daken schoonmaken of ontmossen, zonnepanelen schoonmaken en daken isoleren doe ik zelf niet. Ook aan de stenen van een gevel of schoorsteen werk ik niet. Wel maak ik je goten leeg, repareer ik pannen, de nok en het lood, en zet ik een kap op een schoorsteen waar regen in valt. Lekt het onder je zonnepanelen of zitten er duiven onder, dan kom ik ook. Twijfel je of je klus bij mij past, stuur dan een foto via WhatsApp." },
  { v: "Welke klus is spoed, en welke kan een paar dagen wachten?", a: "Spoed is het als het binnen druppelt, als er water bij een lamp of stopcontact komt, als een plafond bol gaat staan, of als er na een storm een pan, nokvorst of stuk goot los ligt of je dak open ligt. Bel of app dan meteen, ook 's avonds of in het weekend. Een oude, droge kring op het plafond, een goot die vol zit of een scheve pan terwijl het binnen droog blijft, kan meestal een paar dagen wachten tot een droge werkdag. Wacht dan geen weken, want elke bui maakt het erger. Twijfel je, stuur dan een foto via WhatsApp, dan zeg ik eerlijk wat het is." },
  // 23-11-2026 ronde 5: vraag over een klus als je niet thuis bent (door Rens bevestigd)
  { v: "Kun je een klus doen als ik niet thuis ben?", a: "Vaak wel, als ik er van buiten bij kan, zoals bij een losse pan of een nokvorst. We spreken dan vooraf via WhatsApp de prijs af, en jij zegt waar ik mijn ladder kan zetten. Als je wilt, stuur ik je na afloop een foto van wat ik heb gedaan. Moet ik op zolder kijken waar het water binnenkomt, dan heb ik iemand nodig die de deur opendoet, zoals de buren. Een kleine klus betaal je als hij klaar is, via iDEAL." },
  // 24-11-2026 ronde 3: wie-vraag voor Google en AI.
  { v: "Welke dakdekker in de regio Den Bosch kan ik bellen voor lekkage, pannen of een dakgoot?", a: "Spoed Dak Service: dat ben ik, Rens, dakdekker uit 's-Hertogenbosch. Ik kom voor een lek dat gezocht en dichtgemaakt moet worden, voor losse of kapotte dakpannen en nokvorsten, lood rond de schoorsteen en het dakraam, dakgoten die vol zitten, lekken of doorhangen, een losse windveer, een oude antenne en stormschade. Je belt of appt met mij zelf, geen planner. Ik kom in Den Bosch en de plaatsen eromheen, zoals Rosmalen, Vught, Vlijmen, Oss, Boxtel en Veghel, en verder in Brabant. Bellen of appen kan dag en nacht op 06 10 18 53 57. Stuur een foto van je dak of van de natte plek, dan hoor je vooraf wat het kost." },
];
const faqSchema = { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: faq.map((f) => ({ "@type": "Question", name: f.v, acceptedAnswer: { "@type": "Answer", text: f.a } })) };
---

<Base
  title={`Dakdekker diensten regio Den Bosch | ${SITE.bedrijfsnaam}`}
  description="Alle dakdiensten in de regio Den Bosch: daklekkage en spoed, goten reinigen en repareren, dakpannen, lood, platte daken (EPDM) en stormschade."
  path="/diensten"
  schema={[lijstSchema, faqSchema]}
>
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow" style="color:#ffb486;">Diensten</p>
      <h1>Mijn dakdiensten in de regio Den Bosch: van lekkage tot dakgoot</h1>
      <p class="lead">Spoed Dak Service is een dakdekker uit 's-Hertogenbosch. Van een verstopte goot tot een lekkend dak: ik help je er snel en netjes vanaf, met een eerlijke prijs vooraf.</p>
      <p style="margin-top:12px; color:#c2d2e3;"><strong>Lekt het nu?</strong> Op de <a href="/spoed/">spoedpagina</a> lees je wat je meteen kunt doen, of bel of WhatsApp me.</p>
    </div>
  </section>
  <section class="section">
    <div class="wrap">
      <h2 class="sr-only">Alle dakdiensten</h2>
      <div class="grid grid-3">
        {DIENSTEN.filter((d) => !d.verborgen).map((d) => (
          <a class="card" href={`/diensten/${d.slug}/`}>
            <DienstIcon slug={d.slug} />
            <h3>{d.titel}</h3>
            <p>{d.kort}</p>
            {d.vanafPrijs && <span class="price">{d.vanafPrijs}</span>}
          </a>
        ))}
      </div>
      <p class="notice" style="margin-top:22px;">
        Vanaf-prijzen, inclusief btw: je hoort altijd de <strong>vaste prijs vooraf</strong>, en een prijs aanvragen is <strong>gratis</strong>. Geen bedrag? Stuur een foto. Alle prijzen op de <a href="/prijzen/">prijzen-pagina</a>.
      </p>
      <h2 style="margin-top:28px;">Welke klus heb je nodig?</h2>
      <ul>
        <li><strong>Druppelt het nu binnen?</strong> Kijk eerst op de <a href="/spoed/">spoedpagina</a> wat je meteen doet, en lees bij <a href="/diensten/daklekkage/">daklekkage</a> hoe ik het lek zoek.</li>
        {noodBestaat && <li><strong>Kan het lek niet meteen netjes worden gemaakt?</strong> Dan maak ik het eerst dicht en volgt de nette reparatie op een betere dag. Wat dat inhoudt en hoe lang het houdt, lees je in <a href="/kennisbank/noodreparatie-dak/">noodreparatie aan je dak</a>.</li>}
        <li><strong>Komt er water uit een lamp, spotje{stopcontactBestaat && " of stopcontact"}?</strong> Zet eerst in de meterkast de groep van die kamer uit. Lees dan <a href="/kennisbank/water-uit-lamp-plafond/">water uit je lamp of spotjes</a>{stopcontactBestaat && <> of <a href="/kennisbank/water-uit-stopcontact-bij-regen/">water uit je stopcontact</a></>}.</li>
        {plafondBestaat && <li><strong>Is er door een lek een stuk plafond naar beneden gekomen?</strong> Ga de kamer uit, zet de stroom van die kamer uit en lees <a href="/kennisbank/plafond-naar-beneden-door-lekkage/">plafond naar beneden door lekkage</a>.</li>}
        <li><strong>Ligt er na een storm een pan scheef of mist er iets?</strong> Dan is het <a href="/diensten/stormschade/">stormschade</a>: ik dek eerst af en herstel daarna netjes.</li>
        {expertBestaat && <li><strong>Stuurt je verzekeraar een schade-expert?</strong> Laat een open plek of lek eerst dichtmaken, en lees in <a href="/kennisbank/schade-expert-dak/">de schade-expert komt naar je dak kijken</a> wat je vooraf regelt.</li>}
        <li><strong>Hoor je bij harde wind getik, geklapper of gefluit op je dak?</strong> Dan zit er vaak iets los, of blaast de wind door een kier bij een pan, de nok of het lood. Lees <a href="/kennisbank/dakpannen-klapperen-bij-wind/">dakpannen klapperen bij wind</a>{fluitBestaat && <> of <a href="/kennisbank/dak-fluit-bij-harde-wind/">fluiten of gieren bij harde wind</a></>}, en kijk bij <a href="/diensten/dakreparatie/">dakreparatie</a> wat ik eraan doe.</li>
        <li><strong>Loopt je goot bij een bui over de rand?</strong> Meestal zit hij vol of is de uitloop verstopt. Dan is <a href="/diensten/goten-reinigen/">dakgoot schoonmaken</a> vaak genoeg.</li>
        <li><strong>Druppelt je goot steeds op dezelfde plek, ook als hij leeg is?</strong> Dan lekt hij bij een naad, een hoek of de uitloop: zie <a href="/diensten/dakgoot-vervangen/">dakgoot repareren of vervangen</a>.</li>
        <li><strong>Hangt er geen goot aan de voorkant van je dak, maar ligt hij in de dakrand, in het dak of tussen twee daken?</strong> Dan is het een bakgoot, een verholen goot of een zakgoot. Lekt die, dan komt het water meestal binnen: zie <a href="/diensten/bakgoot-repareren/">bakgoot repareren</a>{(verholenBestaat || zakgootBestaat) && <>, en lees {verholenBestaat && <a href="/kennisbank/verholen-goot-lekt/">verholen goot lekt</a>}{verholenBestaat && zakgootBestaat && " of "}{zakgootBestaat && <a href="/kennisbank/zakgoot-lekt/">zakgoot lekt</a>}</>}.</li>
        <li><strong>Een losse of kapotte pan, een nokvorst die scheef ligt of lood dat loszit?</strong> Dat valt onder <a href="/diensten/dakreparatie/">dakreparatie</a>.</li>
        {omdekkenBestaat && <li><strong>Zijn je pannen nog goed, maar is de folie eronder op of zijn de panlatten zacht?</strong> Dan hoeven er vaak geen nieuwe pannen op: ze kunnen eraf en weer terug op nieuwe latten, en als je dat wilt op nieuwe folie. Lees <a href="/kennisbank/dak-omdekken/">dak omdekken</a> en kijk bij <a href="/diensten/dakrenovatie/">dakrenovatie</a>.</li>}
        {(klimopBestaat || marterBestaat) && <li><strong>Groeit er klimop over je dakrand, of hoor je 's nachts gestommel onder de pannen?</strong> Dan kunnen er pannen zijn opgetild of verschoven. Lees {klimopBestaat && <a href="/kennisbank/klimop-op-dak-of-in-dakgoot/">klimop op je dak of in je dakgoot</a>}{klimopBestaat && marterBestaat && " of "}{marterBestaat && <a href="/kennisbank/marter-onder-dakpannen/">een marter onder je dakpannen</a>}, en kijk bij <a href="/diensten/dakpannen-vervangen/">dakpannen vervangen</a> wat ik eraan doe.</li>}
        <li><strong>Lekt het platte dak van je aanbouw, garage of berging?</strong> Zie <a href="/diensten/platte-daken/">platte daken</a>.</li>
        {(vveBestaat || nietGekomenBestaat) && <li><strong>Woon je in een appartement, of komt je dakdekker niet?</strong> {vveBestaat && <>Lekt het door het dak van je appartementengebouw, lees dan <a href="/kennisbank/daklekkage-vve/">daklekkage bij een VvE</a>.</>}{vveBestaat && nietGekomenBestaat && " "}{nietGekomenBestaat && <>Is een andere dakdekker niet gekomen of niet teruggekomen, kijk dan bij <a href="/kennisbank/dakdekker-komt-niet-opdagen/">je dakdekker komt niet opdagen</a>.</>}</li>}
        <li><strong>Lekt het naast de schoorsteen, rond een dakraam of bij een dakkapel?</strong> Dan zit het vaak in het lood of in de aansluiting op de pannen: zie <a href="/diensten/lood-vervangen/">lood vervangen</a>. Hoe je het herkent, lees je in <a href="/kennisbank/dakraam-lekt/">dakraam lekt</a> en <a href="/kennisbank/dakkapel-lekt/">dakkapel lekt</a>.</li>
        {brandBestaat && <li><strong>Heb je een schoorsteenbrand gehad?</strong> Stook niet tot een schoorsteenveger het kanaal heeft nagekeken. Het lood en de pannen rond de schoorsteen kijk ik daarna na: lees <a href="/kennisbank/dak-nakijken-na-schoorsteenbrand/">je dak nakijken na een schoorsteenbrand</a>.</li>}
        <li><strong>Druppelt het langs een pijp die door het dak gaat, bij je cv-ketel, afzuigkap of kachel?</strong> Dan zit het vaak in de kraag of de doorvoerpan op het dak: zie <a href="/diensten/dakdoorvoer/">dakdoorvoer plaatsen of herstellen</a>.</li>
        {burenBestaat && <li><strong>Kun je alleen via de tuin of het dak van de buren bij je goot of dak?</strong> Hoe je dat samen regelt, en wat het ladderrecht zegt, lees je in <a href="/kennisbank/dak-repareren-via-buren/">via de buren bij je dak</a>.</li>}
        <li><strong>Wil je weten hoe je hele dak ervoor staat?</strong> Vraag dan de <a href="/dak-apk/">Dak-APK</a> aan: ik kijk je hele dak na en je krijgt een rapport met foto's.</li>
        {herken.length > 0 && <li><strong>Weet je niet hoe het onderdeel van je dak heet?</strong> Lees eerst hoe je herkent {herken.map((h, i) => (<>{i > 0 && (i === herken.length - 1 ? " en " : ", ")}<a href={`/kennisbank/${h.slug}/`}>{h.anker}</a></>))} je hebt. Daarna is een foto via WhatsApp vaak genoeg om je te zeggen wat er nodig is.</li>}
      </ul>
      <p>Twijfel je welke klus het is? Stuur een foto via <a href={waHref("Hallo, ik weet niet welke klus ik nodig heb. Ik stuur een foto.")}>WhatsApp</a>, dan zeg ik het je.</p>
      <p style="margin-top:16px;">Lekt het bij jou thuis? Hoe ik een lek aanpak in jouw buurt, lees je bij daklekkage in <a href="/werkgebied/vlijmen/daklekkage/">Vlijmen</a>, <a href="/werkgebied/heusden/daklekkage/">Heusden</a>, <a href="/werkgebied/oisterwijk/daklekkage/">Oisterwijk</a>, <a href="/werkgebied/schijndel/daklekkage/">Schijndel</a>, <a href="/werkgebied/boxtel/daklekkage/">Boxtel</a> en <a href="/werkgebied/sint-michielsgestel/daklekkage/">Sint-Michielsgestel</a>. Andere plaatsen vind je bij <a href="/werkgebied/">mijn werkgebied</a>.</p>
      {/* 26-11-2026 ronde 3: de lekkagepagina's van Den Bosch en de plaatsen eromheen die nog niet in de zin hierboven staan ('daklekkage den bosch' plek 57, de pagina zelf plek 70). Vught, Oisterwijk, Vlijmen en Schijndel bewust niet, die meten we na het terugzetten van hun titel. */}
      <p style="margin-top:12px;">Woon je in of rond Den Bosch? Hoe ik daar een lek zoek en dichtmaak, lees je bij daklekkage in <a href="/werkgebied/den-bosch/daklekkage/">Den Bosch</a>, <a href="/werkgebied/rosmalen/daklekkage/">Rosmalen</a>, <a href="/werkgebied/berlicum/daklekkage/">Berlicum</a>, <a href="/werkgebied/drunen/daklekkage/">Drunen</a> en <a href="/werkgebied/oss/daklekkage/">Oss</a>.</p>
      <p style="margin-top:12px;">Stormschade aan je dak? Hoe ik dat aanpak, lees je bij stormschade in <a href="/werkgebied/den-bosch/stormschade/">Den Bosch</a>, <a href="/werkgebied/rosmalen/stormschade/">Rosmalen</a>, <a href="/werkgebied/vught/stormschade/">Vught</a>, <a href="/werkgebied/oss/stormschade/">Oss</a>, <a href="/werkgebied/schijndel/stormschade/">Schijndel</a> en <a href="/werkgebied/boxtel/stormschade/">Boxtel</a>. Lekt je dakgoot, lees dan hoe ik een goot repareer in <a href="/werkgebied/den-bosch/dakgoot-vervangen/">Den Bosch</a>, <a href="/werkgebied/vught/dakgoot-vervangen/">Vught</a> en <a href="/werkgebied/veghel/dakgoot-vervangen/">Veghel</a>.</p>
      {dakrepPlaatsen.length > 0 && (
        <p style="margin-top:12px;">Ligt er een pan scheef of zit de nok los? Hoe ik een losse pan of nokvorst vastzet of vervang, lees je per plaats bij dakreparatie in {dakrepPlaatsen.map((p, i) => (<>{i > 0 && (i === dakrepPlaatsen.length - 1 ? " en " : ", ")}<a href={`/werkgebied/${p.slug}/dakreparatie/`}>{p.naam}</a></>))}.</p>
      )}
      {gotenPlaatsen.length > 0 && (
        <p style="margin-top:12px;">Zit je goot vol blad? Hoe ik een volle goot leegmaak en de uitloop vrijmaak, lees je per plaats bij dakgoot schoonmaken in {gotenPlaatsen.map((p, i) => (<>{i > 0 && (i === gotenPlaatsen.length - 1 ? " en " : ", ")}<a href={`/werkgebied/${p.slug}/goten-reinigen/`}>{p.naam}</a></>))}.{gootRepPlaatsen.length > 0 && (<> Een lekkende goot repareer ik ook in {gootRepPlaatsen.map((p, i) => (<>{i > 0 && (i === gootRepPlaatsen.length - 1 ? " en " : ", ")}<a href={`/werkgebied/${p.slug}/dakgoot-vervangen/`}>{p.naam}</a></>))}.</>)}</p>
      )}
      {/* 22-11-2026 ronde 3: In het kort, gelijk aan de andere pagina's, voor Google en AI. */}
      <h3 style="margin-top:28px;">In het kort</h3>
      <ul>
        <li><strong>Wie:</strong> Spoed Dak Service, het bedrijf van {SITE.eigenaar}, dakdekker uit 's-Hertogenbosch. Je belt of appt met {SITE.eigenaar} zelf, niet met een callcenter.</li>
        <li><strong>Klussen:</strong> daklekkage, losse dakpannen en nokvorsten, lood rond schoorsteen en dakraam, dakgoten repareren en schoonmaken, kilgoten en bakgoten, platte daken, golfplaten op een schuur of carport, windveren, stormschade, vogelwering, dakonderhoud en oude antennes of schotels weghalen.</li>
        <li><strong>Waar:</strong> vanuit Den Bosch in de regio Den Bosch en verder in Brabant. Een klus verder weg plan ik vooraf met je in.</li>
        <li><strong>Contact:</strong> bellen of WhatsApp op <a href={telHref}>{SITE.telefoonWeergave}</a>, dag en nacht bereikbaar.</li>
        {/* 26-11-2026 ronde 3: regel Spoed, gelijk aan de dienstpagina's. */}
        <li><strong>Spoed:</strong> druppelt het binnen of ligt er een open plek in je dak, bel of app dan meteen. In de regio Den Bosch kan ik bij spoed vaak nog dezelfde dag komen. Verder weg plan ik een klus meestal vooraf met je in.</li>
        <li><strong>Prijs:</strong> je hoort de vaste prijs voordat ik begin. De richtprijzen staan op de <a href="/prijzen/">prijzen-pagina</a>.</li>
        <li><strong>Betalen:</strong> een kleine klus, zoals een paar losse pannen of een goot leegmaken, betaal je als hij klaar is, via iDEAL. Bij groter werk spreken we vooraf af hoe en wanneer je betaalt.</li>
        <li><strong>Verzekerd:</strong> bedrijfsaansprakelijk verzekerd.</li>
        <li><strong>Reviews:</strong> <a href={SITE.werkspotUrl} target="_blank" rel="noopener">{SITE.reviews.score.toString().replace(".", ",")} op Werkspot</a>{SITE.reviews.werkspotAantal > 0 ? ` (${SITE.reviews.werkspotAantal} reviews)` : ""}.</li>
      </ul>
    </div>
  </section>

  <section class="section section--white"><div class="wrap"><h2>Vragen over mijn werk</h2><div class="faq" style="margin-top:16px; max-width:760px;">{faq.map((f) => (<details><summary>{f.v}</summary><p>{f.a}</p></details>))}</div></div></section>

  <!-- ANDERE VRAAG? (vangnet voor klussen die er niet bij staan) -->
