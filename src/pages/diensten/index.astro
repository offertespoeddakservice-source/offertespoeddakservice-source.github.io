---
import Base from "../../layouts/Base.astro";
import { SITE, telHref, waHref } from "../../site.config.ts";
import { DIENSTEN } from "../../data/diensten.ts";
import DienstIcon from "../../components/DienstIcon.astro";
---

<Base
  title={`Diensten — dakwerk regio Den Bosch | ${SITE.bedrijfsnaam}`}
  description="Alle dakdiensten in de regio Den Bosch: goten reinigen, daklekkage & spoed, dakreparatie, platte daken (EPDM) en stormschade."
  path="/diensten"
>
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow" style="color:#ffb486;">Diensten</p>
      <h1>Voor je hele dak één aanspreekpunt</h1>
      <p class="lead">Van een verstopte goot tot een lekkend dak — ik help je er snel en netjes vanaf, met een eerlijke prijs vooraf.</p>
    </div>
  </section>
  <section class="section">
    <div class="wrap">
      <h2 class="sr-only">Alle dakdiensten</h2>
      <div class="grid grid-3">
        {DIENSTEN.map((d) => (
          <a class="card" href={`/diensten/${d.slug}`}>
            <DienstIcon slug={d.slug} />
            <h3>{d.titel}</h3>
            <p>{d.kort}</p>
            {d.vanafPrijs && <span class="price">{d.vanafPrijs}</span>}
          </a>
        ))}
      </div>
      <p class="notice" style="margin-top:22px;">
        Richtprijzen voor een gemiddelde situatie — je hoort altijd de <strong>vaste prijs vooraf</strong>, en een offerte is <strong>gratis</strong>. Volledige tabel op de <a href="/prijzen">prijzen-pagina</a>.
      </p>
    </div>
  </section>

  <!-- ANDERE VRAAG? (vangnet voor klussen die er niet bij staan) -->
  <section class="section section--navy" style="text-align:center;">
    <div class="wrap" style="max-width:760px;">
      <p class="eyebrow" style="color:#ffb486;">Andere vraag?</p>
      <h2>Staat jouw klus er niet bij?</h2>
      <p class="lead" style="margin:0 auto 22px; color:#c2d2e3;">
        Geen probleem — ik doe zo goed als alles op en rond het dak. Bel of stuur een foto via WhatsApp,
        dan zeg ik eerlijk of ik je kan helpen en wat het ongeveer kost. Een offerte is altijd gratis.
      </p>
      <div class="btn-row" style="justify-content:center;">
        <a class="btn btn--primary" href={telHref}>Bel {SITE.telefoonWeergave}</a>
        <a class="btn btn--wa" href={waHref("Hoi Rens, ik heb een vraag over mijn dak.")}>WhatsApp Rens</a>
      </div>
    </div>
  </section>
</Base>
