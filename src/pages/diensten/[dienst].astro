// Meer weten: twee of drie kennisartikelen per dienst. Bestaat een artikel niet, dan valt het weg.
// 21-11-2026 ronde 5: Meer weten en de zin bovenaan voor de nieuwe dienst dakonderhoud.
const leesVerder: Record<string, string[]> = {
  "goten-reinigen": ["wat-kost-dakgoot-schoonmaken", "hoe-vaak-dakgoot-reinigen", "verstopte-regenpijp-lekkende-dakgoot", "dakgoot-zelf-schoonmaken", "dakgoot-loopt-over", "ijspegels-aan-dakgoot", "vuurwerk-schade-dak", "bladvanger-dakgoot", "dakgoot-schoonmaken-in-de-winter", "dakgoot-schoonmaken-huurder-of-verhuurder", "zand-in-dakgoot", "goot-schoonmaken-glazenwasser-of-dakdekker"],
