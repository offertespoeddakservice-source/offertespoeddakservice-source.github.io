---
import Base from "../../layouts/Base.astro";
import { SITE, telHref, waHref } from "../../site.config.ts";
import { DIENSTEN } from "../../data/diensten.ts";
import { PLAATSEN, getPlaats } from "../../data/plaatsen.ts";
import { MATRIX } from "../../data/matrix.ts";
import { ARTIKELEN } from "../../data/artikelen.ts";
import { PRIJZEN } from "../../data/prijzen.ts";
import DienstIcon from "../../components/DienstIcon.astro";
import EchteFotos from "../../components/EchteFotos.astro";

export function getStaticPaths() {
  return DIENSTEN.map((d) => ({ params: { dienst: d.slug }, props: { d } }));
}

const { d } = Astro.props;
const path = `/diensten/${d.slug}`;
const apkPrijs = PRIJZEN.find((r) => r.dienst.startsWith("Dak-APK"))?.prijs ?? "";

const minPrice = d.vanafPrijs ? Number((d.vanafPrijs.match(/(\d+)/) || [])[1]) : null;
const serviceSchema: Record<string, unknown> = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: d.titel,
  serviceType: d.titel,
  description: d.metaDescription,
  url: `${SITE.url}/diensten/${d.slug}/`,
  provider: { "@type": "RoofingContractor", "@id": `${SITE.url}/#bedrijf`, name: SITE.bedrijfsnaam, telephone: `+${SITE.telefoonE164}` },
  areaServed: [{ "@type": "State", name: "Noord-Brabant" }, ...PLAATSEN.map((p) => ({ "@type": "City", name: p.naam }))],
};
if (minPrice) serviceSchema.offers = { "@type": "Offer", priceSpecification: { "@type": "UnitPriceSpecification", priceCurrency: "EUR", minPrice } };
// Geen losse minPrice bij een prijs per vierkante meter of per paneel: dan zou Google het als prijs voor de hele klus lezen.
if ((d.vanafPrijs ?? "").includes("p/")) delete serviceSchema.offers;
const faqSchema = d.faq.length
  ? {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: d.faq.map((f) => ({ "@type": "Question", name: f.v, acceptedAnswer: { "@type": "Answer", text: f.a } })),
    }
  : null;
const schema = faqSchema ? [serviceSchema, faqSchema] : serviceSchema;
const andere = DIENSTEN.filter((x) => x.slug !== d.slug && !x.verborgen);
// Verborgen diensten hebben geen pagina's per plaats (die worden niet gebouwd), dus ook geen knoppen ernaartoe.
const matrixVoorDienst = d.verborgen ? [] : MATRIX.filter((c) => c.dienst === d.slug)
  .map((c) => getPlaats(c.plaats))
  .filter((p) => p);
const relArtikel = ({
  "goten-reinigen": { label: "Hoe vaak moet je goten reinigen?", href: "/kennisbank/hoe-vaak-dakgoot-reinigen/" },
  "daklekkage": { label: "Daklekkage opsporen zonder sloopwerk", href: "/kennisbank/daklekkage-opsporen/" },
  "dakreparatie": { label: "Wat kost daklekkage repareren?", href: "/kennisbank/wat-kost-daklekkage-repareren/" },
  "platte-daken": { label: "Plat dak: repareren of vervangen?", href: "/kennisbank/plat-dak-vervangen-of-repareren/" },
  "stormschade": { label: "Stormschade: eerste hulp", href: "/kennisbank/stormschade-eerste-hulp/" },
  "dakcoating": { label: "Wat kost dak coaten?", href: "/kennisbank/wat-kost-dak-coaten" },
  "dak-reinigen": { label: "Mos op je dak verwijderen", href: "/kennisbank/mos-op-dak-verwijderen/" },
  "dakpannen-vervangen": { label: "Losse pannen na een storm: eerste hulp", href: "/kennisbank/stormschade-eerste-hulp/" },
  "dakgoot-vervangen": { label: "Dakgoot lekt: bij de naad, de hoek of de regenpijp", href: "/kennisbank/dakgoot-lekt/" },
  "schoorsteen-vegen": { label: "Hoe vaak schoorsteen vegen?", href: "/kennisbank/schoorsteen-vegen-hoe-vaak/" },
  "zonnepanelen-reinigen": { label: "Zonnepanelen reinigen: is het nodig?", href: "/kennisbank/zonnepanelen-reinigen-nodig/" },
} as Record<string, { label: string; href: string }>)[d.slug];
// Meer weten: twee of drie kennisartikelen per dienst. Bestaat een artikel niet, dan valt het weg.
const leesVerder: Record<string, string[]> = {
  "goten-reinigen": ["wat-kost-dakgoot-schoonmaken", "hoe-vaak-dakgoot-reinigen", "verstopte-regenpijp-lekkende-dakgoot", "dakgoot-zelf-schoonmaken", "dakgoot-loopt-over", "ijspegels-aan-dakgoot", "vuurwerk-schade-dak", "bladvanger-dakgoot", "dakgoot-schoonmaken-in-de-winter", "dakgoot-schoonmaken-huurder-of-verhuurder"],
  daklekkage: ["daklekkage-opsporen", "lekdetectie-daklek", "vochtplek-plafond", "plafond-bolt-op-door-lekkage", "water-uit-lamp-plafond", "lekkage-bij-schoorsteen", "wat-kost-daklekkage-repareren", "lekkage-bij-aanbouw", "dak-lekt-bij-sneeuw-of-vorst", "lekkage-muur-buren", "erker-lekt", "dakfolie-kapot", "dak-lekt-na-reparatie", "plafond-drogen-na-lekkage", "nieuw-dak-lekt", "lekkage-dakdekker-of-loodgieter", "lekkage-badkamer-plafond", "lekkage-bij-de-nok", "daklek-hoe-lang-wachten", "verzekering-betaalt-daklekkage-niet", "natte-plek-schuine-wand-zolder"],
  dakreparatie: ["wat-kost-daklekkage-repareren", "nokvorsten-los", "dakpan-kapot-of-verschoven", "dakraam-lekt", "kilgoot-lekt", "lood-op-dak", "dak-lekt-na-reparatie", "offerte-dakdekker-vergelijken", "dak-repareren-in-de-winter", "dakpan-lijmen-of-kitten", "daktermen-uitgelegd", "wat-kost-nokvorsten-repareren", "gevelpannen-los", "lekkage-weggehaalde-schoorsteen", "dak-lekt-na-schoonmaken", "dakdekker-kleine-klus"],
  "platte-daken": ["plat-dak-vervangen-of-repareren", "daktrim-lekt", "water-blijft-staan-op-plat-dak", "lichtkoepel-lekt", "lekkage-bij-aanbouw", "lekkage-bij-zonnepanelen", "dakonderhoud-per-seizoen", "veranda-of-overkapping-lekt", "epdm-dak-lekt", "dakleer-repareren", "dakterras-lekt", "golfplaten-lekken", "plat-dak-onderhouden", "lichtstraat-lekt", "lekkage-warmtepomp-of-airco", "wat-kost-plat-dak-repareren", "plat-dak-lekt-bij-afvoer", "plat-dak-losgewaaid-na-storm", "zachte-plek-plat-dak", "plat-dak-met-grind-lekt"],
  stormschade: ["stormschade-eerste-hulp", "dakpan-kapot-of-verschoven", "dak-lekt-bij-harde-wind", "daklekkage-verzekering", "tak-of-boom-op-dak", "dakpannen-vastzetten-tegen-storm", "dakpannen-klapperen-bij-wind", "windveer-los-of-rot", "storm-op-komst-dak", "dakgoot-losgeraakt", "vuurwerk-schade-dak", "gevelpannen-los", "dakpan-op-auto-buren", "plat-dak-losgewaaid-na-storm"],
  "dakgoot-vervangen": ["dakgoot-lekt", "dakgoot-hangt-door", "water-achter-dakgoot", "natte-plek-bovenin-muur", "bakgoot-lekt", "kilgoot-lekt", "verstopte-regenpijp-lekkende-dakgoot", "hoe-lang-gaat-een-dakgoot-mee", "lekkende-dakgoot-tijdelijk-oplossen", "zinken-dakgoot-lekt", "kunststof-dakgoot-lekt", "dakgoot-lekt-bij-regenpijp", "lekkende-dakgoot-verzekering", "dakgoot-losgeraakt", "gedeelde-dakgoot-lekt", "regenpijp-loost-op-dak"],
  "dakpannen-vervangen": ["dakpan-kapot-of-verschoven", "stormschade-eerste-hulp", "nokvorsten-los", "dak-lekt-bij-harde-wind", "dakpannen-vastzetten-tegen-storm", "vorstschade-dakpannen", "hoe-lang-gaat-een-dak-mee", "dakpannen-klapperen-bij-wind", "windveer-los-of-rot", "welke-dakpan-heb-ik", "dakpan-lijmen-of-kitten", "poreuze-dakpannen", "gevelpannen-los", "dak-nakijken-voor-zonnepanelen", "pannendak-schuur-lekt", "wat-kost-dakpan-vervangen"],
  "schoorsteen-vegen": ["schoorsteen-vegen-hoe-vaak", "lekkage-bij-schoorsteen", "lekkage-gedeelde-schoorsteen", "schoorsteen-lekt-open-haard", "lood-op-dak", "schoorsteen-afdekken"],
  "zonnepanelen-reinigen": ["zonnepanelen-reinigen-nodig", "lekkage-bij-zonnepanelen", "vogels-onder-dakpannen"],
  vogelwering: ["vogels-onder-dakpannen", "lekkage-bij-zonnepanelen", "zonnepanelen-reinigen-nodig", "duiven-onder-zonnepanelen", "dak-nakijken-voor-zonnepanelen"],
  "dak-reinigen": ["mos-op-dak-verwijderen", "dakonderhoud-per-seizoen", "hoe-vaak-dakgoot-reinigen"],
  dakrenovatie: ["dakinspectie", "hoe-lang-gaat-een-dak-mee", "nokvorsten-los", "lood-op-dak", "plat-dak-vervangen-of-repareren", "hoe-herken-je-een-betrouwbare-dakdekker", "offerte-dakdekker-vergelijken", "poreuze-dakpannen", "licht-tussen-dakpannen", "wat-kost-een-dakinspectie", "dak-vernieuwen-rijtjeshuis"],
  dakisolatie: ["condens-of-lekkage-op-zolder", "vochtplek-plafond", "isolatie-nat-na-lekkage"],
  "nokvorsten-vervangen": ["nokvorsten-los", "dakpan-kapot-of-verschoven", "dak-lekt-bij-harde-wind", "dakpannen-klapperen-bij-wind", "licht-tussen-dakpannen", "lekkage-bij-de-nok", "wat-kost-nokvorsten-repareren", "wat-kost-dakpan-vervangen"],
  "lood-vervangen": ["lekkage-bij-schoorsteen", "schoorsteen-lekt-open-haard", "dakraam-lekt", "lood-op-dak", "lekkage-bij-kachelpijp", "lood-van-dak-gestolen", "lekkage-weggehaalde-schoorsteen", "lood-of-loodvervanger"],
  "regenpijp-vervangen": ["verstopte-regenpijp-lekkende-dakgoot", "dakgoot-lekt", "bakgoot-lekt", "dakgoot-lekt-bij-regenpijp", "regenpijp-in-de-muur-lekt", "gedeelde-dakgoot-lekt", "regenpijp-loost-op-dak"],
  dakdoorvoer: ["lekkage-bij-dakdoorvoer", "condens-of-lekkage-op-zolder", "druppelen-horen-plafond", "lekkage-warmtepomp-of-airco", "lekkage-bij-kachelpijp", "lekkage-badkamer-plafond"],
  "windveer-vervangen": ["windveer-los-of-rot", "dakpannen-vastzetten-tegen-storm", "dakpannen-klapperen-bij-wind", "stormschade-eerste-hulp", "storm-op-komst-dak", "gevelpannen-los"],
  "antenne-verwijderen": ["lekkage-bij-schotel-of-antenne", "dak-lekt-bij-harde-wind", "lekkage-bij-schoorsteen", "lood-op-dak"],
  "dakgoot-coaten": ["zinken-dakgoot-lekt", "bakgoot-lekt", "dakgoot-lekt", "hoe-lang-gaat-een-dakgoot-mee", "water-achter-dakgoot"],
  "dakgoot-solderen": ["zinken-dakgoot-lekt", "dakgoot-lekt", "bakgoot-lekt", "dakgoot-lekt-bij-regenpijp", "gedeelde-dakgoot-lekt", "lekkende-dakgoot-tijdelijk-oplossen"],
  "kilgoot-repareren": ["kilgoot-lekt", "lood-op-dak", "dak-lekt-bij-hevige-regen", "zinken-dakgoot-lekt", "dak-lekt-bij-sneeuw-of-vorst", "hoe-vaak-dakgoot-reinigen"],
  "dakbeschot-vervangen": ["zachte-plek-plat-dak", "dakleer-repareren", "water-blijft-staan-op-plat-dak", "plat-dak-vervangen-of-repareren", "lekkage-bij-aanbouw", "wat-kost-plat-dak-repareren"],
};
const leesArtikelen = (leesVerder[d.slug] ?? [])
  .map((s) => ARTIKELEN.find((x) => x.slug === s))
  .filter((x) => x && (d.verborgen || !x.verborgen)) as typeof ARTIKELEN;
// Prijs in de kop: een bedrag krijgt "incl. btw" erbij, zonder bedrag ("stuur een foto") een uitnodiging om een foto te sturen.
const heeftBedrag = !!d.vanafPrijs && d.vanafPrijs.includes("€");
// Echte Werkspot-review bij de klus waar hij over gaat (Rens 25-10: ja, letterlijk met voornaam en plaats zoals op Werkspot). Geen review-schema.
const reviewBij: Record<string, { tekst: string; naam: string; klus: string }> = {
  "dakgoot-vervangen": { tekst: "Prima werk geleverd. Was flexibel in het plannen, dacht mee en kwam met oplossingen.", naam: "Roos, Oosterbeek", klus: "regenpijp vervangen" },
  "goten-reinigen": { tekst: "Dakgoten keurig netjes schoongemaakt zonder de rommel uit de goten op het terras of in de tuin te morsen. Aanrader!", naam: "Ard-Jan, Tiel", klus: "goten reinigen" },
  dakreparatie: { tekst: "Snel en mooi dak geplaatst voor een hele nette prijs. Blij mee!", naam: "F. Spolders, Zoetermeer", klus: "dakreparatie" },
};
const review = reviewBij[d.slug];
// Eén zin bovenaan die Google en AI kunnen overnemen: wie, wat en waar (net als op de plaats- en de plaats x klus-pagina's).
const WAT_PER_DIENST: Record<string, string> = {
  "goten-reinigen": "het schoonmaken van dakgoten",
  daklekkage: "daklekkage opsporen en repareren, ook met spoed",
  dakreparatie: "dakreparaties, zoals losse dakpannen, nokvorsten en lood",
  "platte-daken": "het repareren en vervangen van platte daken",
  stormschade: "het afdekken en herstellen van stormschade aan je dak",
  "dakgoot-vervangen": "het repareren en vervangen van dakgoten",
  "dakpannen-vervangen": "het vervangen en rechtleggen van dakpannen",
  "nokvorsten-vervangen": "het repareren en vervangen van nokvorsten",
  "lood-vervangen": "het vastzetten en vervangen van lood bij de schoorsteen, de muur en het dakraam",
  "regenpijp-vervangen": "het vervangen en repareren van regenpijpen",
  dakdoorvoer: "het plaatsen en repareren van dakdoorvoeren",
  vogelwering: "vogelwering onder dakpannen en zonnepanelen",
  dakrenovatie: "het opknappen van een versleten dak (dakrenovatie)",
  "windveer-vervangen": "het vastzetten en vervangen van een losse of rotte windveer",
  "antenne-verwijderen": "het weghalen van een oude antenne of schotel en het dichtmaken van het dak",
  "dakgoot-coaten": "het van binnen coaten van lekkende dakgoten en bakgoten",
  "dakgoot-solderen": "het solderen van lekkende naden, hoeken en uitlopen in zinken dakgoten en bakgoten",
  "kilgoot-repareren": "het repareren en vervangen van kilgoten",
  "dakbeschot-vervangen": "het vervangen van rot dakbeschot onder het platte dak van een schuur, garage of aanbouw"
};
const watZin = WAT_PER_DIENST[d.slug] ?? d.titel.toLowerCase();
// Knoppen naar de pagina's per plaats: de namen waarop mensen zoeken, net als op de plaatspagina's.
const KNOP_NAAM: Record<string, string> = { "goten-reinigen": "Dakgoot schoonmaken", "dakgoot-vervangen": "Dakgoot repareren of vervangen", daklekkage: "Daklekkage" };
---

<Base title={d.metaTitle} description={d.metaDescription} path={path} schema={schema} noindex={d.verborgen === true}>
  <section class="hero">
    <div class="wrap">
      <div class="topline">
        <span class="eyebrow" style="color:#ffb486; margin:0;">{d.titel} · regio Den Bosch en verder in Brabant</span>
        <span class="stars"><span class="ster">★★★★★</span> <b>{SITE.reviews.score.toString().replace(".", ",")}</b> <a class="bron" href={SITE.werkspotUrl} target="_blank" rel="noopener">op Werkspot</a></span>
      </div>
      <h1>{d.h1}</h1>
      {!d.verborgen && <p class="lead" style="margin-bottom:12px;">Spoed Dak Service is een dakdekker uit 's-Hertogenbosch voor {watZin} in de regio Den Bosch en verder in Brabant.</p>}
      <p class="lead">{d.intro}</p>
      {heeftBedrag ? (
        <p style="margin:16px 0 0; font-size:1.1rem; color:#fff;">
          <strong style="font-family:var(--font-display);">Prijsindicatie: <span style="color:var(--orange);">{d.vanafPrijs} incl. btw</span></strong>
          <span style="color:#c2d2e3;">, vaste prijs vooraf, je hoort het bedrag voordat ik begin. Offerte is gratis.</span>
        </p>
      ) : d.vanafPrijs && !d.verborgen && (
        <p style="margin:16px 0 0; font-size:1.1rem; color:#fff;">
          <strong style="font-family:var(--font-display);">Wat kost het? <span style="color:var(--orange);">Stuur een foto</span></strong>
          <span style="color:#c2d2e3;">, dan hoor je wat het kost. De vaste prijs hoor je voordat ik begin. Offerte is gratis.</span>
        </p>
      )}
      <div class="btn-row" style="margin-top:22px;">
        {!d.verborgen && <a class="btn btn--primary" href="/quiz/">Gratis prijsindicatie, vaak binnen 10 minuten</a>}
        <a class="btn btn--wa" href={waHref(`Hallo, ik heb een vraag over ${d.titel.toLowerCase()}. Ik stuur een foto mee.`)}>Stuur een foto via WhatsApp</a>
        {d.verborgen && <a class="btn btn--primary" href={telHref}>Bel {SITE.telefoonWeergave}</a>}
      </div>
      {!d.geenAfbeelding && <img src={d.afbeelding ?? `/img/${d.slug}.jpg`} alt={`${d.titel}, Spoed Dak Service`} loading="eager" fetchpriority="high" width="1000" height="746" style="margin-top:28px;border-radius:12px;width:100%;max-width:820px;height:auto;display:block;" />}
    </div>
  </section>

  <section class="section">
    <div class="wrap split">
      <div class="prose">
        <h2>Wat ik voor je doe</h2>
        <ul class="checks">
          {d.punten.map((p) => <li>{p}</li>)}
        </ul>
        <p>
          Werk je liever met één vast aanspreekpunt voor je hele dak? Dat is precies wat ik bied:
          ik kom langs, leg uit wat ik zie, en je krijgt een vaste prijs vooraf. Geen callcenter,
          geen verrassingen.
        </p>
        {leesArtikelen.length > 0 ? (
          <>
            <p style="margin-top:18px;"><strong>Meer weten?</strong> Lees ook:</p>
            <ul>
              {leesArtikelen.map((x) => <li><a href={`/kennisbank/${x.slug}/`}>{x.titel}</a></li>)}
            </ul>
          </>
        ) : relArtikel && (
          <p style="margin-top:18px;"><strong>Meer weten?</strong> Lees: <a href={relArtikel.href.endsWith("/") ? relArtikel.href : relArtikel.href + "/"}>{relArtikel.label}</a></p>
        )}
        {d.zieOok && d.zieOok.length > 0 && (
          <>
            <p style="margin-top:18px;"><strong>Hoort hier ook bij:</strong></p>
            <ul>
              {d.zieOok.map((z) => <li><a href={z.href}>{z.label}</a></li>)}
            </ul>
          </>
        )}
        {review && (
          <figure class="reviewkaart" style="margin:20px 0 0;">
            <span class="rster" aria-label="5 van 5 sterren">★★★★★</span>
            <blockquote>„{review.tekst}"</blockquote>
            <figcaption>{review.naam} · {review.klus} · <a href={SITE.werkspotUrl} target="_blank" rel="noopener">op Werkspot</a></figcaption>
          </figure>
        )}
      </div>
      <aside>
        <div class="card">
          <h3>Direct contact</h3>
          <p>Bel of WhatsApp voor een vaste prijs, of vraag de <a href="/dak-apk/">Dak-APK</a> aan (voor {apkPrijs}) voor een compleet keuringsrapport in {SITE.regioOmschrijving}.</p>
          <div class="btn-row" style="margin-top:14px; flex-direction:column;">
            <a class="btn btn--wa" href={waHref(`Hallo, ik heb een vraag over ${d.titel.toLowerCase()}.`)}>WhatsApp Rens</a>
            <a class="btn btn--primary" href={telHref}>{SITE.telefoonWeergave}</a>
            <a class="btn btn--outline" href="/contact/">Offerte aanvragen</a>
          </div>
        </div>
      </aside>
    </div>
  </section>

  {d.fotos ? <EchteFotos dienst={d.slug} bestanden={d.fotos} /> : <EchteFotos dienst={d.slug} />}

  {d.faq.length > 0 && (
    <section class="section section--soft">
      <div class="wrap">
        <h2>Veelgestelde vragen over {d.titel.toLowerCase()}</h2>
        <div class="faq" style="margin-top:16px; max-width:760px;">
          {d.faq.map((f) => (
            <details>
              <summary>{f.v}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
        <p style="margin-top:18px; max-width:760px;">Staat je vraag er niet bij? Stuur me een appje met een foto via <a href={waHref(`Hallo, ik heb een vraag over ${d.titel.toLowerCase()}.`)}>WhatsApp</a> of bel <a href={telHref}>{SITE.telefoonWeergave}</a>, dan kijk ik met je mee.</p>
      </div>
    </section>
  )}

  <section class="section section--white">
    <div class="wrap">
      <h2>{d.titel} in de regio Den Bosch</h2>
      {matrixVoorDienst.length > 0 && (
        <>
          <p class="lead">Direct naar {d.titel.toLowerCase()} in jouw plaats:</p>
          <div class="chips" style="margin-bottom:18px;">
            {matrixVoorDienst.map((p) => <a class="chip" href={`/werkgebied/${p.slug}/${d.slug}/`}>{KNOP_NAAM[d.slug] ?? d.titel} in {p.naam}</a>)}
          </div>
        </>
      )}
      <p class="lead">Heel mijn werkgebied. Kies je plaats:</p>
      <div class="chips">
        {PLAATSEN.map((p) => <a class="chip" href={`/werkgebied/${p.slug}/`}>{p.naam}</a>)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>Andere diensten</h2>
      <div class="grid grid-3" style="margin-top:18px;">
        {andere.map((x) => (
          <a class="card" href={`/diensten/${x.slug}/`}>
            <DienstIcon slug={x.slug} />
            <h3>{x.titel}</h3>
            <p>{x.kort}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>
