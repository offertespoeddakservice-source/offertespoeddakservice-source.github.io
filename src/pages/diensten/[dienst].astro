  "lood-vervangen": ["lekkage-bij-schoorsteen", "schoorsteen-lekt-open-haard", "dakraam-lekt", "lood-op-dak", "lekkage-bij-kachelpijp", "lood-van-dak-gestolen", "lekkage-weggehaalde-schoorsteen", "lood-of-loodvervanger", "vochtplek-schoorsteen-binnen", "schuin-dak-aanbouw-lekt", "zolder-nat-langs-zijmuur"],
  "dakraam-lekkage": ["dakraam-lekt", "condens-of-lekkage-op-zolder", "dak-lekt-bij-harde-wind", "lood-op-dak", "lood-of-loodvervanger", "lichtkoepel-lekt", "lekt-sinds-nieuw-dakraam"],
  "regenpijp-vervangen": ["verstopte-regenpijp-lekkende-dakgoot", "regenpijp-kapot-door-vorst", "dakgoot-lekt", "bakgoot-lekt", "dakgoot-lekt-bij-regenpijp", "regenpijp-in-de-muur-lekt", "gedeelde-dakgoot-lekt", "regenpijp-loost-op-dak"],
  dakdoorvoer: ["lekkage-bij-dakdoorvoer", "condens-of-lekkage-op-zolder", "druppelen-horen-plafond", "lekkage-warmtepomp-of-airco", "lekkage-bij-kachelpijp", "lekkage-badkamer-plafond", "cv-ketel-lekt-bij-regen", "afzuigkap-lekt-bij-regen"],
  "windveer-vervangen": ["windveer-los-of-rot", "dakpannen-vastzetten-tegen-storm", "dakpannen-klapperen-bij-wind", "stormschade-eerste-hulp", "storm-op-komst-dak", "gevelpannen-los", "zolder-nat-langs-zijmuur"],
  "antenne-verwijderen": ["lekkage-bij-schotel-of-antenne", "dak-lekt-bij-harde-wind", "lekkage-bij-schoorsteen", "lood-op-dak"],
  "dakgoot-coaten": ["zinken-dakgoot-lekt", "bakgoot-lekt", "dakgoot-lekt", "hoe-lang-gaat-een-dakgoot-mee", "water-achter-dakgoot", "mastgoot-lekt"],
  "dakgoot-solderen": ["zinken-dakgoot-lekt", "dakgoot-lekt", "bakgoot-lekt", "dakgoot-lekt-bij-regenpijp", "gedeelde-dakgoot-lekt", "lekkende-dakgoot-tijdelijk-oplossen", "dakgoot-lekt-na-schoonmaken"],
