  "kilgoot-repareren": ["kilgoot-lekt", "lood-op-dak", "dak-lekt-bij-hevige-regen", "zinken-dakgoot-lekt", "dak-lekt-bij-sneeuw-of-vorst", "hoe-vaak-dakgoot-reinigen", "hoekkeper-lekt", "jaren-30-huis-dak-lekt"],
  "dakbeschot-vervangen": ["zachte-plek-plat-dak", "dakleer-repareren", "water-blijft-staan-op-plat-dak", "plat-dak-vervangen-of-repareren", "lekkage-bij-aanbouw", "wat-kost-plat-dak-repareren"],
  "golfplaten-vervangen": ["golfplaten-lekken", "welke-golfplaten-heb-ik", "pannendak-schuur-lekt", "garagebox-dak-lekt", "veranda-of-overkapping-lekt", "hagelschade-dak", "dakleer-repareren"],
  dakonderhoud: ["dakonderhoud-per-seizoen", "dak-winterklaar-maken", "hoe-vaak-dakgoot-reinigen", "plat-dak-onderhouden", "nokvorsten-los", "lood-op-dak", "noodoverloop-plat-dak", "plat-dak-met-grind-lekt", "regenpijp-loost-op-dak", "hoe-lang-gaat-een-dak-mee", "dakinspectie", "welke-vakman-voor-je-dak"],
