const gootHerkenBestaat = ARTIKELEN.some((a) => a.slug === "welke-dakgoot-heb-ik" && !a.verborgen);
const platHerkenBestaat = ARTIKELEN.some((a) => a.slug === "welke-dakbedekking-heb-ik" && !a.verborgen);
// 23-11-2026 ronde 3: per dienst één gewone zin naar een kennisartikel dat bij die klus hoort en weinig binnenkomende links heeft (dakkapel lekt 9, regenton 18, vergaarbak 23, zakgoot 25, ventilatiepan 29, garagebox 29, bliksem 38). Alleen als elk artikel in de zin bestaat en zichtbaar is.
const OOK_HANDIG: Record<string, { slugs: string[]; html: string }> = {
  "dakraam-lekkage": { slugs: ["dakkapel-lekt"], html: `Lekt het niet bij een dakraam, maar bij je dakkapel, aan de zijkant, onder het raam of op het platte dakje erop? Lees dan <a href="/kennisbank/dakkapel-lekt/">dakkapel lekt</a>.` },
  "antenne-verwijderen": { slugs: ["blikseminslag-dak"], html: `Is de bliksem ingeslagen in je antenne of schotel? Wat je dan eerst doet en waar je naar kijkt, lees je in <a href="/kennisbank/blikseminslag-dak/">bliksem op je dak</a>.` },
  "regenpijp-vervangen": { slugs: ["vergaarbak-lekt", "goot-loopt-over-door-regenton"], html: `Zit er bovenaan je regenpijp een bak die overloopt, of onderaan een regenton? Lees dan <a href="/kennisbank/vergaarbak-lekt/">vergaarbak lekt of loopt over</a> en <a href="/kennisbank/goot-loopt-over-door-regenton/">goot loopt over door een regenton</a>.` },
  dakdoorvoer: { slugs: ["ventilatiepan-lekt"], html: `Zit er op die plek geen pijp, maar een pan met een roostertje, en druppelt het daaronder? Lees dan <a href="/kennisbank/ventilatiepan-lekt/">lekkage bij een ventilatiepan</a>.` },
  "dakbeschot-vervangen": { slugs: ["garagebox-dak-lekt"], html: `Gaat het om het platte dak van een garagebox in een rij? Lees dan <a href="/kennisbank/garagebox-dak-lekt/">het dak van je garagebox lekt</a>.` },
  "kilgoot-repareren": { slugs: ["zakgoot-lekt"], html: `Ligt je goot niet schuin in de hoek van het dak, maar bijna vlak tussen twee daken? Dan is het een zakgoot. Lees <a href="/kennisbank/zakgoot-lekt/">zakgoot lekt</a>.` },
};
const ookHandig = OOK_HANDIG[d.slug] && OOK_HANDIG[d.slug].slugs.every((s) => ARTIKELEN.some((a) => a.slug === s && !a.verborgen)) ? OOK_HANDIG[d.slug] : undefined;
---

<Base title={d.metaTitle} description={d.metaDescription} path={path} schema={schema} noindex={d.verborgen === true}>
  <section class="hero">
    <div class="wrap">
      <div class="topline">
        <span class="eyebrow" style="color:#ffb486; margin:0;">{d.titel} · regio Den Bosch en verder in Brabant</span>
        <span class="stars"><span class="ster">★★★★★</span> <b>{SITE.reviews.score.toString().replace(".", ",")}</b> <a class="bron" href={SITE.werkspotUrl} target="_blank" rel="noopener">op Werkspot</a></span>
      </div>
      <h1>{d.h1}</h1>
      {!d.verborgen && <p class="lead" style="margin-bottom:12px;">Spoed Dak Service is een dakdekker uit 's-Hertogenbosch voor {watZin} in de regio Den Bosch en verder in Brabant.</p>}
      <p class="lead">{d.intro}</p>
      {heeftBedrag ? (
        <p style="margin:16px 0 0; font-size:1.1rem; color:#fff;">
          <strong style="font-family:var(--font-display);">Prijsindicatie: <span style="color:var(--orange);">{d.vanafPrijs} incl. btw</span></strong>
          <span style="color:#c2d2e3;">, vaste prijs vooraf, je hoort het bedrag voordat ik begin. Offerte is gratis.</span>
        </p>
      ) : d.vanafPrijs && !d.verborgen && (
        <p style="margin:16px 0 0; font-size:1.1rem; color:#fff;">
          <strong style="font-family:var(--font-display);">Wat kost het? <span style="color:var(--orange);">Stuur een foto</span></strong>
          <span style="color:#c2d2e3;">, dan hoor je wat het kost. De vaste prijs hoor je voordat ik begin. Offerte is gratis.</span>
        </p>
      )}
      <div class="btn-row" style="margin-top:22px;">
        {!d.verborgen && <a class="btn btn--primary" href="/quiz/">Gratis prijsindicatie, vaak binnen 10 minuten</a>}
        <a class="btn btn--wa" href={waHref(`Hallo, ik heb een vraag over ${d.titel.toLowerCase()}. Ik stuur een foto mee.`)}>Stuur een foto via WhatsApp</a>
        {/* 21-11-2026 ronde 2: bij de spoed-diensten ook bovenaan een belknop, naast de quiz en WhatsApp. */}
        {(d.verborgen || SPOED_DIENSTEN.includes(d.slug)) && <a class="btn btn--primary" href={telHref}>Bel {SITE.telefoonWeergave}</a>}
      </div>
      {!d.geenAfbeelding && <img src={d.afbeelding ?? `/img/${d.slug}.jpg`} alt={`${d.titel}, Spoed Dak Service`} loading="eager" fetchpriority="high" width="1000" height="746" style="margin-top:28px;border-radius:12px;width:100%;max-width:820px;height:auto;display:block;" />}
    </div>
  </section>

  <section class="section">
    <div class="wrap split">
      <div class="prose">
        <h2>Wat ik voor je doe</h2>
        <ul class="checks">
          {d.punten.map((p) => <li>{p}</li>)}
        </ul>
        <p>
          Werk je liever met één vast aanspreekpunt voor je hele dak? Dat is precies wat ik bied:
          ik kom langs, leg uit wat ik zie, en je krijgt een vaste prijs vooraf. Geen callcenter,
          geen verrassingen.
        </p>
        {leesArtikelen.length > 0 ? (
          <>
            <p style="margin-top:18px;"><strong>Meer weten?</strong> Lees ook:</p>
            <ul>
              {leesArtikelen.map((x) => <li><a href={`/kennisbank/${x.slug}/`}>{x.titel}</a></li>)}
            </ul>
          </>
        ) : relArtikel && (
          <p style="margin-top:18px;"><strong>Meer weten?</strong> Lees: <a href={relArtikel.href.endsWith("/") ? relArtikel.href : relArtikel.href + "/"}>{relArtikel.label}</a></p>
        )}
        {d.zieOok && d.zieOok.length > 0 && (
          <>
            <p style="margin-top:18px;"><strong>Hoort hier ook bij:</strong></p>
            <ul>
              {d.zieOok.map((z) => <li><a href={z.href}>{z.label}</a></li>)}
            </ul>
          </>
        )}
        {HERKEN_GOOT.includes(d.slug) && gootHerkenBestaat && <p style="margin-top:18px;">Weet je niet wat voor goot er aan je huis hangt, een hangende goot van zink of kunststof, een bakgoot of een mastgoot? Lees dan <a href="/kennisbank/welke-dakgoot-heb-ik/">welke dakgoot heb ik</a>, en stuur me daarna een foto.</p>}
        {HERKEN_PLAT.includes(d.slug) && platHerkenBestaat && <p style="margin-top:18px;">Weet je niet wat er op je platte dak ligt, bitumen, EPDM, grind of kunststof? Lees dan <a href="/kennisbank/welke-dakbedekking-heb-ik/">welke dakbedekking ligt er op je platte dak</a>, en stuur me daarna een foto vanuit een raam boven.</p>}
        {ookHandig && <p style="margin-top:18px;" set:html={ookHandig.html} />}
        {review && (
          <figure class="reviewkaart" style="margin:20px 0 0;">
            <span class="rster" aria-label="5 van 5 sterren">★★★★★</span>
            <blockquote>„{review.tekst}"</blockquote>
            <figcaption>{review.naam} · {review.klus} · <a href={SITE.werkspotUrl} target="_blank" rel="noopener">op Werkspot</a></figcaption>
          </figure>
        )}
        {!d.verborgen && (
          <>
            <h3 style="margin-top:22px;">In het kort</h3>
            <ul>
              <li><strong>Wie:</strong> Spoed Dak Service, het bedrijf van {SITE.eigenaar}, dakdekker uit 's-Hertogenbosch.</li>
              <li><strong>Klus:</strong> {d.titel}.</li>
              <li><strong>Waar:</strong> vanuit 's-Hertogenbosch in de regio Den Bosch, verder in Brabant en in Gelderland rond Wijchen en Nijmegen. Een klus verder weg plan ik vooraf met je in. Zie <a href="/werkgebied/">mijn werkgebied</a>.</li>
              <li><strong>Contact:</strong> bellen of WhatsApp op <a href={telHref}>{SITE.telefoonWeergave}</a>, dag en nacht bereikbaar.</li>
              {SPOED_DIENSTEN.includes(d.slug) && <li><strong>Spoed:</strong> druppelt het binnen of ligt er een open plek in je dak, bel of app dan meteen. In de regio Den Bosch kan ik bij spoed vaak nog dezelfde dag komen. Verder weg plan ik een klus meestal vooraf met je in.</li>}
              <li><strong>Prijs:</strong> je hoort de vaste prijs voordat ik begin.</li>
              {/* 21-11-2026 ronde 4: regel Betalen, gelijk aan de vraag 'Hoe betaal ik?' op de homepage en llms.txt. */}
              <li><strong>Betalen:</strong> een kleine klus, zoals een paar losse pannen of een goot leegmaken, betaal je als hij klaar is, via iDEAL. Bij groter werk spreken we vooraf af hoe en wanneer je betaalt.</li>
              <li><strong>Verzekerd:</strong> bedrijfsaansprakelijk verzekerd.</li>
              <li><strong>Reviews:</strong> <a href={SITE.werkspotUrl} target="_blank" rel="noopener">{SITE.reviews.score.toString().replace(".", ",")} op Werkspot</a>{SITE.reviews.werkspotAantal > 0 ? ` (${SITE.reviews.werkspotAantal} reviews)` : ""}.</li>
            </ul>
          </>
        )}
      </div>
      <aside>
        <div class="card">
          <h3>Direct contact</h3>
          <p>Bel of WhatsApp voor een vaste prijs, of vraag de <a href="/dak-apk/">Dak-APK</a> aan (voor {apkPrijs}) voor een compleet keuringsrapport in de regio Den Bosch en verder in Brabant.</p>
          <div class="btn-row" style="margin-top:14px; flex-direction:column;">
            <a class="btn btn--wa" href={waHref(`Hallo, ik heb een vraag over ${d.titel.toLowerCase()}.`)}>WhatsApp Rens</a>
            <a class="btn btn--primary" href={telHref}>{SITE.telefoonWeergave}</a>
            <a class="btn btn--outline" href="/contact/">Offerte aanvragen</a>
          </div>
        </div>
      </aside>
    </div>
  </section>

  {d.fotos ? <EchteFotos dienst={d.slug} bestanden={d.fotos} /> : <EchteFotos dienst={d.slug} />}
  {/* 19-11-2026 ronde 4: link naar alle echte foto's van Rens op /mijn-werk/. */}
  {!d.verborgen && (
    <div class="wrap" style="margin-top:12px; margin-bottom:12px;">
      <p>Foto's van mijn eigen klussen, van pannen en lood tot goten en vogelwering, zie je op <a href="/mijn-werk/">foto's van mijn werk</a>.</p>
    </div>
  )}

  {d.faq.length > 0 && (
    <section class="section section--soft">
      <div class="wrap">
        <h2>Veelgestelde vragen over {d.titel.toLowerCase()}</h2>
        <div class="faq" style="margin-top:16px; max-width:760px;">
          {d.faq.map((f) => (
            <details>
              <summary>{f.v}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
        <p style="margin-top:18px; max-width:760px;">Staat je vraag er niet bij? Stuur me een appje met een foto via <a href={waHref(`Hallo, ik heb een vraag over ${d.titel.toLowerCase()}.`)}>WhatsApp</a> of bel <a href={telHref}>{SITE.telefoonWeergave}</a>, dan kijk ik met je mee.</p>
      </div>
    </section>
  )}

  <section class="section section--white">
    <div class="wrap">
      <h2>{d.titel} in de regio Den Bosch</h2>
      {matrixVoorDienst.length > 0 && (
        <>
          <p class="lead">Direct naar {d.titel.toLowerCase()} in jouw plaats:</p>
          <div class="chips" style="margin-bottom:18px;">
            {matrixVoorDienst.map((p) => <a class="chip" href={`/werkgebied/${p.slug}/${d.slug}/`}>{KNOP_NAAM[d.slug] ?? d.titel} in {p.naam}</a>)}
          </div>
        </>
      )}
      {matrixVia.length > 0 && (
        <>
          <p class="lead">{viaNaam} bij jou in de buurt:</p>
          <div class="chips" style="margin-bottom:18px;">
            {matrixVia.map((p) => <a class="chip" href={`/werkgebied/${p!.slug}/${viaDienst}/`}>{viaNaam} in {p!.naam}</a>)}
          </div>
        </>
      )}
      <p class="lead">Heel mijn werkgebied. Kies je plaats:</p>
      <div class="chips">
        {PLAATSEN.map((p) => <a class="chip" href={`/werkgebied/${p.slug}/`}>{p.naam}</a>)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>Andere diensten</h2>
      <div class="grid grid-3" style="margin-top:18px;">
        {andere.map((x) => (
          <a class="card" href={`/diensten/${x.slug}/`}>
            <DienstIcon slug={x.slug} />
            <h3>{x.titel}</h3>
            <p>{x.kort}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>
