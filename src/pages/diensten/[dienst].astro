  stormschade: ["stormschade-eerste-hulp", "dakpan-kapot-of-verschoven", "dak-lekt-bij-harde-wind", "daklekkage-verzekering", "tak-of-boom-op-dak", "dakpannen-vastzetten-tegen-storm", "dakpannen-klapperen-bij-wind", "windveer-los-of-rot", "storm-op-komst-dak", "dakgoot-losgeraakt", "vuurwerk-schade-dak", "gevelpannen-los", "dakpan-op-auto-buren", "plat-dak-losgewaaid-na-storm", "wachten-op-dakdekker-na-storm", "dak-fluit-bij-harde-wind", "hagelschade-dak", "noodreparatie-dak"],
  "dakgoot-vervangen": ["dakgoot-lekt", "dakgoot-hangt-door", "water-achter-dakgoot", "natte-plek-bovenin-muur", "bakgoot-lekt", "kilgoot-lekt", "verstopte-regenpijp-lekkende-dakgoot", "hoe-lang-gaat-een-dakgoot-mee", "lekkende-dakgoot-tijdelijk-oplossen", "zinken-dakgoot-lekt", "kunststof-dakgoot-lekt", "dakgoot-lekt-bij-regenpijp", "lekkende-dakgoot-verzekering", "dakgoot-losgeraakt", "gedeelde-dakgoot-lekt", "regenpijp-loost-op-dak", "lekt-sinds-nieuwe-dakgoot", "dakgoot-lekt-na-schoonmaken"],
  "dakpannen-vervangen": ["dakpan-kapot-of-verschoven", "stormschade-eerste-hulp", "nokvorsten-los", "dak-lekt-bij-harde-wind", "dakpannen-vastzetten-tegen-storm", "vorstschade-dakpannen", "hoe-lang-gaat-een-dak-mee", "dakpannen-klapperen-bij-wind", "windveer-los-of-rot", "welke-dakpan-heb-ik", "dakpan-lijmen-of-kitten", "poreuze-dakpannen", "gevelpannen-los", "dak-nakijken-voor-zonnepanelen", "pannendak-schuur-lekt", "wat-kost-dakpan-vervangen", "dakpannen-zakken-af", "hagelschade-dak", "boerderij-dak-lekt"],
  "schoorsteen-vegen": ["schoorsteen-vegen-hoe-vaak", "lekkage-bij-schoorsteen", "lekkage-gedeelde-schoorsteen", "schoorsteen-lekt-open-haard", "lood-op-dak", "schoorsteen-afdekken"],
  "zonnepanelen-reinigen": ["zonnepanelen-reinigen-nodig", "lekkage-bij-zonnepanelen", "vogels-onder-dakpannen"],
  vogelwering: ["vogels-onder-dakpannen", "lekkage-bij-zonnepanelen", "zonnepanelen-reinigen-nodig", "duiven-onder-zonnepanelen", "dak-nakijken-voor-zonnepanelen", "kraaien-mos-van-dak"],
  "dak-reinigen": ["mos-op-dak-verwijderen", "dakonderhoud-per-seizoen", "hoe-vaak-dakgoot-reinigen"],
