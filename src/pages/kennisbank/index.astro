---
import Base from "../../layouts/Base.astro";
import { SITE } from "../../site.config.ts";
import { ARTIKELEN } from "../../data/artikelen.ts";
// Kennisbank in groepjes per onderwerp, lekkage eerst. Artikelen die nergens in staan komen in de laatste groep.
const GROEPEN: { kop: string; slugs: string[] }[] = [
  { kop: "Lekt je dak?", slugs: ["daklek-tijdelijk-dichten", "daklekkage-opsporen", "vochtplek-plafond", "natte-plek-bovenin-muur", "plafond-bolt-op-door-lekkage", "water-uit-lamp-plafond", "druppelen-horen-plafond", "lekkage-dakdekker-of-loodgieter", "dak-lekt-bij-hevige-regen", "dak-lekt-bij-harde-wind", "dak-lekt-bij-sneeuw-of-vorst", "dak-repareren-in-de-winter", "dakraam-lekt", "dakkapel-lekt", "glazen-dakpan-lekt", "erker-lekt", "lekkage-bij-schoorsteen", "schoorsteen-lekt-open-haard", "lekkage-gedeelde-schoorsteen", "lekkage-weggehaalde-schoorsteen", "kilgoot-lekt", "lekkage-bij-zonnepanelen", "lekkage-bij-dakdoorvoer", "lekkage-bij-schotel-of-antenne", "lood-op-dak", "lekkage-muur-buren", "condens-of-lekkage-op-zolder", "dakfolie-kapot", "licht-tussen-dakpannen", "nat-achter-knieschot", "isolatie-nat-na-lekkage", "plafond-drogen-na-lekkage", "dak-lekt-na-reparatie", "daklekkage-verzekering", "verzekering-betaalt-daklekkage-niet", "lekkage-huurhuis", "nieuw-dak-lekt", "huis-gekocht-dak-lekt", "wat-kost-daklekkage-repareren", "lekkage-bij-de-nok", "lekkage-badkamer-plafond", "lekkage-bij-kachelpijp", "lekkage-warmtepomp-of-airco", "lood-van-dak-gestolen", "daklek-hoe-lang-wachten", "lekkage-na-dakwerk-buren"] },
  { kop: "Dakgoten: vol, lek of kapot", slugs: ["dakgoot-lekt", "dakgoot-loopt-over", "ijspegels-aan-dakgoot","dakgoot-lekt-bij-regenpijp", "gedeelde-dakgoot-lekt", "lekkende-dakgoot-tijdelijk-oplossen", "zinken-dakgoot-lekt", "kunststof-dakgoot-lekt", "dakgoot-hangt-door", "dakgoot-losgeraakt", "water-achter-dakgoot", "bakgoot-lekt", "hoe-lang-gaat-een-dakgoot-mee", "dakgoot-zink-of-kunststof", "verstopte-regenpijp-lekkende-dakgoot", "regenpijp-in-de-muur-lekt", "lekkende-dakgoot-verzekering", "hoe-vaak-dakgoot-reinigen", "dakgoot-zelf-schoonmaken", "bladvanger-dakgoot", "dakgoot-schoonmaken-in-de-winter", "dakgoot-schoonmaken-huurder-of-verhuurder", "wat-kost-dakgoot-schoonmaken"] },
  { kop: "Na een storm", slugs: ["stormschade-eerste-hulp", "nokvorsten-los", "dakpan-kapot-of-verschoven", "tak-of-boom-op-dak", "dakpannen-vastzetten-tegen-storm", "dakpannen-klapperen-bij-wind", "windveer-los-of-rot", "gevelpannen-los", "schoorsteen-na-storm", "dakpan-op-auto-buren", "plat-dak-losgewaaid-na-storm", "storm-op-komst-dak"] },
  { kop: "Platte daken", slugs: ["plat-dak-vervangen-of-repareren", "epdm-dak-lekt", "dakterras-lekt", "daktrim-lekt", "dakleer-repareren", "water-blijft-staan-op-plat-dak", "zachte-plek-plat-dak", "plat-dak-lekt-bij-afvoer", "lichtkoepel-lekt", "lichtstraat-lekt", "lekkage-bij-aanbouw", "veranda-of-overkapping-lekt", "golfplaten-lekken", "wat-kost-plat-dak-repareren"] },
  { kop: "Onderhoud, kosten en een goede dakdekker", slugs: ["dakinspectie", "wat-kost-een-dakinspectie", "dak-keuren-bij-huis-kopen", "dakonderhoud-per-seizoen", "daktermen-uitgelegd", "hoe-lang-gaat-een-dak-mee", "poreuze-dakpannen", "welke-dakpan-heb-ik", "mos-op-dak-verwijderen", "schoorsteen-vegen-hoe-vaak", "schoorsteen-afdekken", "zonnepanelen-reinigen-nodig", "wat-kost-een-dakdekker", "hoe-herken-je-een-betrouwbare-dakdekker", "dakdekker-aan-de-deur", "offerte-dakdekker-vergelijken", "wat-kost-nokvorsten-repareren", "vuurwerk-schade-dak"] },
];
const zichtbaar = ARTIKELEN.filter((a) => !a.verborgen);
const ingedeeld = new Set(GROEPEN.flatMap((g) => g.slugs));
const overig = zichtbaar.filter((a) => !ingedeeld.has(a.slug));
const groepen = GROEPEN.map((g, i) => ({
  kop: g.kop,
  artikelen: [...g.slugs.map((s) => zichtbaar.find((a) => a.slug === s)).filter((a) => a), ...(i === GROEPEN.length - 1 ? overig : [])] as typeof ARTIKELEN,
}));
// Gestructureerde gegevens: de kennisbank als verzameling, met alle zichtbare artikelen in de volgorde van de pagina.
const lijstSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Daktips & eerlijke uitleg",
  url: `${SITE.url}/kennisbank/`,
  inLanguage: "nl-NL",
  publisher: { "@id": `${SITE.url}/#bedrijf` },
  mainEntity: {
    "@type": "ItemList",
    itemListElement: groepen.flatMap((g) => g.artikelen).map((a, i) => ({ "@type": "ListItem", position: i + 1, url: `${SITE.url}/kennisbank/${a.slug}/`, name: a.titel })),
  },
};
---

<Base
  title={`Daktips: lekkage, goten en storm | ${SITE.bedrijfsnaam}`}
  description="Eerlijke daktips van dakdekker Rens: daklekkage opsporen, een vochtplek in je plafond, een lekkende dakgoot, stormschade en wat het kost."
  path="/kennisbank"
  schema={lijstSchema}
>
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow" style="color:#ffb486;">Kennisbank</p>
      <h1>Daktips & eerlijke uitleg</h1>
      <p class="lead">Praktische uitleg over je dak, zonder verkooppraatje. Zo weet je wat er speelt voordat je belt.</p>
      <p class="lead" style="margin-top:10px;">Uitleg van Rens van Spoed Dak Service, dakdekker uit 's-Hertogenbosch voor lekkage, losse pannen, goten en stormschade in de regio Den Bosch.</p>
    </div>
  </section>
  <section class="section">
    <div class="wrap">
      {groepen.map((g, i) => (
        <>
          <h2 style={i === 0 ? "" : "margin-top:40px;"}>{g.kop}</h2>
          <div class="grid grid-3" style="margin-top:16px;">
            {g.artikelen.map((a) => (
              <a class="card" href={`/kennisbank/${a.slug}/`}>
                <h3>{a.titel}</h3>
                <p>{a.metaDescription}</p>
              </a>
            ))}
          </div>
        </>
      ))}
    </div>
  </section>
</Base>
