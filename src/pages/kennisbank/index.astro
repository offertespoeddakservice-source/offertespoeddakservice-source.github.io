---
import Base from "../../layouts/Base.astro";
import { SITE, telHref, waHref } from "../../site.config.ts";
import { ARTIKELEN } from "../../data/artikelen.ts";
// Kennisbank in groepjes per onderwerp, lekkage eerst. Artikelen die nergens in staan komen in de laatste groep.
// 22-11-2026 ronde 3: lekt tijdens verbouwing, water van de buren op je dak en droge nok of specie gekoppeld (bleven in ronde 2 liggen, omdat de koppel-tip draaide voordat ze bestonden).
// 22-11-2026 ronde 5: bliksem op je dak, schade door bouwwerk in de straat en dakdekker failliet gekoppeld, altijd toegevoegd.
const GROEPEN: { kop: string; slugs: string[] }[] = [
  { kop: "Lekt je dak?", slugs: ["daklek-tijdelijk-dichten", "noodreparatie-dak", "foto-van-je-dak-maken", "lekkage-tijdens-vakantie", "daklekkage-opsporen", "lekdetectie-daklek", "vochtplek-plafond", "vochtplek-hoek-plafond-buitenmuur", "natte-plek-bovenin-muur", "doorslaand-vocht-of-daklek", "plafond-bolt-op-door-lekkage", "plafond-naar-beneden-door-lekkage", "water-uit-lamp-plafond", "water-uit-stopcontact-bij-regen", "lekkage-meterkast-bij-regen", "aardlekschakelaar-slaat-af-bij-regen", "druppelen-horen-plafond", "lekkage-dakdekker-of-loodgieter", "dak-lekt-bij-hevige-regen", "dak-lekt-na-dagen-regen", "dak-lekt-bij-harde-wind", "dak-lekt-bij-sneeuw-of-vorst", "dak-repareren-in-de-winter", "dakraam-lekt", "lekt-sinds-nieuw-dakraam", "dakkapel-lekt", "glazen-dakpan-lekt", "ventilatiepan-lekt", "erker-lekt", "zinken-dak-lekt", "lekkage-bij-schoorsteen", "schoorsteen-lekt-open-haard", "lekkage-gedeelde-schoorsteen", "schoorsteen-lekt-verzekering", "lekkage-weggehaalde-schoorsteen", "vochtplek-schoorsteen-binnen", "kilgoot-lekt", "lekkage-bij-zonnepanelen", "lekkage-bij-dakdoorvoer", "cv-ketel-lekt-bij-regen", "afzuigkap-lekt-bij-regen", "lekkage-bij-schotel-of-antenne", "lood-op-dak", "lood-schoorsteen-vervangen", "schuin-dak-aanbouw-lekt", "lekkage-muur-buren", "zolder-nat-langs-zijmuur", "condens-of-lekkage-op-zolder", "schimmel-op-zolder", "water-uit-zolderluik", "dakfolie-kapot", "licht-tussen-dakpannen", "nat-achter-knieschot", "natte-plek-schuine-wand-zolder", "isolatie-nat-na-lekkage", "lekt-sinds-dakisolatie", "plafond-drogen-na-lekkage", "dak-lekt-na-reparatie", "daklekkage-verzekering", "verzekering-betaalt-daklekkage-niet", "lekkage-huurhuis", "nieuw-dak-lekt", "huis-gekocht-dak-lekt", "dak-lekt-huis-verkopen", "wat-kost-daklekkage-repareren", "lekkage-bij-de-nok", "hoekkeper-lekt", "lekkage-badkamer-plafond", "lekkage-bij-kachelpijp", "lekkage-warmtepomp-of-airco", "lood-van-dak-gestolen", "daklek-hoe-lang-wachten", "lekkage-na-dakwerk-buren", "dak-lekt-na-schoonmaken", "pannendak-schuur-lekt", "dak-lekt-boven-en-benedenwoning", "lekt-sinds-iemand-op-dak", "dak-schade-door-bouw-in-de-buurt", "jaren-30-huis-dak-lekt", "dak-jaren-50-huis-lekt", "dak-jaren-70-rijtjeshuis", "dak-jaren-90-huis-lekt", "boerderij-dak-lekt", "bungalow-dak-lekt", "mansardedak-lekt", "daklekkage-vve", "daklek-bij-je-ouders", "dak-lekt-leegstaand-huis", "lekt-tijdens-verbouwing"] },
  { kop: "Dakgoten: vol, lek of kapot", slugs: ["dakgoot-lekt", "dakgoot-loopt-over", "water-spat-over-dakgoot", "ijspegels-aan-dakgoot","dakgoot-lekt-bij-regenpijp", "dakgoot-lekt-in-de-hoek", "dakgoot-lekt-aan-het-eind", "gedeelde-dakgoot-lekt", "lekkende-dakgoot-tijdelijk-oplossen", "zinken-dakgoot-lekt", "kunststof-dakgoot-lekt", "dakgoot-hangt-door", "dakgoot-losgeraakt", "water-achter-dakgoot", "groene-strepen-gevel-onder-dakgoot", "lekt-sinds-nieuwe-dakgoot", "dakgoot-lekt-na-schoonmaken", "bakgoot-lekt", "mastgoot-lekt", "zakgoot-lekt", "verholen-goot-lekt", "hoe-lang-gaat-een-dakgoot-mee", "dakgoot-vernieuwen", "dakgoot-zink-of-kunststof", "welke-dakgoot-heb-ik", "verstopte-regenpijp-lekkende-dakgoot", "regenpijp-in-de-muur-lekt", "regenpijp-kapot-door-vorst", "goot-loopt-over-door-regenton", "lekkende-dakgoot-verzekering", "hoe-vaak-dakgoot-reinigen", "dakgoot-zelf-schoonmaken", "goot-schoonmaken-glazenwasser-of-dakdekker", "bladvanger-dakgoot", "zand-in-dakgoot", "planten-in-dakgoot","dakgoot-schoonmaken-in-de-winter", "kerstverlichting-dakgoot", "dakgoot-schoonmaken-huurder-of-verhuurder", "wat-kost-dakgoot-schoonmaken", "regenpijp-loost-op-dak", "water-van-buren-op-je-dak", "vergaarbak-lekt"] },
  { kop: "Na een storm", slugs: ["stormschade-eerste-hulp", "dakpan-in-tuin-gevonden", "hagelschade-dak", "blikseminslag-dak", "wachten-op-dakdekker-na-storm", "nokvorsten-los", "dakpan-kapot-of-verschoven", "tak-of-boom-op-dak", "dakpannen-vastzetten-tegen-storm", "dakpannen-klapperen-bij-wind", "dak-fluit-bij-harde-wind", "windveer-los-of-rot", "gevelpannen-los", "schoorsteen-na-storm", "dakpan-op-auto-buren", "plat-dak-losgewaaid-na-storm", "storm-op-komst-dak"] },
  { kop: "Platte daken", slugs: ["plat-dak-vervangen-of-repareren", "welke-dakbedekking-heb-ik", "epdm-dak-lekt", "dakterras-lekt", "daktrim-lekt", "dakleer-repareren", "water-blijft-staan-op-plat-dak", "zachte-plek-plat-dak", "plat-dak-lekt-bij-afvoer", "garagebox-dak-lekt", "noodoverloop-plat-dak", "plat-dak-met-grind-lekt", "lichtkoepel-lekt", "dakluik-lekt", "lichtstraat-lekt", "lekkage-bij-aanbouw", "veranda-of-overkapping-lekt", "serre-lekt", "golfplaten-lekken", "welke-golfplaten-heb-ik", "wat-kost-plat-dak-repareren", "lekkage-overgang-schuin-plat-dak"] },
  { kop: "Onderhoud, kosten en een goede dakdekker", slugs: ["dakinspectie", "wat-kost-een-dakinspectie", "dak-keuren-bij-huis-kopen", "dakonderhoud-per-seizoen", "dak-winterklaar-maken", "daktermen-uitgelegd", "hoe-lang-gaat-een-dak-mee", "dak-vernieuwen-rijtjeshuis", "dak-omdekken", "vergunning-dak-vernieuwen", "poreuze-dakpannen", "dakpannen-zakken-af", "welke-dakpan-heb-ik", "sneldekpannen-vervangen", "welk-soort-dak-heb-ik", "hoe-oud-is-mijn-dak", "dakpan-zelf-terugleggen", "dak-monument-repareren", "duiven-onder-zonnepanelen", "mos-op-dak-verwijderen", "kraaien-mos-van-dak", "schoorsteen-vegen-hoe-vaak", "schoorsteen-afdekken", "zonnepanelen-reinigen-nodig", "wat-kost-een-dakdekker", "hoe-herken-je-een-betrouwbare-dakdekker", "keurmerk-dakdekker", "dakdekker-aan-de-deur", "offerte-dakdekker-vergelijken", "wat-kost-nokvorsten-repareren", "droge-nok-of-specie", "wat-kost-dakpan-vervangen", "vuurwerk-schade-dak", "dak-nakijken-voor-zonnepanelen", "dak-nakijken-voor-zolder-verbouwen", "lood-of-loodvervanger", "dakdekker-kleine-klus", "dak-repareren-via-buren", "dakdekker-komt-wat-regel-je", "dak-nakijken-na-schoorsteenbrand", "klimop-op-dak-of-in-dakgoot", "welke-vakman-voor-je-dak", "dakdekker-komt-niet-opdagen", "dakdekker-failliet-dak-lekt"] },
];
const zichtbaar = ARTIKELEN.filter((a) => !a.verborgen);
const ingedeeld = new Set(GROEPEN.flatMap((g) => g.slugs));
const overig = zichtbaar.filter((a) => !ingedeeld.has(a.slug));
const groepen = GROEPEN.map((g, i) => ({
  kop: g.kop,
  artikelen: [...g.slugs.map((s) => zichtbaar.find((a) => a.slug === s)).filter((a) => a), ...(i === GROEPEN.length - 1 ? overig : [])] as typeof ARTIKELEN,
}));
// Veel gelezen: de uitleg met de meeste bezoekers in de eigen teller (11-11-2026). Een artikel dat verborgen is of niet bestaat, valt vanzelf weg.
const VEEL_GELEZEN = ["water-achter-dakgoot", "dak-lekt-bij-harde-wind", "lekkage-bij-dakdoorvoer", "lekkage-bij-kachelpijp", "nat-achter-knieschot"];
const veelGelezen = VEEL_GELEZEN.map((s) => zichtbaar.find((a) => a.slug === s)).filter((a) => a) as typeof ARTIKELEN;
// Kopen, verkopen of huren: een gewone regel met de uitleg voor wie een huis koopt, verkoopt, huurt of een woning deelt (14-11-2026). Een artikel dat verborgen is of niet bestaat, valt vanzelf weg. 21-11-2026 ronde 4: ook hoe oud is mijn dak.
const WONEN = ["dak-keuren-bij-huis-kopen", "huis-gekocht-dak-lekt", "dak-lekt-huis-verkopen", "lekkage-huurhuis", "dakgoot-schoonmaken-huurder-of-verhuurder", "dak-lekt-boven-en-benedenwoning", "hoe-oud-is-mijn-dak"];
const wonen = WONEN.map((s) => zichtbaar.find((a) => a.slug === s)).filter((a) => a) as typeof ARTIKELEN;
// Winter en vorst: een gewone regel met de uitleg voor sneeuw, ijs en vorst (16-11-2026). Een artikel dat verborgen is of niet bestaat, valt vanzelf weg.
const WINTER = ["dak-winterklaar-maken", "dak-lekt-bij-sneeuw-of-vorst", "dak-repareren-in-de-winter", "ijspegels-aan-dakgoot", "dakgoot-schoonmaken-in-de-winter", "regenpijp-kapot-door-vorst", "vorstschade-dakpannen"];
const winter = WINTER.map((s) => zichtbaar.find((a) => a.slug === s)).filter((a) => a) as typeof ARTIKELEN;
// 23-11-2026 ronde 1: regel Rond de feestdagen, met lichtjes aan de goot, vuurwerk en lekkage terwijl je weg bent. Een artikel dat verborgen is of niet bestaat, valt vanzelf weg.
const FEESTDAGEN = ["kerstverlichting-dakgoot", "vuurwerk-schade-dak", "lekkage-tijdens-vakantie"];
const feestdagen = FEESTDAGEN.map((s) => zichtbaar.find((a) => a.slug === s)).filter((a) => a) as typeof ARTIKELEN;
// Stookseizoen en schoorsteen: een gewone regel met de uitleg over de schoorsteen, het lood eromheen en de kachelpijp (17-11-2026). Een artikel dat verborgen is of niet bestaat, valt vanzelf weg.
const STOOK = ["lekkage-bij-schoorsteen", "schoorsteen-lekt-open-haard", "vochtplek-schoorsteen-binnen", "lekkage-bij-kachelpijp", "schoorsteen-afdekken", "schoorsteen-vegen-hoe-vaak"];
const stook = STOOK.map((s) => zichtbaar.find((a) => a.slug === s)).filter((a) => a) as typeof ARTIKELEN;
// Soorten huizen: een gewone regel met de uitleg per bouwjaar en soort huis (17-11-2026). Een artikel dat verborgen is of niet bestaat, valt vanzelf weg. 19-11-2026 ronde 5: ook bungalow en mansardedak. 21-11-2026 ronde 4: ook hoe oud is mijn dak.
const SOORT_HUIS = ["jaren-30-huis-dak-lekt", "dak-jaren-50-huis-lekt", "dak-jaren-70-rijtjeshuis", "dak-jaren-90-huis-lekt", "boerderij-dak-lekt", "dak-monument-repareren", "bungalow-dak-lekt", "mansardedak-lekt", "welk-soort-dak-heb-ik", "hoe-oud-is-mijn-dak"];
const soortHuis = SOORT_HUIS.map((s) => zichtbaar.find((a) => a.slug === s)).filter((a) => a) as typeof ARTIKELEN;
// Dieren en planten op je dak: een gewone regel met de uitleg over vogels, kraaien, duiven, een marter, klimop en planten in de goot (19-11-2026). Een artikel dat verborgen is of niet bestaat, valt vanzelf weg.
const DIEREN = ["vogels-onder-dakpannen", "kraaien-mos-van-dak", "duiven-onder-zonnepanelen", "marter-onder-dakpannen", "klimop-op-dak-of-in-dakgoot", "planten-in-dakgoot"];
const dieren = DIEREN.map((s) => zichtbaar.find((a) => a.slug === s)).filter((a) => a) as typeof ARTIKELEN;
// Schuur, carport en aanbouw: een gewone regel met de uitleg over daken van bijgebouwen (21-11-2026 ronde 2). Een artikel dat verborgen is of niet bestaat, valt vanzelf weg. 21-11-2026 ronde 3: ook welke golfplaten heb ik.
const SCHUUR = ["golfplaten-lekken", "welke-golfplaten-heb-ik", "pannendak-schuur-lekt", "garagebox-dak-lekt", "dakleer-repareren", "veranda-of-overkapping-lekt", "serre-lekt", "lekkage-bij-aanbouw"];
const schuur = SCHUUR.map((s) => zichtbaar.find((a) => a.slug === s)).filter((a) => a) as typeof ARTIKELEN;
// Je dak en de buren: een gewone regel met de uitleg over werk aan je dak dat met de buren te maken heeft (22-11-2026 ronde 2). Een artikel dat verborgen is of niet bestaat, valt vanzelf weg.
const BUREN = ["lekkage-muur-buren", "gedeelde-dakgoot-lekt", "lekkage-na-dakwerk-buren", "dak-repareren-via-buren", "dak-vernieuwen-rijtjeshuis", "dakpan-op-auto-buren", "water-van-buren-op-je-dak", "dak-schade-door-bouw-in-de-buurt"];
const buren = BUREN.map((s) => zichtbaar.find((a) => a.slug === s)).filter((a) => a) as typeof ARTIKELEN;
// 22-11-2026 ronde 4: In het kort onderaan, gelijk aan /diensten/ en de andere pagina's, voor Google en AI.
// Gestructureerde gegevens: de kennisbank als verzameling, met alle zichtbare artikelen in de volgorde van de pagina.
const lijstSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Daktips & eerlijke uitleg",
  url: `${SITE.url}/kennisbank/`,
  inLanguage: "nl-NL",
  publisher: { "@id": `${SITE.url}/#bedrijf` },
  mainEntity: {
    "@type": "ItemList",
    itemListElement: groepen.flatMap((g) => g.artikelen).map((a, i) => ({ "@type": "ListItem", position: i + 1, url: `${SITE.url}/kennisbank/${a.slug}/`, name: a.titel })),
  },
};
---

<Base
  title={`Daktips: lekkage, goten en storm | ${SITE.bedrijfsnaam}`}
  description="Eerlijke daktips van dakdekker Rens: daklekkage opsporen, een vochtplek in je plafond, een lekkende dakgoot, stormschade en wat het kost."
  path="/kennisbank"
  schema={lijstSchema}
>
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow" style="color:#ffb486;">Kennisbank</p>
      <h1>Daktips en uitleg over daklekkage, dakgoten en storm</h1>
      <p class="lead">Praktische uitleg over je dak, zonder verkooppraatje. Zo weet je wat er speelt voordat je belt.</p>
      <p class="lead" style="margin-top:10px;">Uitleg van Rens van Spoed Dak Service, dakdekker uit 's-Hertogenbosch voor lekkage, losse pannen, goten en stormschade in de regio Den Bosch.</p>
      <p class="lead" style="margin-top:10px;"><strong>Lekt het nu?</strong> Op de <a href="/spoed/" style="color:#ffb486;">spoedpagina</a> lees je wat je meteen zelf kunt doen, of stuur me een foto van de natte plek via <a href={waHref("Hallo, mijn dak lekt. Ik stuur je een foto.")} style="color:#ffb486;">WhatsApp</a>.</p>
    </div>
  </section>
  <section class="section">
    <div class="wrap">
      <div style="display:flex; flex-wrap:wrap; gap:8px; margin-bottom:28px;">
        {groepen.map((g, i) => <a class="chip" href={`#groep-${i + 1}`}>{g.kop}</a>)}
      </div>
      {veelGelezen.length > 0 && (
        <p style="margin:0 0 28px;"><strong>Veel gelezen:</strong> {veelGelezen.map((a, i) => (<>{i > 0 && ", "}<a href={`/kennisbank/${a.slug}/`}>{a.titel.replace(/\?$/, "")}</a></>))}.</p>
      )}
      {wonen.length > 0 && (
        <p style="margin:0 0 28px;"><strong>Kopen, verkopen of huren?</strong> {wonen.map((a, i) => (<>{i > 0 && ", "}<a href={`/kennisbank/${a.slug}/`}>{a.titel.replace(/\?$/, "")}</a></>))}.</p>
      )}
      {winter.length > 0 && (
        <p style="margin:0 0 28px;"><strong>Winter en vorst:</strong> {winter.map((a, i) => (<>{i > 0 && ", "}<a href={`/kennisbank/${a.slug}/`}>{a.titel.replace(/\?$/, "")}</a></>))}.</p>
      )}
      {feestdagen.length > 0 && (
        <p style="margin:0 0 28px;"><strong>Rond de feestdagen:</strong> {feestdagen.map((a, i) => (<>{i > 0 && ", "}<a href={`/kennisbank/${a.slug}/`}>{a.titel.replace(/\?$/, "")}</a></>))}.</p>
      )}
      {stook.length > 0 && (
        <p style="margin:0 0 28px;"><strong>Stookseizoen en schoorsteen:</strong> {stook.map((a, i) => (<>{i > 0 && ", "}<a href={`/kennisbank/${a.slug}/`}>{a.titel.replace(/\?$/, "")}</a></>))}.</p>
      )}
      {soortHuis.length > 0 && (
        <p style="margin:0 0 28px;"><strong>Soorten huizen:</strong> {soortHuis.map((a, i) => (<>{i > 0 && ", "}<a href={`/kennisbank/${a.slug}/`}>{a.titel.replace(/\?$/, "")}</a></>))}.</p>
      )}
      {dieren.length > 0 && (
        <p style="margin:0 0 28px;"><strong>Dieren en planten op je dak:</strong> {dieren.map((a, i) => (<>{i > 0 && ", "}<a href={`/kennisbank/${a.slug}/`}>{a.titel.replace(/\?$/, "")}</a></>))}.</p>
      )}
      {schuur.length > 0 && (
        <p style="margin:0 0 28px;"><strong>Schuur, carport en aanbouw:</strong> {schuur.map((a, i) => (<>{i > 0 && ", "}<a href={`/kennisbank/${a.slug}/`}>{a.titel.replace(/\?$/, "")}</a></>))}.</p>
      )}
      {buren.length > 0 && (
        <p style="margin:0 0 28px;"><strong>Je dak en de buren:</strong> {buren.map((a, i) => (<>{i > 0 && ", "}<a href={`/kennisbank/${a.slug}/`}>{a.titel.replace(/\?$/, "")}</a></>))}.</p>
      )}
      {groepen.map((g, i) => (
        <>
          <h2 id={`groep-${i + 1}`} style={i === 0 ? "" : "margin-top:40px;"}>{g.kop}</h2>
          <div class="grid grid-3" style="margin-top:16px;">
            {g.artikelen.map((a) => (
              <a class="card" href={`/kennisbank/${a.slug}/`}>
                <h3>{a.titel}</h3>
                <p>{a.metaDescription}</p>
              </a>
            ))}
          </div>
        </>
      ))}
      <h2 id="in-het-kort" style="margin-top:40px;">In het kort</h2>
      <ul>
        <li><strong>Wie:</strong> Spoed Dak Service, het bedrijf van {SITE.eigenaar}, dakdekker uit 's-Hertogenbosch. Deze uitleg schrijf ik zelf, en je belt of appt met mij zelf, niet met een callcenter.</li>
        <li><strong>Waarover:</strong> daklekkage en natte plekken binnen, dakgoten, stormschade, platte daken, pannen en nokvorsten, lood rond de schoorsteen, onderhoud en wat dakwerk kost.</li>
        <li><strong>Klussen:</strong> daklekkage, losse dakpannen en nokvorsten, lood rond schoorsteen en dakraam, dakgoten repareren en schoonmaken, platte daken en stormschade.</li>
        <li><strong>Waar:</strong> vanuit Den Bosch in de regio Den Bosch en verder in Brabant. Een klus verder weg plan ik vooraf met je in. Zie <a href="/werkgebied/">mijn werkgebied</a>.</li>
        <li><strong>Contact:</strong> bellen of WhatsApp op <a href={telHref}>{SITE.telefoonWeergave}</a>, dag en nacht bereikbaar.</li>
        <li><strong>Prijs:</strong> je hoort de vaste prijs voordat ik begin. De richtprijzen staan op de <a href="/prijzen/">prijzen-pagina</a>.</li>
        <li><strong>Verzekerd:</strong> bedrijfsaansprakelijk verzekerd.</li>
      </ul>
    </div>
  </section>
</Base>
