---
import Base from "../../layouts/Base.astro";
import { SITE } from "../../site.config.ts";
import { ARTIKELEN } from "../../data/artikelen.ts";
---

<Base
  title={`Daktips: lekkage, goten en storm | ${SITE.bedrijfsnaam}`}
  description="Eerlijke daktips van dakdekker Rens: daklekkage opsporen, een vochtplek in je plafond, een lekkende dakgoot, stormschade en wat het kost."
  path="/kennisbank"
>
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow" style="color:#ffb486;">Kennisbank</p>
      <h1>Daktips & eerlijke uitleg</h1>
      <p class="lead">Praktische uitleg over je dak — zonder verkooppraatje. Zo weet je wat er speelt voordat je belt.</p>
    </div>
  </section>
  <section class="section">
    <div class="wrap">
      <h2 class="sr-only">Alle artikelen</h2>
      <div class="grid grid-3">
        {ARTIKELEN.filter((a) => !a.verborgen).map((a) => (
          <a class="card" href={`/kennisbank/${a.slug}/`}>
            <h3>{a.titel}</h3>
            <p>{a.metaDescription}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>
