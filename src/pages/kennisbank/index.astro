---
import Base from "../../layouts/Base.astro";
import { SITE, waHref } from "../../site.config.ts";
import { ARTIKELEN } from "../../data/artikelen.ts";
// Kennisbank in groepjes per onderwerp, lekkage eerst. Artikelen die nergens in staan komen in de laatste groep.
const GROEPEN: { kop: string; slugs: string[] }[] = [
  { kop: "Lekt je dak?", slugs: ["daklek-tijdelijk-dichten", "daklekkage-opsporen", "lekdetectie-daklek", "vochtplek-plafond", "natte-plek-bovenin-muur", "plafond-bolt-op-door-lekkage", "water-uit-lamp-plafond", "druppelen-horen-plafond", "lekkage-dakdekker-of-loodgieter", "dak-lekt-bij-hevige-regen", "dak-lekt-bij-harde-wind", "dak-lekt-bij-sneeuw-of-vorst", "dak-repareren-in-de-winter", "dakraam-lekt", "lekt-sinds-nieuw-dakraam", "dakkapel-lekt", "glazen-dakpan-lekt", "erker-lekt", "lekkage-bij-schoorsteen", "schoorsteen-lekt-open-haard", "lekkage-gedeelde-schoorsteen", "lekkage-weggehaalde-schoorsteen", "vochtplek-schoorsteen-binnen", "kilgoot-lekt", "lekkage-bij-zonnepanelen", "lekkage-bij-dakdoorvoer", "cv-ketel-lekt-bij-regen", "afzuigkap-lekt-bij-regen", "lekkage-bij-schotel-of-antenne", "lood-op-dak", "schuin-dak-aanbouw-lekt", "lekkage-muur-buren", "zolder-nat-langs-zijmuur", "condens-of-lekkage-op-zolder", "water-uit-zolderluik", "dakfolie-kapot", "licht-tussen-dakpannen", "nat-achter-knieschot", "natte-plek-schuine-wand-zolder", "isolatie-nat-na-lekkage", "lekt-sinds-dakisolatie", "plafond-drogen-na-lekkage", "dak-lekt-na-reparatie", "daklekkage-verzekering", "verzekering-betaalt-daklekkage-niet", "lekkage-huurhuis", "nieuw-dak-lekt", "huis-gekocht-dak-lekt", "wat-kost-daklekkage-repareren", "lekkage-bij-de-nok", "hoekkeper-lekt", "lekkage-badkamer-plafond", "lekkage-bij-kachelpijp", "lekkage-warmtepomp-of-airco", "lood-van-dak-gestolen", "daklek-hoe-lang-wachten", "lekkage-na-dakwerk-buren", "dak-lekt-na-schoonmaken", "pannendak-schuur-lekt", "dak-lekt-boven-en-benedenwoning", "lekt-sinds-iemand-op-dak"] },
  { kop: "Dakgoten: vol, lek of kapot", slugs: ["dakgoot-lekt", "dakgoot-loopt-over", "ijspegels-aan-dakgoot","dakgoot-lekt-bij-regenpijp", "gedeelde-dakgoot-lekt", "lekkende-dakgoot-tijdelijk-oplossen", "zinken-dakgoot-lekt", "kunststof-dakgoot-lekt", "dakgoot-hangt-door", "dakgoot-losgeraakt", "water-achter-dakgoot", "lekt-sinds-nieuwe-dakgoot", "dakgoot-lekt-na-schoonmaken", "bakgoot-lekt", "hoe-lang-gaat-een-dakgoot-mee", "dakgoot-zink-of-kunststof", "verstopte-regenpijp-lekkende-dakgoot", "regenpijp-in-de-muur-lekt", "regenpijp-kapot-door-vorst", "lekkende-dakgoot-verzekering", "hoe-vaak-dakgoot-reinigen", "dakgoot-zelf-schoonmaken", "goot-schoonmaken-glazenwasser-of-dakdekker", "bladvanger-dakgoot", "zand-in-dakgoot", "dakgoot-schoonmaken-in-de-winter", "dakgoot-schoonmaken-huurder-of-verhuurder", "wat-kost-dakgoot-schoonmaken", "regenpijp-loost-op-dak"] },
  { kop: "Na een storm", slugs: ["stormschade-eerste-hulp", "dakpan-in-tuin-gevonden", "wachten-op-dakdekker-na-storm", "nokvorsten-los", "dakpan-kapot-of-verschoven", "tak-of-boom-op-dak", "dakpannen-vastzetten-tegen-storm", "dakpannen-klapperen-bij-wind", "dak-fluit-bij-harde-wind", "windveer-los-of-rot", "gevelpannen-los", "schoorsteen-na-storm", "dakpan-op-auto-buren", "plat-dak-losgewaaid-na-storm", "storm-op-komst-dak"] },
  { kop: "Platte daken", slugs: ["plat-dak-vervangen-of-repareren", "epdm-dak-lekt", "dakterras-lekt", "daktrim-lekt", "dakleer-repareren", "water-blijft-staan-op-plat-dak", "zachte-plek-plat-dak", "plat-dak-lekt-bij-afvoer", "plat-dak-met-grind-lekt", "lichtkoepel-lekt", "lichtstraat-lekt", "lekkage-bij-aanbouw", "veranda-of-overkapping-lekt", "golfplaten-lekken", "wat-kost-plat-dak-repareren", "lekkage-overgang-schuin-plat-dak"] },
  { kop: "Onderhoud, kosten en een goede dakdekker", slugs: ["dakinspectie", "wat-kost-een-dakinspectie", "dak-keuren-bij-huis-kopen", "dakonderhoud-per-seizoen", "daktermen-uitgelegd", "hoe-lang-gaat-een-dak-mee", "dak-vernieuwen-rijtjeshuis", "poreuze-dakpannen", "dakpannen-zakken-af", "welke-dakpan-heb-ik", "dak-monument-repareren", "duiven-onder-zonnepanelen", "mos-op-dak-verwijderen", "schoorsteen-vegen-hoe-vaak", "schoorsteen-afdekken", "zonnepanelen-reinigen-nodig", "wat-kost-een-dakdekker", "hoe-herken-je-een-betrouwbare-dakdekker", "keurmerk-dakdekker", "dakdekker-aan-de-deur", "offerte-dakdekker-vergelijken", "wat-kost-nokvorsten-repareren", "wat-kost-dakpan-vervangen", "vuurwerk-schade-dak", "dak-nakijken-voor-zonnepanelen", "lood-of-loodvervanger", "dakdekker-kleine-klus"] },
];
const zichtbaar = ARTIKELEN.filter((a) => !a.verborgen);
const ingedeeld = new Set(GROEPEN.flatMap((g) => g.slugs));
const overig = zichtbaar.filter((a) => !ingedeeld.has(a.slug));
const groepen = GROEPEN.map((g, i) => ({
  kop: g.kop,
  artikelen: [...g.slugs.map((s) => zichtbaar.find((a) => a.slug === s)).filter((a) => a), ...(i === GROEPEN.length - 1 ? overig : [])] as typeof ARTIKELEN,
}));
// Veel gelezen: de uitleg met de meeste bezoekers in de eigen teller (11-11-2026). Een artikel dat verborgen is of niet bestaat, valt vanzelf weg.
const VEEL_GELEZEN = ["water-achter-dakgoot", "dak-lekt-bij-harde-wind", "lekkage-bij-dakdoorvoer", "lekkage-bij-kachelpijp", "nat-achter-knieschot"];
const veelGelezen = VEEL_GELEZEN.map((s) => zichtbaar.find((a) => a.slug === s)).filter((a) => a) as typeof ARTIKELEN;
// Gestructureerde gegevens: de kennisbank als verzameling, met alle zichtbare artikelen in de volgorde van de pagina.
const lijstSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Daktips & eerlijke uitleg",
  url: `${SITE.url}/kennisbank/`,
  inLanguage: "nl-NL",
  publisher: { "@id": `${SITE.url}/#bedrijf` },
  mainEntity: {
    "@type": "ItemList",
    itemListElement: groepen.flatMap((g) => g.artikelen).map((a, i) => ({ "@type": "ListItem", position: i + 1, url: `${SITE.url}/kennisbank/${a.slug}/`, name: a.titel })),
  },
};
---

<Base
  title={`Daktips: lekkage, goten en storm | ${SITE.bedrijfsnaam}`}
  description="Eerlijke daktips van dakdekker Rens: daklekkage opsporen, een vochtplek in je plafond, een lekkende dakgoot, stormschade en wat het kost."
  path="/kennisbank"
  schema={lijstSchema}
>
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow" style="color:#ffb486;">Kennisbank</p>
      <h1>Daktips & eerlijke uitleg</h1>
      <p class="lead">Praktische uitleg over je dak, zonder verkooppraatje. Zo weet je wat er speelt voordat je belt.</p>
      <p class="lead" style="margin-top:10px;">Uitleg van Rens van Spoed Dak Service, dakdekker uit 's-Hertogenbosch voor lekkage, losse pannen, goten en stormschade in de regio Den Bosch.</p>
      <p class="lead" style="margin-top:10px;"><strong>Lekt het nu?</strong> Op de <a href="/spoed/" style="color:#ffb486;">spoedpagina</a> lees je wat je meteen zelf kunt doen, of stuur me een foto van de natte plek via <a href={waHref("Hallo, mijn dak lekt. Ik stuur je een foto.")} style="color:#ffb486;">WhatsApp</a>.</p>
    </div>
  </section>
  <section class="section">
    <div class="wrap">
      <div style="display:flex; flex-wrap:wrap; gap:8px; margin-bottom:28px;">
        {groepen.map((g, i) => <a class="chip" href={`#groep-${i + 1}`}>{g.kop}</a>)}
      </div>
      {veelGelezen.length > 0 && (
        <p style="margin:0 0 28px;"><strong>Veel gelezen:</strong> {veelGelezen.map((a, i) => (<>{i > 0 && ", "}<a href={`/kennisbank/${a.slug}/`}>{a.titel.replace(/\?$/, "")}</a></>))}.</p>
      )}
      {groepen.map((g, i) => (
        <>
          <h2 id={`groep-${i + 1}`} style={i === 0 ? "" : "margin-top:40px;"}>{g.kop}</h2>
          <div class="grid grid-3" style="margin-top:16px;">
            {g.artikelen.map((a) => (
              <a class="card" href={`/kennisbank/${a.slug}/`}>
                <h3>{a.titel}</h3>
                <p>{a.metaDescription}</p>
              </a>
            ))}
          </div>
        </>
      ))}
    </div>
  </section>
</Base>
