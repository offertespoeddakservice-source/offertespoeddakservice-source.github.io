const fotoBestanden = FOTOS_BESTANDEN[a.slug]
  ?.map((code) => FOTOS.find((f) => f.bestand.includes(`-${code}.`))?.bestand)
  .filter((b): b is string => !!b);
// 23-11-2026 ronde 4: zijblok met vier plaatspagina's die per artikel wisselen. De plaatspagina's hadden maar 52 tot 63 binnenkomende links (les 170). Den Bosch staat al in de kop van elk artikel.
const BUURT_BRON = PLAATSEN.filter((p) => p.slug !== "den-bosch");
const buurtStart = [...a.slug].reduce((s, c) => s + c.charCodeAt(0), 0) % BUURT_BRON.length;
const buurtPlaatsen = [0, 5, 10, 15].map((i) => BUURT_BRON[(buurtStart + i) % BUURT_BRON.length]);
// 23-11-2026 ronde 4: schoorsteenartikelen linken naar lood rond je schoorsteen laten vervangen (15 binnenkomende links), alleen als dat artikel bestaat.
const SCHOORSTEEN_LOOD = new Set(["lekkage-bij-schoorsteen", "schoorsteen-lekt-open-haard", "vochtplek-schoorsteen-binnen", "lekkage-gedeelde-schoorsteen", "schoorsteen-lekt-verzekering", "schoorsteen-na-storm", "lood-op-dak"]);
const toonLoodSchoorsteen = SCHOORSTEEN_LOOD.has(a.slug) && ARTIKELEN.some((x) => x.slug === "lood-schoorsteen-vervangen" && !x.verborgen);
// 24-11-2026 ronde 3: vaste link-zinnen voor schoorsteen en zolder. Dakinspectie linkt al bovenaan naar wat kost een dakinspectie, dus daar geen tweede zin.
const SCHOORSTEEN_HUB = new Set(["schoorsteen-lekt-open-haard", "vochtplek-schoorsteen-binnen", "lekkage-gedeelde-schoorsteen", "schoorsteen-lekt-verzekering", "schoorsteen-na-storm", "lood-schoorsteen-vervangen", "lekkage-weggehaalde-schoorsteen", "schoorsteen-afdekken", "dak-nakijken-na-schoorsteenbrand"]);
const toonSchoorsteenHub = SCHOORSTEEN_HUB.has(a.slug) && ARTIKELEN.some((x) => x.slug === "lekkage-bij-schoorsteen" && !x.verborgen);
const ZOLDER_NAT = [{ slug: "nat-achter-knieschot", anker: "nat achter het knieschot" }, { slug: "natte-plek-schuine-wand-zolder", anker: "een natte plek op de schuine wand" }, { slug: "zolder-nat-langs-zijmuur", anker: "nat langs de zijmuur" }, { slug: "schimmel-op-zolder", anker: "schimmel op zolder" }, { slug: "water-uit-zolderluik", anker: "water uit je zolderluik" }];
const ZOLDER_SET = new Set([...ZOLDER_NAT.map((z) => z.slug), "condens-of-lekkage-op-zolder", "lekkage-bij-de-nok", "isolatie-nat-na-lekkage"]);
const zolderLinks = ZOLDER_SET.has(a.slug) ? ZOLDER_NAT.filter((z) => z.slug !== a.slug && ARTIKELEN.some((x) => x.slug === z.slug && !x.verborgen)) : [];
// 24-11-2026 ronde 4: vaste link-zinnen bij de gootartikelen (naar de plekken waar een goot lekt, 18 tot 22 binnenkomende links, en terug naar dakgoot lekt) en bij de artikelen over een plat dak (noodoverloop 11, regenpijp op het dak 13, zinken dak 13, welke dakbedekking 10). Een artikel linkt niet naar zichzelf, en een slug die niet bestaat valt weg.
const GOOT_PLEKKEN = [{ slug: "dakgoot-lekt-in-de-hoek", anker: "op de hoek" }, { slug: "dakgoot-lekt-aan-het-eind", anker: "aan het eind" }, { slug: "dakgoot-lekt-bij-regenpijp", anker: "bij de regenpijp" }, { slug: "dakgoot-lekt-na-schoonmaken", anker: "sinds hij is schoongemaakt" }, { slug: "lekt-sinds-nieuwe-dakgoot", anker: "sinds er een nieuwe goot hangt" }];
const GOOT_PLEK_SET = new Set(["dakgoot-lekt", ...GOOT_PLEKKEN.map((g) => g.slug), "zinken-dakgoot-lekt", "kunststof-dakgoot-lekt", "dakgoot-hangt-door", "gedeelde-dakgoot-lekt", "lekkende-dakgoot-tijdelijk-oplossen", "wat-kost-dakgoot-repareren"]);
const gootPlekLinks = GOOT_PLEK_SET.has(a.slug) ? GOOT_PLEKKEN.filter((g) => g.slug !== a.slug && ARTIKELEN.some((x) => x.slug === g.slug && !x.verborgen)) : [];
const toonGootHub = GOOT_PLEK_SET.has(a.slug) && a.slug !== "dakgoot-lekt" && ARTIKELEN.some((x) => x.slug === "dakgoot-lekt" && !x.verborgen) && !a.secties.some((s) => s.tekst.some((t) => t.includes('href="/kennisbank/dakgoot-lekt/"')));
const PLAT_WATER = [{ slug: "noodoverloop-plat-dak", anker: "water uit de noodoverloop" }, { slug: "regenpijp-loost-op-dak", anker: "een regenpijp die op je platte dak uitkomt" }, { slug: "zinken-dak-lekt", anker: "een dakje van zink" }, { slug: "welke-dakbedekking-heb-ik", anker: "welke dakbedekking er op je dak ligt" }];
const PLAT_WATER_SET = new Set([...PLAT_WATER.map((w) => w.slug), "water-blijft-staan-op-plat-dak", "plat-dak-lekt-bij-afvoer", "wat-kost-plat-dak-repareren", "plat-dak-vervangen-of-repareren", "plat-dak-onderhouden", "plat-dak-met-grind-lekt", "lekkage-bij-aanbouw", "garagebox-dak-lekt", "epdm-dak-lekt", "dakleer-repareren"]);
const platWaterLinks = PLAT_WATER_SET.has(a.slug) ? PLAT_WATER.filter((w) => w.slug !== a.slug && ARTIKELEN.some((x) => x.slug === w.slug && !x.verborgen)) : [];
const plek = groep.indexOf(a.slug);
const uitGroep = [...groep.slice(plek + 1), ...groep.slice(0, Math.max(plek, 0))]
  .map((s) => ARTIKELEN.find((x) => x.slug === s))
  .filter(Boolean) as typeof ARTIKELEN;
const volgende = [1, 2, 3, 4, 5, 6, 7].map((n) => ARTIKELEN[(idx + n) % ARTIKELEN.length]);
const gerelateerd = [...uitGroep, ...volgende]
  .filter((x, i, lijst) => x.slug !== a.slug && !x.verborgen && lijst.findIndex((y) => y.slug === x.slug) === i)
  .slice(0, 6);
// Nieuw in de kennisbank: de zes nieuwste zichtbare artikelen op datum, zodat een nieuw artikel meteen vanaf elk kennisartikel een link krijgt (14-11-2026). Niet het artikel zelf en niet wat al bij 'Lees ook' staat.
const nieuwste = ARTIKELEN
  .filter((x) => !x.verborgen && x.datum && x.slug !== a.slug && !gerelateerd.some((g) => g.slug === x.slug))
  .sort((x, y) => (y.datum ?? "").localeCompare(x.datum ?? ""))
  .slice(0, 6);

// 21-11-2026 ronde 2: bij de schrijver ook het beroep, net als op /over/.
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: a.h1,
  description: a.metaDescription,
  ...(KORT_ANTWOORD[a.slug] ? { abstract: KORT_ANTWOORD[a.slug] } : {}),
  inLanguage: "nl-NL",
  author: { "@type": "Person", "@id": `${SITE.url}/over/#rens`, name: SITE.eigenaar, jobTitle: "Dakdekker", url: `${SITE.url}/over/`, worksFor: { "@id": `${SITE.url}/#bedrijf` } },
  publisher: { "@type": "Organization", "@id": `${SITE.url}/#bedrijf`, name: SITE.bedrijfsnaam, logo: { "@type": "ImageObject", url: `${SITE.url}/favicon.svg` } },
  mainEntityOfPage: new URL(path + "/", SITE.url).href,
  ...(a.dienst?.href ? { about: { "@type": "Service", name: a.dienst.label.replace(/^Bekijk:\s*/, ""), url: `${SITE.url}${a.dienst.href.endsWith("/") ? a.dienst.href : a.dienst.href + "/"}`, provider: { "@id": `${SITE.url}/#bedrijf` } } } : {}),
  image: `${SITE.url}/og.png`,
  datePublished: a.datum ?? "2026-06-19",
  dateModified: bijgewerkt ?? "2026-06-20",
};
const faqSchema = a.faq.length
  ? { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: a.faq.map((f) => ({ "@type": "Question", name: f.v, acceptedAnswer: { "@type": "Answer", text: f.a } })) }
  : null;
const schema = faqSchema ? [articleSchema, faqSchema] : articleSchema;
---

<Base title={a.metaTitle} description={a.metaDescription} path={path} schema={schema} noindex={a.verborgen === true}>
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow" style="color:#ffb486;">Kennisbank</p>
      <h1>{a.h1}</h1>
      <p class="lead">{a.intro}</p>
      <p style="color:#9fb4c9; font-size:.9rem; margin-top:10px;">Bijgewerkt: {bijgewerktTekst} · door <a href="/over/" style="color:inherit; text-decoration:underline;">{SITE.eigenaar}</a>, dakdekker <a href="/werkgebied/den-bosch/" style="color:inherit; text-decoration:underline;">regio Den Bosch</a></p>
    </div>
  </section>

  <section class="section">
    <div class="wrap split">
      <article class="prose">
        {KORT_ANTWOORD[a.slug] && (
          <p class="notice" style="margin-top:0;"><strong>Kort antwoord:</strong> {KORT_ANTWOORD[a.slug]}</p>
        )}
        {/* 26-11-2026 ronde 1: bel- en WhatsApp-regel direct onder het korte antwoord. De best bezochte lekkage- en gootartikelen kregen sinds 25-11 nog geen tik op Bellen of WhatsApp. */}
        {KORT_ANTWOORD[a.slug] && LEK_ARTIKELEN.has(a.slug) && (
          <p><strong>Wil je dat ik meekijk?</strong> Stuur een foto van de natte plek via <a href={waHref("Hallo, mijn dak lekt. Ik stuur je een foto.")}>WhatsApp</a> of bel <a href={telHref}>{SITE.telefoonWeergave}</a>, dag en nacht. Je hebt dan mij zelf aan de lijn: Rens, dakdekker uit 's-Hertogenbosch.</p>
        )}
        {KORT_ANTWOORD[a.slug] && !LEK_ARTIKELEN.has(a.slug) && GOOT_ZIJBLOK.has(a.slug) && (
          <p><strong>Wil je dat ik naar je goot kijk?</strong> Maak vanaf de straat een foto van de goot en stuur die via <a href={waHref("Hallo, ik heb een vraag over mijn dakgoot. Ik stuur je een foto.")}>WhatsApp</a>, of bel <a href={telHref}>{SITE.telefoonWeergave}</a>. Dan hoor je vooraf wat het kost.</p>
        )}
        {a.slug === "dakinspectie" && ARTIKELEN.some((x) => x.slug === "wat-kost-een-dakinspectie" && !x.verborgen) && (
          <p>Wil je precies weten wat een dakinspectie kost en wat je ervoor krijgt? Lees <a href="/kennisbank/wat-kost-een-dakinspectie/">wat kost een dakinspectie</a>.</p>
        )}
        {a.slug === "dak-keuren-bij-huis-kopen" && ARTIKELEN.some((x) => x.slug === "dak-in-bouwkundig-rapport" && !x.verborgen) && (
          <p>Staat er in het rapport van de bouwkundige keuring al iets over het dak? Wat zulke punten betekenen en wat je meteen laat maken, lees je in <a href="/kennisbank/dak-in-bouwkundig-rapport/">je bouwkundig rapport noemt gebreken aan het dak</a>.</p>
        )}
        {a.secties.map((s, i) => (
          <>
            <h2>{s.kop}</h2>
            {s.tekst.map((p) => <p set:html={p} />)}
            {i === 0 && toonSpoedregel && (
              <p><strong>Lekt het nu?</strong> Ga niet zelf het dak op. Wat je meteen kunt doen, staat op de <a href="/spoed/">spoedpagina</a>. Of stuur me een foto van de natte plek via <a href={waHref("Hallo, mijn dak lekt. Ik stuur je een foto.")}>WhatsApp</a>, dan kijk ik mee. Druppelt het hard of bolt het plafond op, bel dan meteen: <a href={telHref}>{SITE.telefoonWeergave}</a>, dag en nacht.</p>
            )}
            {i === 0 && GOOT_FOTOREGEL.has(a.slug) && (
              <p><strong>Vol of lek?</strong> Twijfel je of je goot alleen vol zit of echt lekt? Maak vanaf de straat een foto, het liefst tijdens of vlak na een bui, en stuur die via <a href={waHref("Hallo, ik heb een vraag over mijn dakgoot. Ik stuur je een foto.")}>WhatsApp</a>. Dan zeg ik wat ik zie, en je hoort vooraf de vaste prijs.</p>
            )}
            {i === 0 && FOTOREGEL_OVERIG.has(a.slug) && !toonSpoedregel && !GOOT_FOTOREGEL.has(a.slug) && (
              <p><strong>Twijfel je wat het bij jou is?</strong> Maak vanaf de overkant van de straat een foto van je dak, met de zoom van je telefoon, en stuur die via <a href={waHref("Hallo, ik heb een vraag over mijn dak. Ik stuur je een foto.")}>WhatsApp</a>. Dan zeg ik eerlijk wat ik zie, en je hoort vooraf wat het kost.</p>
            )}
            {i === 0 && PLATDAK_FOTOREGEL.has(a.slug) && !toonSpoedregel && !GOOT_FOTOREGEL.has(a.slug) && !FOTOREGEL_OVERIG.has(a.slug) && (
              <p><strong>Twijfel je wat er met je platte dak is?</strong> Maak vanuit een raam boven, of vanaf een plek waar je veilig staat, een foto van het dak en stuur die via <a href={waHref("Hallo, ik heb een vraag over mijn platte dak. Ik stuur je een foto.")}>WhatsApp</a>. Ga er niet zelf op als het nat of glad is. Dan zeg ik eerlijk wat ik zie, en je hoort vooraf wat het kost.</p>
            )}
          </>
        ))}
        {fotoBij && <EchteFotos soort={fotoBij.soort} max={fotoBij.max} inline />}
        {!fotoBij && fotoBestanden && fotoBestanden.length > 0 && <EchteFotos bestanden={fotoBestanden} max={fotoBestanden.length} inline />}
        {toonLoodSchoorsteen && (<p>Is het lood rond je schoorsteen op en moet het eruit? Stap voor stap hoe ik dat vervang, met lood of loodvervanger, lees je in <a href="/kennisbank/lood-schoorsteen-vervangen/">lood rond je schoorsteen laten vervangen</a>.</p>)}
        {toonSchoorsteenHub && (<p>Alle plekken waar het bij een schoorsteen kan lekken, van het lood aan de voet tot de kop bovenop, staan op een rij in <a href="/kennisbank/lekkage-bij-schoorsteen/">lekkage bij de schoorsteen</a>.</p>)}
        {zolderLinks.length > 0 && (<p>Is het op een andere plek op zolder nat? Lees dan over {zolderLinks.map((z, i) => (<>{i > 0 && (i === zolderLinks.length - 1 ? " en " : ", ")}<a href={`/kennisbank/${z.slug}/`}>{z.anker}</a></>))}.</p>)}
        {gootPlekLinks.length > 0 && (<p>Lekt je goot op een andere plek, of pas sinds kort? Lees dan wat het betekent als hij lekt {gootPlekLinks.map((g, i) => (<>{i > 0 && (i === gootPlekLinks.length - 1 ? " of " : ", ")}<a href={`/kennisbank/${g.slug}/`}>{g.anker}</a></>))}.</p>)}
        {toonGootHub && (<p>Alle plekken waar een dakgoot kan lekken, en hoe je ziet of hij alleen vol zit of echt lek is, staan op een rij in <a href="/kennisbank/dakgoot-lekt/">dakgoot lekt</a>.</p>)}
        {platWaterLinks.length > 0 && (<p>Gaat het om water op of rond je platte dak? Lees dan ook over {platWaterLinks.map((w, i) => (<>{i > 0 && (i === platWaterLinks.length - 1 ? " en " : ", ")}<a href={`/kennisbank/${w.slug}/`}>{w.anker}</a></>))}.</p>)}
        {LEK_ARTIKELEN.has(a.slug) && !STORM_ARTIKELEN.has(a.slug) && (
          <p>Woon je in de regio Den Bosch? Hoe ik een lek bij jou in de buurt aanpak, lees je bij daklekkage in <a href="/werkgebied/den-bosch/daklekkage/">Den Bosch</a>, <a href="/werkgebied/vught/daklekkage/">Vught</a>, <a href="/werkgebied/rosmalen/daklekkage/">Rosmalen</a>, <a href="/werkgebied/oss/daklekkage/">Oss</a>, <a href="/werkgebied/veghel/daklekkage/">Veghel</a>, <a href="/werkgebied/oisterwijk/daklekkage/">Oisterwijk</a>, <a href="/werkgebied/heusden/daklekkage/">Heusden</a>, <a href="/werkgebied/vlijmen/daklekkage/">Vlijmen</a>, <a href="/werkgebied/schijndel/daklekkage/">Schijndel</a> en <a href="/werkgebied/boxtel/daklekkage/">Boxtel</a>. Andere plaatsen vind je bij <a href="/werkgebied/">mijn werkgebied</a>.</p>
        )}
        {/* 20-11-2026 ronde 1: de tien lekkagepagina's per plaats die nog niet in de zin hierboven staan. Die hadden 26 tot 32 binnenkomende links, tegen 131 tot 136 voor de tien die er wel in staan. */}
        {LEK_ARTIKELEN.has(a.slug) && !STORM_ARTIKELEN.has(a.slug) && (
          <p>Woon je in <a href="/werkgebied/berlicum/daklekkage/">Berlicum</a>, <a href="/werkgebied/drunen/daklekkage/">Drunen</a>, <a href="/werkgebied/sint-michielsgestel/daklekkage/">Sint-Michielsgestel</a>, <a href="/werkgebied/uden/daklekkage/">Uden</a> of <a href="/werkgebied/waalwijk/daklekkage/">Waalwijk</a>? Ook daar lees je hoe ik een lek bij jou in de buurt aanpak. Woon je verder weg, in <a href="/werkgebied/tilburg/daklekkage/">Tilburg</a>, <a href="/werkgebied/breda/daklekkage/">Breda</a>, <a href="/werkgebied/eindhoven/daklekkage/">Eindhoven</a>, <a href="/werkgebied/helmond/daklekkage/">Helmond</a> of <a href="/werkgebied/wijchen/daklekkage/">Wijchen</a>, dan kom ik ook bij een lek. Zo'n klus plan ik vooraf met je in.</p>
        )}
        {STORM_ARTIKELEN.has(a.slug) && (
          <p>Hoe ik na een storm bij jou in de buurt eerst afdek en daarna netjes herstel, lees je bij stormschade in <a href="/werkgebied/den-bosch/stormschade/">Den Bosch</a>, <a href="/werkgebied/rosmalen/stormschade/">Rosmalen</a>, <a href="/werkgebied/vught/stormschade/">Vught</a>, <a href="/werkgebied/oss/stormschade/">Oss</a>, <a href="/werkgebied/berlicum/stormschade/">Berlicum</a>, <a href="/werkgebied/schijndel/stormschade/">Schijndel</a>, <a href="/werkgebied/boxtel/stormschade/">Boxtel</a> en <a href="/werkgebied/waalwijk/stormschade/">Waalwijk</a>. Andere plaatsen vind je bij <a href="/werkgebied/">mijn werkgebied</a>.</p>
        )}
        {/* 20-11-2026 ronde 1: de zes stormpagina's per plaats die nog niet in de zin hierboven staan (20 tot 22 binnenkomende links, tegen 35 tot 39). */}
        {STORM_ARTIKELEN.has(a.slug) && (
          <p>Ook voor stormschade in <a href="/werkgebied/vlijmen/stormschade/">Vlijmen</a>, <a href="/werkgebied/drunen/stormschade/">Drunen</a>, <a href="/werkgebied/heusden/stormschade/">Heusden</a>, <a href="/werkgebied/sint-michielsgestel/stormschade/">Sint-Michielsgestel</a>, <a href="/werkgebied/oisterwijk/stormschade/">Oisterwijk</a> en <a href="/werkgebied/veghel/stormschade/">Veghel</a> staat er een eigen pagina, met wat je daar na een storm het eerst nakijkt.</p>
        )}
        {/* 18-11-2026 ronde 5: ook de zes gootpagina's per plaats met de minste binnenkomende links (19 tot 22, tegen 39 voor de vier die al in deze zin stonden). */}
        {GOOT_ARTIKELEN.has(a.slug) && (
          <p>Woon je in de regio Den Bosch? Hoe ik een lekkende goot bij jou in de buurt aanpak, lees je bij dakgoot repareren in <a href="/werkgebied/den-bosch/dakgoot-vervangen/">Den Bosch</a>, <a href="/werkgebied/rosmalen/dakgoot-vervangen/">Rosmalen</a>, <a href="/werkgebied/vught/dakgoot-vervangen/">Vught</a>, <a href="/werkgebied/oss/dakgoot-vervangen/">Oss</a>, <a href="/werkgebied/veghel/dakgoot-vervangen/">Veghel</a>, <a href="/werkgebied/uden/dakgoot-vervangen/">Uden</a>, <a href="/werkgebied/boxtel/dakgoot-vervangen/">Boxtel</a>, <a href="/werkgebied/sint-michielsgestel/dakgoot-vervangen/">Sint-Michielsgestel</a>, <a href="/werkgebied/oisterwijk/dakgoot-vervangen/">Oisterwijk</a> en <a href="/werkgebied/waalwijk/dakgoot-vervangen/">Waalwijk</a>. Andere plaatsen vind je bij <a href="/werkgebied/">mijn werkgebied</a>.</p>
        )}
        {GOOT_SCHOON_ARTIKELEN.has(a.slug) && !GOOT_ARTIKELEN.has(a.slug) && (
          <p>Wat er bij jou in de buurt in de goot terechtkomt, van eikenblad tot dennennaalden, en hoe ik hem daar leegmaak, lees je bij dakgoot schoonmaken in <a href="/werkgebied/den-bosch/goten-reinigen/">Den Bosch</a>, <a href="/werkgebied/rosmalen/goten-reinigen/">Rosmalen</a>, <a href="/werkgebied/vught/goten-reinigen/">Vught</a>, <a href="/werkgebied/berlicum/goten-reinigen/">Berlicum</a>, <a href="/werkgebied/vlijmen/goten-reinigen/">Vlijmen</a>, <a href="/werkgebied/drunen/goten-reinigen/">Drunen</a> en <a href="/werkgebied/heusden/goten-reinigen/">Heusden</a>. Woon je iets verder weg, in <a href="/werkgebied/boxtel/goten-reinigen/">Boxtel</a>, <a href="/werkgebied/schijndel/goten-reinigen/">Schijndel</a>, <a href="/werkgebied/sint-michielsgestel/goten-reinigen/">Sint-Michielsgestel</a>, <a href="/werkgebied/oisterwijk/goten-reinigen/">Oisterwijk</a>, <a href="/werkgebied/oss/goten-reinigen/">Oss</a>, <a href="/werkgebied/veghel/goten-reinigen/">Veghel</a> of <a href="/werkgebied/waalwijk/goten-reinigen/">Waalwijk</a>, dan maak ik je goot daar net zo goed leeg.</p>
        )}
        {REPARATIE_ARTIKELEN.has(a.slug) && (
          <p>Woon je in de regio Den Bosch? Hoe ik een losse of kapotte pan bij jou in de buurt aanpak, lees je bij dakreparatie in <a href="/werkgebied/den-bosch/dakreparatie/">Den Bosch</a>, <a href="/werkgebied/rosmalen/dakreparatie/">Rosmalen</a>, <a href="/werkgebied/vught/dakreparatie/">Vught</a>, <a href="/werkgebied/vlijmen/dakreparatie/">Vlijmen</a>, <a href="/werkgebied/oss/dakreparatie/">Oss</a>, <a href="/werkgebied/veghel/dakreparatie/">Veghel</a>, <a href="/werkgebied/oisterwijk/dakreparatie/">Oisterwijk</a>, <a href="/werkgebied/boxtel/dakreparatie/">Boxtel</a> en <a href="/werkgebied/waalwijk/dakreparatie/">Waalwijk</a>. Andere plaatsen vind je bij <a href="/werkgebied/">mijn werkgebied</a>.</p>
        )}
        <a class="btn btn--primary" href={a.dienst.href.endsWith("/") ? a.dienst.href : a.dienst.href + "/"} style="margin-top:8px;">{a.dienst.label}</a>
      </article>
      <aside>
        <div class="card">
          {LEK_ARTIKELEN.has(a.slug) ? (
            <>
              <h3>Lekt het nu?</h3>
              <p>Stuur me een foto van de natte plek of bel me. In de regio Den Bosch kan ik bij spoed vaak nog dezelfde dag komen. Wat je zelf meteen kunt doen, staat op de <a href="/spoed/">spoedpagina</a>.</p>
            </>
          ) : GOOT_ZIJBLOK.has(a.slug) ? (
            <>
              <h3>Probleem met je goot?</h3>
              <p>Stuur me een foto van je goot vanaf de straat via WhatsApp, of bel me. Dan zeg ik eerlijk of leegmaken genoeg is, of dat er een naad, een hoek of de uitloop gerepareerd moet worden. Je hoort vooraf wat het kost.</p>
            </>
          ) : (
            <>
              <h3>Direct een vraag?</h3>
              <p>Bel of WhatsApp Rens, of vraag de <a href="/dak-apk/">Dak-APK</a> aan (voor {apkPrijs}) voor een compleet keuringsrapport in {SITE.regioOmschrijving}.</p>
            </>
          )}
          <div class="btn-row" style="margin-top:14px; flex-direction:column;">
            <a class="btn btn--wa" href={waHref()}>WhatsApp Rens</a>
            <a class="btn btn--primary" href={telHref}>{SITE.telefoonWeergave}</a>
          </div>
          {SITE.reviews.werkspotAantal > 0 && (
            <p style="margin-top:12px; font-size:.9rem;">★ {String(SITE.reviews.score).replace(".", ",")} op <a href={SITE.werkspotUrl}>Werkspot</a> ({SITE.reviews.werkspotAantal} reviews)</p>
          )}
        </div>
        {LEK_ARTIKELEN.has(a.slug) && (toonNoodLink || toonLekdetectieLink) && (
          <div class="card" style="margin-top:16px;">
            <h3>Handig bij een lek</h3>
            {toonNoodLink && <p>Moet het eerst dicht? Wat ik dan doe en hoe lang dat houdt, lees je bij <a href="/kennisbank/noodreparatie-dak/">noodreparatie aan je dak</a>.</p>}
            {toonLekdetectieLink && <p>Twijfel je of je een lekdetectiebedrijf nodig hebt? Lees eerst <a href="/kennisbank/lekdetectie-daklek/">lekdetectie of dakdekker</a>.</p>}
          </div>
        )}
        <div class="card" style="margin-top:16px;"><h3>Dakdekker bij jou in de buurt</h3><p>Ik werk vanuit 's-Hertogenbosch en kom onder meer in {buurtPlaatsen.map((pl, i) => (<>{i > 0 && (i === buurtPlaatsen.length - 1 ? " en " : ", ")}<a href={`/werkgebied/${pl.slug}/`}>{pl.naam}</a></>))}. Alle plaatsen vind je bij <a href="/werkgebied/">mijn werkgebied</a>.</p></div>
      </aside>
    </div>
  </section>

  {a.faq.length > 0 && (
    <section class="section section--white">
      <div class="wrap">
        <h2>Veelgestelde vragen</h2>
        <div class="faq" style="margin-top:16px; max-width:760px;">
          {a.faq.map((f) => (
            <details>
              <summary>{f.v}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
        <p style="margin-top:18px; max-width:760px;">Staat je vraag er niet bij? Stuur me een appje met een foto via <a href={waHref(`Hallo, ik heb een vraag over: ${a.titel}`)}>WhatsApp</a> of bel <a href={telHref}>{SITE.telefoonWeergave}</a>, dan kijk ik met je mee.</p>
      </div>
    </section>
  )}

  {/* Over de schrijver (14-11-2026): alleen feiten die al op de site staan en die Rens heeft bevestigd. Niets over wie het werk uitvoert. */}
  <section class="section">
    <div class="wrap prose">
      <h2>Over de schrijver</h2>
      <p>{SITE.bedrijfsnaam} is het bedrijf van {SITE.eigenaar}, dakdekker uit 's-Hertogenbosch (Den Bosch). Je belt of appt met {SITE.eigenaar} zelf, niet met een callcenter. Hij werkt in de regio Den Bosch en verder in Brabant, is bedrijfsaansprakelijk verzekerd en staat bij de KvK ingeschreven onder nummer {SITE.kvk}.{SITE.reviews.werkspotAantal > 0 && <> Op <a href={SITE.werkspotUrl}>Werkspot</a> staat hij op {String(SITE.reviews.score).replace(".", ",")} uit {SITE.reviews.werkspotAantal} reviews.</>} Meer lees je op de pagina <a href="/over/">over {SITE.eigenaar}</a>.</p>
    </div>
  </section>

  {gerelateerd.length > 0 && (
    <section class="section section--soft">
      <div class="wrap">
        <h2>Lees ook</h2>
        <div class="grid grid-3" style="margin-top:18px;">
          {gerelateerd.map((g) => (
            <a class="card" href={`/kennisbank/${g.slug}/`}>
              <h3>{g.titel}</h3>
              <p>{g.metaDescription}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  {nieuwste.length > 0 && (
    <section class="section">
      <div class="wrap prose">
        <h2>Nieuw in de kennisbank</h2>
        <ul>
          {nieuwste.map((n) => <li><a href={`/kennisbank/${n.slug}/`}>{n.titel}</a></li>)}
        </ul>
      </div>
    </section>
  )}

  <section class="section">
    <div class="wrap">
      <a href="/kennisbank/">← Terug naar de kennisbank</a>
    </div>
  </section>
</Base>
