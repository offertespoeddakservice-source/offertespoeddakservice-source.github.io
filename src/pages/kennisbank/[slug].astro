  "dakpan-zelf-terugleggen": ["31e323"],
  "dakdekker-komt-wat-regel-je": ["9edf07"],
  "bakgoot-lekt": ["973b86"],
  "dak-nakijken-na-schoorsteenbrand": ["742508"],
  "dak-keuren-bij-huis-kopen": ["31e323"],
  "welke-golfplaten-heb-ik": ["1be656", "9bf5ac"],
  "dakgoot-zelf-schoonmaken": ["ae9944"],
  "schoorsteen-lekt-verzekering": ["173c1a"],
  "droge-nok-of-specie": ["a56a3a"],
  "lekt-tijdens-verbouwing": ["6b7483"],
  "dak-schade-door-bouw-in-de-buurt": ["31e323"],
  "dakdekker-failliet-dak-lekt": ["9edf07"],
  // 23-11-2026 ronde 2: echte foto's bij omdekken en twee lekkage-artikelen zonder foto (653b84 niet bij de warmtepomp, de reden van afkeuren in ronde 1).
  "dak-omdekken": ["6b7483"],
  "lekkage-muur-buren": ["5927e8"],
  "schuin-dak-aanbouw-lekt": ["5927e8"],
  // 23-11-2026 ronde 3: echte foto's bij vier artikelen zonder foto, alleen waar het bijschrift past.
  "groene-strepen-gevel-onder-dakgoot": ["973b86"],
  "dak-winterklaar-maken": ["ce4ab5", "ae9944"],
  "welke-dakbedekking-heb-ik": ["98b289", "68c227"],
  "kraaien-mos-van-dak": ["049fd9"],
  // 23-11-2026 ronde 5: echte foto's bij twee nieuwe artikelen van vannacht, alleen waar het bijschrift past.
