  "lekkende-dakgoot-tijdelijk-oplossen": { soort: "goot", max: 2 },
  "dakgoot-loopt-over": { soort: "goot", max: 2 },
  "licht-tussen-dakpannen": { soort: "pannen", max: 2 },
  "poreuze-dakpannen": { soort: "pannen", max: 2 },
  "dakterras-lekt": { soort: "plat-dak", max: 1 },
  "dak-repareren-in-de-winter": { soort: "pannen", max: 2 },
  "welke-dakpan-heb-ik": { soort: "pannen", max: 2 },
  "storm-op-komst-dak": { soort: "pannen", max: 2 },
  "gevelpannen-los": { soort: "pannen", max: 2 },
  "gedeelde-dakgoot-lekt": { soort: "goot", max: 2 },
  "bladvanger-dakgoot": { soort: "goot", max: 2 },
  "huis-gekocht-dak-lekt": { soort: "pannen", max: 2 },
  "lekkage-na-dakwerk-buren": { soort: "pannen", max: 2 },
  "dakgoot-schoonmaken-in-de-winter": { soort: "goot", max: 2 },
  "dakgoot-schoonmaken-huurder-of-verhuurder": { soort: "goot", max: 1 },
  "dakpan-op-auto-buren": { soort: "pannen", max: 2 },
  "plat-dak-losgewaaid-na-storm": { soort: "plat-dak", max: 2 },
  "duiven-onder-zonnepanelen": { soort: "vogelwering", max: 2 },
  "dak-vernieuwen-rijtjeshuis": { soort: "pannen", max: 2 },
  "dak-lekt-na-schoonmaken": { soort: "pannen", max: 2 },
  "dak-nakijken-voor-zonnepanelen": { soort: "pannen", max: 2 },
  "lood-of-loodvervanger": { soort: "lood-zink", max: 1 },
  "lekdetectie-daklek": { soort: "lood-zink", max: 1 },
  "plat-dak-met-grind-lekt": { soort: "plat-dak", max: 2 },
  "pannendak-schuur-lekt": { soort: "pannen", max: 2 },
  "wat-kost-dakpan-vervangen": { soort: "pannen", max: 2 },
  "natte-plek-schuine-wand-zolder": { soort: "pannen", max: 1 },
  "dakdekker-kleine-klus": { soort: "pannen", max: 2 },
  "vochtplek-schoorsteen-binnen": { soort: "schoorsteen", max: 2 },
  "keurmerk-dakdekker": { soort: "pannen", max: 2 },
  "water-uit-zolderluik": { soort: "pannen", max: 1 },
  "wachten-op-dakdekker-na-storm": { soort: "pannen", max: 2 },
  "zand-in-dakgoot": { soort: "goot", max: 2 },
  "dakpannen-zakken-af": { soort: "pannen", max: 2 },
  "dakgoot-lekt-na-schoonmaken": { soort: "goot", max: 2 },
  "goot-schoonmaken-glazenwasser-of-dakdekker": { soort: "goot", max: 2 },
  "dak-lekt-boven-en-benedenwoning": { soort: "pannen", max: 1 },
};
const fotoBij = FOTOS_BIJ[a.slug];
// Precies deze echte foto's (uit fotos.ts) bij artikelen waar geen soort goed past, zoals de veranda of een goot die doorhangt.
// Op code uit de bestandsnaam; het pad komt uit fotos.ts, dus alleen foto's die Rens goedkeurde.
const FOTOS_BESTANDEN: Record<string, string[]> = {
  "veranda-of-overkapping-lekt": ["9bf5ac"],
  "dakgoot-hangt-door": ["ae9944"],
  "verstopte-regenpijp-lekkende-dakgoot": ["ae9944", "6d4a97"],
  "lekkage-bij-de-nok": ["f9152c", "a56a3a"],
  "lekkage-bij-kachelpijp": ["653b84"],
  "dakpan-lijmen-of-kitten": ["f9152c", "31e323"],
  "plat-dak-onderhouden": ["98b289", "68c227"],
  "schoorsteen-na-storm": ["742508", "173c1a"],
  "dakgoot-zink-of-kunststof": ["a1519b", "ae9944"],
  "plat-dak-lekt-bij-afvoer": ["98b289", "72b9bb"],
  "water-achter-dakgoot": ["973b86", "ae9944"],
  "dakgoot-lekt": ["ae9944", "a1519b"],
  "hoe-lang-gaat-een-dakgoot-mee": ["a1519b", "973b86"],
  "dak-monument-repareren": ["173c1a"],
  "regenpijp-loost-op-dak": ["98b289", "72b9bb"],
  "wat-kost-dakgoot-schoonmaken": ["ae9944"],
  "hoe-vaak-dakgoot-reinigen": ["ae9944"],
  "golfplaten-lekken": ["1be656"],
  "hoekkeper-lekt": ["bef73b"],
  "lekt-sinds-nieuwe-dakgoot": ["ae9944", "a1519b"],
  "cv-ketel-lekt-bij-regen": ["653b84"],
  "regenpijp-kapot-door-vorst": ["6d4a97", "ae9944"],
  "dak-fluit-bij-harde-wind": ["a56a3a", "f9152c"],
  "lekt-sinds-nieuw-dakraam": ["31e323"],
  "zolder-nat-langs-zijmuur": ["049fd9", "ce4ab5"],
  "windveer-los-of-rot": ["049fd9"],
};
const fotoBestanden = FOTOS_BESTANDEN[a.slug]
  ?.map((code) => FOTOS.find((f) => f.bestand.includes(`-${code}.`))?.bestand)
  .filter((b): b is string => !!b);
const plek = groep.indexOf(a.slug);
const uitGroep = [...groep.slice(plek + 1), ...groep.slice(0, Math.max(plek, 0))]
  .map((s) => ARTIKELEN.find((x) => x.slug === s))
  .filter(Boolean) as typeof ARTIKELEN;
const volgende = [1, 2, 3, 4, 5, 6, 7].map((n) => ARTIKELEN[(idx + n) % ARTIKELEN.length]);
const gerelateerd = [...uitGroep, ...volgende]
  .filter((x, i, lijst) => x.slug !== a.slug && !x.verborgen && lijst.findIndex((y) => y.slug === x.slug) === i)
  .slice(0, 6);
// Nieuw in de kennisbank: de zes nieuwste zichtbare artikelen op datum, zodat een nieuw artikel meteen vanaf elk kennisartikel een link krijgt (14-11-2026). Niet het artikel zelf en niet wat al bij 'Lees ook' staat.
const nieuwste = ARTIKELEN
  .filter((x) => !x.verborgen && x.datum && x.slug !== a.slug && !gerelateerd.some((g) => g.slug === x.slug))
  .sort((x, y) => (y.datum ?? "").localeCompare(x.datum ?? ""))
  .slice(0, 6);

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: a.h1,
  description: a.metaDescription,
  ...(KORT_ANTWOORD[a.slug] ? { abstract: KORT_ANTWOORD[a.slug] } : {}),
  inLanguage: "nl-NL",
  author: { "@type": "Person", "@id": `${SITE.url}/over/#rens`, name: SITE.eigenaar, url: `${SITE.url}/over/`, worksFor: { "@id": `${SITE.url}/#bedrijf` } },
  publisher: { "@type": "Organization", "@id": `${SITE.url}/#bedrijf`, name: SITE.bedrijfsnaam, logo: { "@type": "ImageObject", url: `${SITE.url}/favicon.svg` } },
  mainEntityOfPage: new URL(path + "/", SITE.url).href,
  ...(a.dienst?.href ? { about: { "@type": "Service", name: a.dienst.label.replace(/^Bekijk:\s*/, ""), url: `${SITE.url}${a.dienst.href.endsWith("/") ? a.dienst.href : a.dienst.href + "/"}`, provider: { "@id": `${SITE.url}/#bedrijf` } } } : {}),
  image: `${SITE.url}/og.png`,
  datePublished: a.datum ?? "2026-06-19",
  dateModified: bijgewerkt ?? "2026-06-20",
};
const faqSchema = a.faq.length
  ? { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: a.faq.map((f) => ({ "@type": "Question", name: f.v, acceptedAnswer: { "@type": "Answer", text: f.a } })) }
  : null;
const schema = faqSchema ? [articleSchema, faqSchema] : articleSchema;
---

<Base title={a.metaTitle} description={a.metaDescription} path={path} schema={schema} noindex={a.verborgen === true}>
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow" style="color:#ffb486;">Kennisbank</p>
      <h1>{a.h1}</h1>
      <p class="lead">{a.intro}</p>
      <p style="color:#9fb4c9; font-size:.9rem; margin-top:10px;">Bijgewerkt: {bijgewerktTekst} · door <a href="/over/" style="color:inherit; text-decoration:underline;">{SITE.eigenaar}</a>, dakdekker regio Den Bosch</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap split">
      <article class="prose">
        {KORT_ANTWOORD[a.slug] && (
          <p class="notice" style="margin-top:0;"><strong>Kort antwoord:</strong> {KORT_ANTWOORD[a.slug]}</p>
        )}
        {a.slug === "dakinspectie" && ARTIKELEN.some((x) => x.slug === "wat-kost-een-dakinspectie" && !x.verborgen) && (
          <p>Wil je precies weten wat een dakinspectie kost en wat je ervoor krijgt? Lees <a href="/kennisbank/wat-kost-een-dakinspectie/">wat kost een dakinspectie</a>.</p>
        )}
        {a.secties.map((s, i) => (
          <>
            <h2>{s.kop}</h2>
            {s.tekst.map((p) => <p set:html={p} />)}
            {i === 0 && toonSpoedregel && (
              <p><strong>Lekt het nu?</strong> Ga niet zelf het dak op. Wat je meteen kunt doen, staat op de <a href="/spoed/">spoedpagina</a>. Of stuur me een foto van de natte plek via <a href={waHref("Hallo, mijn dak lekt. Ik stuur je een foto.")}>WhatsApp</a>, dan kijk ik mee.</p>
            )}
            {i === 0 && GOOT_FOTOREGEL.has(a.slug) && (
              <p><strong>Vol of lek?</strong> Twijfel je of je goot alleen vol zit of echt lekt? Maak vanaf de straat een foto, het liefst tijdens of vlak na een bui, en stuur die via <a href={waHref("Hallo, ik heb een vraag over mijn dakgoot. Ik stuur je een foto.")}>WhatsApp</a>. Dan zeg ik wat ik zie, en je hoort vooraf de vaste prijs.</p>
            )}
            {i === 0 && FOTOREGEL_OVERIG.has(a.slug) && !toonSpoedregel && !GOOT_FOTOREGEL.has(a.slug) && (
              <p><strong>Twijfel je wat het bij jou is?</strong> Maak vanaf de overkant van de straat een foto van je dak, met de zoom van je telefoon, en stuur die via <a href={waHref("Hallo, ik heb een vraag over mijn dak. Ik stuur je een foto.")}>WhatsApp</a>. Dan zeg ik eerlijk wat ik zie, en je hoort vooraf wat het kost.</p>
            )}
            {i === 0 && PLATDAK_FOTOREGEL.has(a.slug) && !toonSpoedregel && !GOOT_FOTOREGEL.has(a.slug) && !FOTOREGEL_OVERIG.has(a.slug) && (
              <p><strong>Twijfel je wat er met je platte dak is?</strong> Maak vanuit een raam boven, of vanaf een plek waar je veilig staat, een foto van het dak en stuur die via <a href={waHref("Hallo, ik heb een vraag over mijn platte dak. Ik stuur je een foto.")}>WhatsApp</a>. Ga er niet zelf op als het nat of glad is. Dan zeg ik eerlijk wat ik zie, en je hoort vooraf wat het kost.</p>
            )}
          </>
        ))}
        {fotoBij && <EchteFotos soort={fotoBij.soort} max={fotoBij.max} inline />}
        {!fotoBij && fotoBestanden && fotoBestanden.length > 0 && <EchteFotos bestanden={fotoBestanden} max={fotoBestanden.length} inline />}
        {LEK_ARTIKELEN.has(a.slug) && !STORM_ARTIKELEN.has(a.slug) && (
          <p>Woon je in de regio Den Bosch? Hoe ik een lek bij jou in de buurt aanpak, lees je bij daklekkage in <a href="/werkgebied/den-bosch/daklekkage/">Den Bosch</a>, <a href="/werkgebied/vught/daklekkage/">Vught</a>, <a href="/werkgebied/rosmalen/daklekkage/">Rosmalen</a>, <a href="/werkgebied/oss/daklekkage/">Oss</a>, <a href="/werkgebied/veghel/daklekkage/">Veghel</a>, <a href="/werkgebied/oisterwijk/daklekkage/">Oisterwijk</a>, <a href="/werkgebied/heusden/daklekkage/">Heusden</a>, <a href="/werkgebied/vlijmen/daklekkage/">Vlijmen</a>, <a href="/werkgebied/schijndel/daklekkage/">Schijndel</a> en <a href="/werkgebied/boxtel/daklekkage/">Boxtel</a>. Andere plaatsen vind je bij <a href="/werkgebied/">mijn werkgebied</a>.</p>
        )}
        {STORM_ARTIKELEN.has(a.slug) && (
          <p>Hoe ik na een storm bij jou in de buurt eerst afdek en daarna netjes herstel, lees je bij stormschade in <a href="/werkgebied/den-bosch/stormschade/">Den Bosch</a>, <a href="/werkgebied/rosmalen/stormschade/">Rosmalen</a>, <a href="/werkgebied/vught/stormschade/">Vught</a>, <a href="/werkgebied/oss/stormschade/">Oss</a>, <a href="/werkgebied/berlicum/stormschade/">Berlicum</a>, <a href="/werkgebied/schijndel/stormschade/">Schijndel</a>, <a href="/werkgebied/boxtel/stormschade/">Boxtel</a> en <a href="/werkgebied/waalwijk/stormschade/">Waalwijk</a>. Andere plaatsen vind je bij <a href="/werkgebied/">mijn werkgebied</a>.</p>
        )}
        {GOOT_ARTIKELEN.has(a.slug) && (
          <p>Woon je in de regio Den Bosch? Hoe ik een lekkende goot bij jou in de buurt aanpak, lees je bij dakgoot repareren in <a href="/werkgebied/den-bosch/dakgoot-vervangen/">Den Bosch</a>, <a href="/werkgebied/vught/dakgoot-vervangen/">Vught</a>, <a href="/werkgebied/veghel/dakgoot-vervangen/">Veghel</a> en <a href="/werkgebied/oisterwijk/dakgoot-vervangen/">Oisterwijk</a>. Andere plaatsen vind je bij <a href="/werkgebied/">mijn werkgebied</a>.</p>
        )}
        {REPARATIE_ARTIKELEN.has(a.slug) && (
          <p>Woon je in de regio Den Bosch? Hoe ik een losse of kapotte pan bij jou in de buurt aanpak, lees je bij dakreparatie in <a href="/werkgebied/den-bosch/dakreparatie/">Den Bosch</a>, <a href="/werkgebied/rosmalen/dakreparatie/">Rosmalen</a>, <a href="/werkgebied/vught/dakreparatie/">Vught</a>, <a href="/werkgebied/vlijmen/dakreparatie/">Vlijmen</a>, <a href="/werkgebied/oss/dakreparatie/">Oss</a>, <a href="/werkgebied/veghel/dakreparatie/">Veghel</a>, <a href="/werkgebied/oisterwijk/dakreparatie/">Oisterwijk</a> en <a href="/werkgebied/waalwijk/dakreparatie/">Waalwijk</a>. Andere plaatsen vind je bij <a href="/werkgebied/">mijn werkgebied</a>.</p>
        )}
        <a class="btn btn--primary" href={a.dienst.href.endsWith("/") ? a.dienst.href : a.dienst.href + "/"} style="margin-top:8px;">{a.dienst.label}</a>
      </article>
      <aside>
        <div class="card">
          {LEK_ARTIKELEN.has(a.slug) ? (
            <>
              <h3>Lekt het nu?</h3>
              <p>Stuur me een foto van de natte plek of bel me. In de regio Den Bosch kan ik bij spoed vaak nog dezelfde dag komen. Wat je zelf meteen kunt doen, staat op de <a href="/spoed/">spoedpagina</a>.</p>
            </>
          ) : GOOT_ZIJBLOK.has(a.slug) ? (
            <>
              <h3>Probleem met je goot?</h3>
              <p>Stuur me een foto van je goot vanaf de straat via WhatsApp, of bel me. Dan zeg ik eerlijk of leegmaken genoeg is, of dat er een naad, een hoek of de uitloop gerepareerd moet worden. Je hoort vooraf wat het kost.</p>
            </>
          ) : (
            <>
              <h3>Direct een vraag?</h3>
              <p>Bel of WhatsApp Rens, of vraag de <a href="/dak-apk/">Dak-APK</a> aan (voor {apkPrijs}) voor een compleet keuringsrapport in {SITE.regioOmschrijving}.</p>
            </>
          )}
          <div class="btn-row" style="margin-top:14px; flex-direction:column;">
            <a class="btn btn--wa" href={waHref()}>WhatsApp Rens</a>
            <a class="btn btn--primary" href={telHref}>{SITE.telefoonWeergave}</a>
          </div>
          {SITE.reviews.werkspotAantal > 0 && (
            <p style="margin-top:12px; font-size:.9rem;">★ {String(SITE.reviews.score).replace(".", ",")} op <a href={SITE.werkspotUrl}>Werkspot</a> ({SITE.reviews.werkspotAantal} reviews)</p>
          )}
        </div>
      </aside>
    </div>
  </section>

  {a.faq.length > 0 && (
    <section class="section section--white">
      <div class="wrap">
        <h2>Veelgestelde vragen</h2>
        <div class="faq" style="margin-top:16px; max-width:760px;">
          {a.faq.map((f) => (
            <details>
              <summary>{f.v}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
        <p style="margin-top:18px; max-width:760px;">Staat je vraag er niet bij? Stuur me een appje met een foto via <a href={waHref(`Hallo, ik heb een vraag over: ${a.titel}`)}>WhatsApp</a> of bel <a href={telHref}>{SITE.telefoonWeergave}</a>, dan kijk ik met je mee.</p>
      </div>
    </section>
  )}

  {gerelateerd.length > 0 && (
    <section class="section section--soft">
      <div class="wrap">
        <h2>Lees ook</h2>
        <div class="grid grid-3" style="margin-top:18px;">
          {gerelateerd.map((g) => (
            <a class="card" href={`/kennisbank/${g.slug}/`}>
              <h3>{g.titel}</h3>
              <p>{g.metaDescription}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  {nieuwste.length > 0 && (
    <section class="section">
      <div class="wrap prose">
        <h2>Nieuw in de kennisbank</h2>
        <ul>
          {nieuwste.map((n) => <li><a href={`/kennisbank/${n.slug}/`}>{n.titel}</a></li>)}
        </ul>
      </div>
    </section>
  )}

  <section class="section">
    <div class="wrap">
      <a href="/kennisbank/">← Terug naar de kennisbank</a>
    </div>
  </section>
</Base>
