---
import Base from "../../layouts/Base.astro";
import { SITE, telHref, waHref } from "../../site.config.ts";
import { ARTIKELEN } from "../../data/artikelen.ts";

export function getStaticPaths() {
  return ARTIKELEN.map((a) => ({ params: { slug: a.slug }, props: { a } }));
}
const { a } = Astro.props;
const path = `/kennisbank/${a.slug}`;
const idx = ARTIKELEN.findIndex((x) => x.slug === a.slug);
// Lees ook: eerst artikelen over hetzelfde onderwerp, daarna aanvullen met de volgende uit de lijst.
const ONDERWERPEN: string[][] = [
  ["daklekkage-opsporen", "vochtplek-plafond", "lekkage-bij-schoorsteen", "condens-of-lekkage-op-zolder", "dakraam-lekt", "dak-lekt-bij-harde-wind", "lekkage-bij-zonnepanelen", "wat-kost-daklekkage-repareren", "daklekkage-verzekering"],
  ["hoe-vaak-dakgoot-reinigen", "wat-kost-dakgoot-schoonmaken", "verstopte-regenpijp-lekkende-dakgoot", "dakgoot-lekt"],
  ["stormschade-eerste-hulp", "nokvorsten-los", "dak-lekt-bij-harde-wind", "daklekkage-verzekering"],
  ["plat-dak-vervangen-of-repareren", "water-blijft-staan-op-plat-dak", "dakonderhoud-per-seizoen", "mos-op-dak-verwijderen"],
];
const groep = ONDERWERPEN.find((g) => g.includes(a.slug)) ?? [];
const plek = groep.indexOf(a.slug);
const uitGroep = [...groep.slice(plek + 1), ...groep.slice(0, Math.max(plek, 0))]
  .map((s) => ARTIKELEN.find((x) => x.slug === s))
  .filter(Boolean) as typeof ARTIKELEN;
const volgende = [1, 2, 3, 4].map((n) => ARTIKELEN[(idx + n) % ARTIKELEN.length]);
const gerelateerd = [...uitGroep, ...volgende]
  .filter((x, i, lijst) => x.slug !== a.slug && lijst.findIndex((y) => y.slug === x.slug) === i)
  .slice(0, 3);

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: a.h1,
  description: a.metaDescription,
  inLanguage: "nl-NL",
  author: { "@type": "Person", name: "Rens" },
  publisher: { "@type": "Organization", name: SITE.bedrijfsnaam, logo: { "@type": "ImageObject", url: `${SITE.url}/favicon.svg` } },
  mainEntityOfPage: new URL(path + "/", SITE.url).href,
  image: `${SITE.url}/og.png`,
  datePublished: a.datum ?? "2026-06-19",
  dateModified: a.datum ?? "2026-06-20",
};
const faqSchema = a.faq.length
  ? { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: a.faq.map((f) => ({ "@type": "Question", name: f.v, acceptedAnswer: { "@type": "Answer", text: f.a } })) }
  : null;
const schema = faqSchema ? [articleSchema, faqSchema] : articleSchema;
---

<Base title={a.metaTitle} description={a.metaDescription} path={path} schema={schema}>
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow" style="color:#ffb486;">Kennisbank</p>
      <h1>{a.h1}</h1>
      <p class="lead">{a.intro}</p>
      <p style="color:#9fb4c9; font-size:.9rem; margin-top:10px;">Bijgewerkt: {a.datum?.startsWith("2026-10") ? "oktober 2026" : "juni 2026"} · door Rens, dakdekker regio Den Bosch</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap split">
      <article class="prose">
        {a.secties.map((s) => (
          <>
            <h2>{s.kop}</h2>
            {s.tekst.map((p) => <p set:html={p} />)}
          </>
        ))}
        <a class="btn btn--primary" href={a.dienst.href.endsWith("/") ? a.dienst.href : a.dienst.href + "/"} style="margin-top:8px;">{a.dienst.label}</a>
      </article>
      <aside>
        <div class="card">
          <h3>Direct een vraag?</h3>
          <p>Bel of WhatsApp Rens, of vraag de <a href="/dak-apk">Dak-APK</a> aan (voor €49) voor een compleet keuringsrapport in {SITE.regioOmschrijving}.</p>
          <div class="btn-row" style="margin-top:14px; flex-direction:column;">
            <a class="btn btn--wa" href={waHref()}>WhatsApp Rens</a>
            <a class="btn btn--primary" href={telHref}>{SITE.telefoonWeergave}</a>
          </div>
        </div>
      </aside>
    </div>
  </section>

  {a.faq.length > 0 && (
    <section class="section section--white">
      <div class="wrap">
        <h2>Veelgestelde vragen</h2>
        <div class="faq" style="margin-top:16px; max-width:760px;">
          {a.faq.map((f) => (
            <details>
              <summary>{f.v}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  )}

  {gerelateerd.length > 0 && (
    <section class="section section--soft">
      <div class="wrap">
        <h2>Lees ook</h2>
        <div class="grid grid-3" style="margin-top:18px;">
          {gerelateerd.map((g) => (
            <a class="card" href={`/kennisbank/${g.slug}/`}>
              <h3>{g.titel}</h3>
              <p>{g.metaDescription}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section">
    <div class="wrap">
      <a href="/kennisbank/">← Terug naar de kennisbank</a>
    </div>
  </section>
</Base>
